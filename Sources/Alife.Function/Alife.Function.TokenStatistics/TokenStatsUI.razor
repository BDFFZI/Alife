@namespace Alife.Function.TokenStatistics
@using Alife.Framework
@using AntDesign
@inject IServiceProvider ServiceProvider

@attribute [SystemMenu("tokenStats","Token统计","bar-chart",50)]

<div class="ts-page">
    <div class="ts-head">
        <div class="ts-head-main">
            <div class="ts-title">Token 统计</div>
            <div class="ts-sub">按角色与时间段分析对话开销、标签与函数分布。数据直接读取角色记录，未激活角色同样可查看。</div>
        </div>
        <div class="ts-head-actions">
            <span class="ts-label">角色</span>
            <Select TItemValue="string" TItem="string"
                    DataSource="@characters"
                    @bind-Value="selectedCharacter"
                    @bind-Value:after="OnCharacterChanged"
                    Placeholder="选择角色"
                    Style="width: 160px;"/>
            <Button Icon="@IconType.Outline.Reload" OnClick="@Reload">刷新</Button>
        </div>
    </div>

    @if (characters.Count == 0)
    {
        <div class="ts-empty">
            <Empty Description="@("还没有任何角色数据")"/>
        </div>
    }
    else
    {
            <div class="ts-card ts-price-card">
                <div class="ts-card-head">
                    <div class="ts-card-title">价格配置</div>
                    <div class="ts-card-sub">配置库全局共享；每个角色各自记住选用的配置</div>
                    <div style="flex:1;"></div>
                    @if (PriceDirty)
                    {
                        <span class="ts-pc-dirty">未保存</span>
                    }
                    <Button Size="@ButtonSize.Small" OnClick="TogglePriceConfig">@(showPriceConfig ? "收起" : "编辑")</Button>
                </div>

                <div class="ts-pc-row">
                    <div class="ts-pc-label">当前配置</div>
                    <div class="ts-pc-value">
                        <RadioGroup TValue="string" Value="@selectedProfileId" ValueChanged="@OnProfileChanged" ButtonStyle="@RadioButtonStyle.Solid">
                            @foreach (var profile in priceProfiles)
                            {
                                <Radio RadioButton Value="@profile.Id">@profile.Name</Radio>
                            }
                        </RadioGroup>
                        <Button Size="@ButtonSize.Small" OnClick="DuplicateProfile">复制当前</Button>
                        <Button Size="@ButtonSize.Small" OnClick="DeleteProfile" Disabled="@priceProfile.IsDefault">删除</Button>
                    </div>
                </div>

                @if (showPriceConfig)
                {
                    <div class="ts-pc-section">
                        <div class="ts-pc-section-head">
                            <span class="ts-pc-section-title">基线单价</span>
                            <span class="ts-pc-section-hint">没有命中任何覆盖规则时使用（元 / 百万 tokens）</span>
                        </div>

                        <div class="ts-pc-row">
                            <div class="ts-pc-label">缓存命中</div>
                            <div class="ts-pc-value">
                                <InputNumber TValue="double" Min="0" Step="0.01" @bind-Value="priceProfile.Baseline.InputHitPerM" Style="width:120px;" />
                            </div>
                        </div>
                        <div class="ts-pc-row">
                            <div class="ts-pc-label">输入未命中</div>
                            <div class="ts-pc-value">
                                <InputNumber TValue="double" Min="0" Step="0.1" @bind-Value="priceProfile.Baseline.InputMissPerM" Style="width:120px;" />
                            </div>
                        </div>
                        <div class="ts-pc-row">
                            <div class="ts-pc-label">输出</div>
                            <div class="ts-pc-value">
                                <InputNumber TValue="double" Min="0" Step="0.1" @bind-Value="priceProfile.Baseline.OutputPerM" Style="width:120px;" />
                            </div>
                        </div>
                    </div>

                    <div class="ts-pc-section">
                        <div class="ts-pc-section-head">
                            <span class="ts-pc-section-title">时间覆盖规则</span>
                            <span class="ts-pc-section-hint">在这些时段改用另一套单价；留空则全时段按基线价</span>
                        </div>

                        @for (int i = 0; i < ruleEdits.Count; i++)
                        {
                            var edit = ruleEdits[i];
                            int ruleIndex = i + 1;
                            <div class="ts-pc-rule">
                                <div class="ts-pc-rule-head">
                                    <span class="ts-pc-rule-index">规则 @ruleIndex</span>
                                    <span class="ts-pc-inline-label">名称</span>
                                    <Input @bind-Value="edit.Rule.Name" Style="width:120px;" />
                                    <Checkbox @bind-Value="edit.Rule.WorkdaysOnly">仅工作日</Checkbox>
                                    <div style="flex:1;"></div>
                                    <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="@(() => RemoveRule(edit))">删除规则</Button>
                                </div>

                                <div class="ts-pc-row">
                                    <div class="ts-pc-label">时段</div>
                                    <div class="ts-pc-value ts-pc-windows">
                                        @for (int w = 0; w < edit.Windows.Count; w++)
                                        {
                                            var window = edit.Windows[w];
                                            <span class="ts-pc-window">
                                                <Input @bind-Value="window.StartText" Style="width:76px;" />
                                                <span class="ts-pc-unit">—</span>
                                                <Input @bind-Value="window.EndText" Style="width:76px;" />
                                                <Button Type="@ButtonType.Link" Danger="true" Size="@ButtonSize.Small" OnClick="@(() => RemoveWindow(edit, window))">×</Button>
                                            </span>
                                        }
                                        <Button Size="@ButtonSize.Small" OnClick="@(() => AddWindow(edit))">+ 加时段</Button>
                                    </div>
                                </div>

                                <div class="ts-pc-row">
                                    <div class="ts-pc-label">单价</div>
                                    <div class="ts-pc-value">
                                        <span class="ts-pc-inline-label">缓存</span>
                                        <InputNumber TValue="double" Min="0" Step="0.01" @bind-Value="edit.Rule.Prices.InputHitPerM" Style="width:110px;" />
                                        <span class="ts-pc-inline-label">输入</span>
                                        <InputNumber TValue="double" Min="0" Step="0.1" @bind-Value="edit.Rule.Prices.InputMissPerM" Style="width:110px;" />
                                        <span class="ts-pc-inline-label">输出</span>
                                        <InputNumber TValue="double" Min="0" Step="0.1" @bind-Value="edit.Rule.Prices.OutputPerM" Style="width:110px;" />
                                    </div>
                                </div>
                            </div>
                        }

                        @if (ruleEdits.Count == 0)
                        {
                            <div class="ts-pc-empty">当前配置没有覆盖规则，全时段按基线价（大多数模型就是这样）。</div>
                        }

                        <div class="ts-pc-row">
                            <div class="ts-pc-label"></div>
                            <div class="ts-pc-value">
                                <Button Size="@ButtonSize.Small" OnClick="AddRule">+ 加一个覆盖规则</Button>
                            </div>
                        </div>
                    </div>

                    <div class="ts-pc-actions">
                        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="SavePriceProfile">保存并重算</Button>
                        <Button Size="@ButtonSize.Small" OnClick="ResetPriceProfile" Disabled="@(!priceProfile.IsDefault)">恢复内置默认</Button>
                        <div style="flex:1;"></div>
                        <span class="ts-pc-hint">节假日：@holidayStatus</span>
                        <Button Size="@ButtonSize.Small" OnClick="RefreshHolidays">刷新节假日</Button>
                    </div>

                    <div class="ts-pc-footer">
                        <div>库文件：@ShortenPath(TokenStatisticsLocator.PriceProfilesFile)</div>
                        <div>本角色选择：@ShortenPath(TokenStatisticsLocator.PriceFileFor(selectedCharacter))</div>
                        <div>
                            节假日缓存：@HolidayCalendar.CacheTtlDays 天过期
                            @if (holidayRefreshedAt.HasValue)
                            {
                                <text> · 上次读取 @holidayRefreshedAt.Value.ToString("MM-dd HH:mm:ss")</text>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="ts-pc-summary">
                        <span class="ts-pc-chip">基线 · 缓存 ¥@priceProfile.Baseline.InputHitPerM / 输入 ¥@priceProfile.Baseline.InputMissPerM / 输出 ¥@priceProfile.Baseline.OutputPerM</span>
                        <span class="ts-pc-chip">覆盖 · @OverrideText(priceProfile)</span>
                        <span class="ts-pc-chip">节假日 · @holidayStatus</span>
                    </div>
                }
            </div>

        <div class="ts-card">
            <div class="ts-card-head">
                <div class="ts-card-title">时间范围</div>
                <div class="ts-card-sub">下面三块（总览 / 用量走势 / 诊断摘要）都按这个范围统计</div>
            </div>
        <div class="ts-toolbar">
            <div class="ts-tool-group">
                <span class="ts-label">基准日</span>
                <DatePicker TValue="DateTime?" Value="@RangeAnchorDate" ValueChanged="@OnRangeAnchorChanged"
                            Format="yyyy-MM-dd" Style="width: 150px;" />
            </div>

            <div class="ts-tool-group">
                <span class="ts-label">跨度</span>
                <RadioGroup TValue="int" Value="@spanDays" ValueChanged="@(OnSpanDaysChanged)" ButtonStyle="@RadioButtonStyle.Solid">
                    <Radio RadioButton Value="1">1 天</Radio>
                    <Radio RadioButton Value="7">7 天</Radio>
                    <Radio RadioButton Value="30">30 天</Radio>
                </RadioGroup>
                <InputNumber TValue="int" Min="1" Max="365" @bind-Value="SpanInput" Style="width: 88px;" />
                <span class="ts-label">天</span>
            </div>

            <div class="ts-tool-group">
                <Button Size="@ButtonSize.Small" OnClick="PagePreviousRange">上一段</Button>
                <Button Size="@ButtonSize.Small" OnClick="PageNextRange" Disabled="@(!CanPageNext)">下一段</Button>
            </div>

            <div class="ts-tool-group">
                <span class="ts-range-text">@RangeText</span>
            </div>
        </div>

        </div>


        @if (summary.ChatCount == 0)
        {
            <div class="ts-empty">
                <Empty Description="@("该时间段内没有对话记录")"/>
                <div class="ts-empty-tip">
                    @if (HasRecordsInWindow)
                    {
                        <text>当前「记录区间」里没有数据，把上面的区间滑块拉开或点「重置」即可恢复。</text>
                    }
                    else
                    {
                        <text>角色下次对话后会自动生成记录；记录保存在 @RecordsHint</text>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="ts-kpis">
                @foreach (var kpi in kpis)
                {
                    <div class="ts-kpi">
                        <div class="ts-kpi-label">@kpi.Label</div>
                        <div class="ts-kpi-value">@kpi.Value</div>
                        <div class="ts-kpi-foot">@kpi.Foot</div>
                    </div>
                }
            </div>


            <div class="ts-card">
                <div class="ts-card-head">
                <div class="ts-card-title">用量走势</div>
                    <div class="ts-mode-toggles">
                        <Checkbox @bind-Value="normalizeMode">归一化</Checkbox>
                        <Checkbox @bind-Value="costMode">按价格口径</Checkbox>
                    </div>
                </div>

                <div class="ts-legend" style="margin-bottom:6px;">
                    <span class="ts-legend-item">
                        <span class="ts-legend-dot" style="background:#36cfc9"></span>
                        <Checkbox @bind-Value="showCached">缓存</Checkbox>
                    </span>
                    <span class="ts-legend-item">
                        <span class="ts-legend-dot" style="background:#1677ff"></span>
                        <Checkbox @bind-Value="showInput">输入</Checkbox>
                    </span>
                    <span class="ts-legend-item">
                        <span class="ts-legend-dot" style="background:#9254de"></span>
                        <Checkbox @bind-Value="showOutput">输出</Checkbox>
                    </span>
                </div>
                <div class="ts-chart-caption">@DisplayModeCaption</div>

                <div class="ts-chart">
                    <div class="ts-chart-axis">
                        <span>@AxisTopText</span>
                        <span>@AxisMidText</span>
                        <span>0</span>
                    </div>
                    <div class="ts-chart-body">
                        <div class="ts-grid-line" style="top: 0;"></div>
                        <div class="ts-grid-line" style="top: 50%;"></div>
                        <div class="ts-grid-line" style="top: 100%;"></div>
                        <div class="ts-bars">
                            @foreach (var bucket in buckets)
                            {
                                <div class="ts-bar-col">
                                    <div class="ts-bar-holder">
                                        @foreach (var series in ActiveSeries)
                                        {
                                            <div class="ts-bar" style="@BarStyle(bucket, series)" title="@($"{series.Label}: {FormatSeriesValue(series, bucket)}")"></div>
                                        }
                                    </div>
                                    <div class="ts-bar-label">@(ShouldShowLabel(bucket) ? bucket.Label : "")</div>

                                    <div class="ts-tip">
                                        <div class="ts-tip-title">@bucket.FullLabel</div>
                                        <div class="ts-tip-row"><span>对话次数</span><b>@bucket.ChatCount</b></div>
                                        @if (showCached)
                                        {
                                            <div class="ts-tip-row"><span>缓存</span><b>@bucket.InputCached.ToString("N0")（¥@bucket.InputHitCost.ToString("F4")）</b></div>
                                        }
                                        @if (showInput)
                                        {
                                            <div class="ts-tip-row"><span>输入</span><b>@((bucket.InputTotal - bucket.InputCached).ToString("N0"))（¥@bucket.InputMissCost.ToString("F4")）</b></div>
                                        }
                                        @if (showOutput)
                                        {
                                            <div class="ts-tip-row"><span>输出</span><b>@bucket.OutputTotal.ToString("N0")（¥@bucket.OutputCost.ToString("F4")）</b></div>
                                        }
                                        <div class="ts-tip-row"><span>命中率</span><b>@BucketHitRate(bucket)</b></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    @if (ShowRightAxis)
                    {
                        <div class="ts-chart-axis ts-chart-axis-right">
                            <span>@FormatCostValue(niceCostMax)</span>
                            <span>@FormatCostValue(niceCostMax / 2)</span>
                            <span>0</span>
                        </div>
                    }
                </div>
            </div>

            <div class="ts-card">
                <div class="ts-card-head">
                    <div class="ts-card-title">诊断摘要</div>
                    <div class="ts-card-sub">基于上方时间范围自动生成</div>
                </div>
                @if (insights.Count == 0)
                {
                    <div style="color: rgba(0,0,0,0.35); font-size: 12px;">该范围内数据不足，暂无法诊断</div>
                }
                else
                {
                    @foreach (var insight in insights)
                    {
                        <div class="ts-insight @InsightClass(insight.Level)">
                            <div class="ts-insight-title">@insight.Title</div>
                            <div class="ts-insight-detail">@insight.Detail</div>
                            <div class="ts-insight-advice">→ @insight.Advice</div>
                            <div class="ts-insight-basis">@insight.Basis</div>
                        </div>
                    }
                }
            </div>

        <div class="ts-divider"></div>

        <div class="ts-card">
            <div class="ts-card-head">
                <div class="ts-card-title">明细筛选</div>
                <div class="ts-card-sub">在上面的对话里再收窄，只影响「排行榜 / 对话记录」</div>
            </div>
                    <div class="ts-record-range">
                        <div class="ts-record-range-head">
                            <span class="ts-label">记录区间</span>
                            <span class="ts-record-range-text">@recordsFrom.ToString("MM-dd HH:mm") ~ @recordsTo.ToString("MM-dd HH:mm")</span>
                            <Button Size="@ButtonSize.Small" OnClick="ResetRecordRange">重置</Button>
                        </div>
                        <Slider TValue="(double, double)" Range="true" Min="0" Max="1000" Step="1"
                                Value="@recordRange" OnAfterChange="@OnRecordRangeChanged" TipFormatter="@FormatRangeTip" />
                        <div class="ts-slider-scale">
                            <span>@viewFrom.ToString("MM-dd HH:mm")</span>
                            <span>@SliderMidTime.ToString("MM-dd HH:mm")</span>
                            <span>@viewTo.ToString("MM-dd HH:mm")</span>
                        </div>
                    </div>
                        <div class="ts-filter">
                            <div class="ts-filter-card">
                                <div class="ts-filter-card-head">
                                    <span class="ts-filter-card-title">参与统计的名字</span>
                                    <span class="ts-filter-card-desc">蓝色=参与 · 灰色划线=已排除（不计入排行与分摊，原始记录不受影响）。点名字可单独排除该来源</span>
                                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Style="margin-left:auto; padding:0;"
                                            OnClick="ResetExcluded">全部恢复参与</Button>
                                </div>
                                <div class="ts-chips">
                                    @foreach (string name in knownNames)
                                    {
                                        <Button Size="@ButtonSize.Small" Class="@ChipClass(!IsExcluded(name))"
                                                OnClick="@(() => SetExcluded(name, IsExcluded(name)))">@name</Button>
                                    }
                                </div>
                            </div>
    
                            @if (parameterizedNames.Count > 0)
                            {
                                <div class="ts-filter-card">
                                    <div class="ts-filter-card-head">
                                        <span class="ts-filter-card-title">忽略参数</span>
                                        <span class="ts-filter-card-desc">忽略后「名称(参数)」合并成「名称」（默认忽略「时间」，避免每条时间戳各占一行）</span>
                                    </div>
                                    <div class="ts-chips">
                                        @foreach (string baseName in parameterizedNames)
                                        {
                                            <Button Size="@ButtonSize.Small" Class="@ChipClass(ignoredParamNames.Contains(baseName))"
                                                    OnClick="@(() => SetIgnoreParams(baseName, !ignoredParamNames.Contains(baseName)))">@baseName</Button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

            <div class="ts-scope-summary">
                <span class="ts-scope-label">当前生效</span>
                <span>@RangeText</span>
                <span class="ts-scope-dot">·</span>
                <span>基础 @summary.ChatCount 条</span>
                <span class="ts-scope-dot">·</span>
                <span>明细 @filteredRecords.Count 条</span>
                <span class="ts-scope-dot">·</span>
                <span>排除 @excludedNames.Count 个名字</span>
                <span class="ts-scope-dot">·</span>
                <span>忽略参数 @ignoredParamNames.Count 个</span>
                @if (dominantTagFilter != null || dominantFuncFilter != null)
                {
                    <span class="ts-scope-dot">·</span>
                    <span class="ts-scope-drill">下钻：@(dominantTagFilter ?? dominantFuncFilter)</span>
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Style="padding:0;" OnClick="ClearDominantFilter">清除</Button>
                }
            </div>
        </div>
            <div class="ts-rank-hint">点击表头切换排序（再点一次反向）；「占比 / 累计」按当前排序列计算。想看谁最耗输出，点「输出¥」列排序即可</div>

            <div class="ts-rank-grid">
                @foreach (var group in rankGroups)
                {

                    <div class="ts-card">
                        <div class="ts-card-head">
                            <div class="ts-card-title">@group.Title</div>
                            <div class="ts-card-sub">按明细筛选后分摊 · 点击名称可下钻到下方对话记录</div>
                        </div>

                        @{ List<RankRowView> ranked = RankRows(group); }

                        @if (ranked.Count == 0)
                        {
                            <div style="color: rgba(0,0,0,0.35); font-size: 12px; padding: 12px 0;">该范围内没有可归类的@(group.NameLabel)</div>
                        }
                        else
                        {
                            <table class="ts-rank-table">
                                <thead>
                                    <tr>
                                        <th class="ts-rank-idx">#</th>
                                        <th>
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.Name)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.Name))">@($"{group.NameLabel}{SortArrow(RankSortColumn.Name)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.Count)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.Count))">@($"次数{SortArrow(RankSortColumn.Count)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.Cached)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.Cached))">@($"缓存{SortArrow(RankSortColumn.Cached)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.CachedCost)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.CachedCost))">@($"缓存¥{SortArrow(RankSortColumn.CachedCost)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.Input)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.Input))">@($"输入{SortArrow(RankSortColumn.Input)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.InputCost)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.InputCost))">@($"输入¥{SortArrow(RankSortColumn.InputCost)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.Output)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.Output))">@($"输出{SortArrow(RankSortColumn.Output)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.OutputCost)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.OutputCost))">@($"输出¥{SortArrow(RankSortColumn.OutputCost)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">
                                            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="@SortHeaderStyle(RankSortColumn.Total)"
                                                    OnClick="@(() => OnRankSort(RankSortColumn.Total))">@($"合计¥{SortArrow(RankSortColumn.Total)}")</Button>
                                        </th>
                                        <th class="ts-rank-num">占比</th>
                                        <th class="ts-rank-num">累计</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < ranked.Count && i < 12; i++)
                                    {
                                        var view = ranked[i];
                                        var row = view.Row;
                                        bool selected = group.Kind == "tag" ? dominantTagFilter == row.Name : dominantFuncFilter == row.Name;
                                        <tr class="@(selected ? "ts-rank-row-active" : "")">
                                            <td class="ts-rank-idx">@view.Rank</td>
                                            <td>
                                                <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="padding:0; height:auto;"
                                                        OnClick="@(() => OnRankClicked(group.Kind, row.Name))">
                                                    @row.Name
                                                </Button>
                                                <div class="ts-rank-bar">
                                                    <div class="ts-rank-bar-fill" style="@BarWidth(view.Share)"></div>
                                                </div>
                                            </td>
                                            <td class="ts-rank-num">@row.ChatCount</td>
                                            <td class="ts-rank-num">@FormatTokenValue(row.CachedTokens)</td>
                                            <td class="ts-rank-num">@row.HitCost.ToString("F4")</td>
                                            <td class="ts-rank-num">@FormatTokenValue(row.InputMissTokens)</td>
                                            <td class="ts-rank-num">@row.MissCost.ToString("F4")</td>
                                            <td class="ts-rank-num">@FormatTokenValue(row.OutputTokens)</td>
                                            <td class="ts-rank-num">@row.OutputCost.ToString("F4")</td>
                                            <td class="ts-rank-num">@row.Cost.ToString("F4")</td>
                                            <td class="ts-rank-num">@view.Share.ToString("P1")</td>
                                            <td class="ts-rank-num">@view.Cumulative.ToString("P1")</td>
                                        </tr>
                                    }

                                    @if (ranked.Count > 12)
                                    {
                                        var restRow = SumRest([.. ranked.Skip(12)]);
                                        double restShare = 1 - ranked[11].Cumulative;
                                        <tr class="ts-rank-rest">
                                            <td class="ts-rank-idx">…</td>
                                            <td>@restRow.Name</td>
                                            <td class="ts-rank-num">@restRow.ChatCount</td>
                                            <td class="ts-rank-num">@FormatTokenValue(restRow.CachedTokens)</td>
                                            <td class="ts-rank-num">@Money(restRow.HitCost)</td>
                                            <td class="ts-rank-num">@FormatTokenValue(restRow.InputMissTokens)</td>
                                            <td class="ts-rank-num">@Money(restRow.MissCost)</td>
                                            <td class="ts-rank-num">@FormatTokenValue(restRow.OutputTokens)</td>
                                            <td class="ts-rank-num">@Money(restRow.OutputCost)</td>
                                            <td class="ts-rank-num">@Money(restRow.Cost)</td>
                                            <td class="ts-rank-num">@restShare.ToString("P1")</td>
                                            <td class="ts-rank-num">100.0%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            </div>

            <div class="ts-card">
                <div class="ts-card-head">
                    <div class="ts-card-title">对话记录</div>
                    <div class="ts-card-sub">@filteredRecords.Count 条 · @(recordSortMode == "cost" ? "按开销降序" : "按时间正序") · 第 @(pageIndex + 1) 页</div>
                </div>

                @if (dominantTagFilter != null || dominantFuncFilter != null)
                {
                    <div class="ts-active-filter">
                        <span class="ts-label">仅看</span>
                        @if (dominantTagFilter != null)
                        {
                            <Tag Color="@("blue")">标签 · @dominantTagFilter</Tag>
                        }
                        @if (dominantFuncFilter != null)
                        {
                            <Tag Color="@("green")">函数 · @dominantFuncFilter</Tag>
                        }
                        <Button Size="@ButtonSize.Small" OnClick="ClearDominantFilter">清除筛选</Button>
                    </div>
                }


                <div class="ts-controls">
                    <RadioGroup TValue="string" Value="@viewMode" ValueChanged="@(OnViewModeChanged)" ButtonStyle="@RadioButtonStyle.Solid">
                        <Radio RadioButton Value="@("all")">全部</Radio>
                        <Radio RadioButton Value="@("input")">只看输入</Radio>
                        <Radio RadioButton Value="@("output")">只看输出</Radio>
                    </RadioGroup>
                    <RadioGroup TValue="string" Value="@recordSortMode" ValueChanged="@(OnRecordSortChanged)" ButtonStyle="@RadioButtonStyle.Solid">
                        <Radio RadioButton Value="@("time")">按时间</Radio>
                        <Radio RadioButton Value="@("cost")">按开销</Radio>
                    </RadioGroup>
                    <Checkbox @bind-Value="hideThinking">隐藏思考</Checkbox>
                    <Button Size="@ButtonSize.Small" OnClick="ExpandAllTurns">全部展开</Button>
                    <Button Size="@ButtonSize.Small" OnClick="CollapseAllTurns">全部折叠</Button>
                </div>


                <div class="ts-turns">
                    @foreach (var view in pageRecords)
                    {
                        bool collapsed = expandedTurns.Contains(view.Record.Id) == false;
                        <div class="ts-turn-card">
                            <div class="ts-turn-head">
                                <div class="ts-head-row">
                                    <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="padding:0 4px; height:auto;"
                                            OnClick="@(() => ToggleTurn(view.Record.Id))">@(collapsed ? "▸" : "▾")</Button>
                                    <span class="ts-turn-time">@view.Record.Time.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                    @if (costRanks.TryGetValue(view.Record.Id, out int costRank))
                                    {
                                        <span class="ts-rank-badge">开销第 @costRank</span>
                                    }
                                </div>

                                <div class="ts-head-row">
                                    <span class="ts-head-label">内容</span>
                                    @if (view.TagWeights.Count == 0 && view.FuncWeights.Count == 0)
                                    {
                                        <span class="ts-dominant ts-dominant-none">无内容可归属</span>
                                    }
                                    else
                                    {
                                        @foreach (var share in MergedShares(view.TagWeights, view.FuncWeights))
                                        {
                                            <span class="@(share.Name == TokenStatisticsService.NoDominantName ? "ts-dominant ts-dominant-none" : (share.IsFunc ? "ts-dominant ts-dominant-func" : "ts-dominant"))">@ChipName(share.Name) @share.Percent%</span>
                                        }
                                    }
                                </div>

                                <div class="ts-head-row ts-head-tokens">
                                    <span>缓存 @view.Record.InputCached.ToString("N0")（¥@Money(view.HitCost)）</span>
                                    <span class="ts-head-dot">·</span>
                                    <span>输入 @((view.Record.InputTotal - view.Record.InputCached).ToString("N0"))（¥@Money(view.MissCost)）</span>
                                    <span class="ts-head-dot">·</span>
                                    <span>输出 @view.Record.OutputTotal.ToString("N0")（¥@Money(view.OutputCost)）</span>
                                    <span class="ts-head-dot">·</span>
                                    <span class="ts-head-total">共 ¥@Money(view.Cost)</span>
                                </div>
                            </div>

                            @if (collapsed == false)
                            {
                                <div class="ts-turn-body">
                                    @if (viewMode != "output")
                                    {
                                        <div class="ts-row ts-row-input">
                                            <div class="ts-bubble ts-bubble-in">
                                                <div class="ts-bubble-head">
                                                    @if (view.TagWeights.Count == 0)
                                                    {
                                                        <span class="ts-dominant ts-dominant-none">无标签</span>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var share in MergedShares(view.TagWeights, []))
                                                        {
                                                            <span class="ts-dominant">@ChipName(share.Name) @share.Percent%</span>
                                                        }
                                                    }
                                                </div>
                                                <pre class="ts-text">@view.Record.UserMessage</pre>
                                                <div class="ts-bubble-meta">
                                                    <span>缓存 @view.Record.InputCached.ToString("N0")（¥@Money(view.HitCost)）</span>
                                                    <span>输入 @((view.Record.InputTotal - view.Record.InputCached).ToString("N0"))（¥@Money(view.MissCost)）</span>
                                                    <span>命中率 @view.HitRate.ToString("P1")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (viewMode != "input")
                                    {
                                        <div class="ts-row ts-row-output">
                                            <div class="ts-bubble ts-bubble-out">
                                                <div class="ts-bubble-head">
                                                    @if (view.FuncWeights.Count == 0)
                                                    {
                                                        <span class="ts-dominant ts-dominant-none">纯文本（无函数调用）</span>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var share in MergedShares([], view.FuncWeights))
                                                        {
                                                            <span class="@(share.Name == TokenStatisticsService.NoDominantName ? "ts-dominant ts-dominant-none" : "ts-dominant ts-dominant-func")">@ChipName(share.Name) @share.Percent%</span>
                                                        }
                                                    }
                                                </div>

                                                @if (!hideThinking && string.IsNullOrWhiteSpace(view.Record.AiThinking) == false)
                                                {
                                                    bool expanded = expandedThinking.Contains(view.Record.Id);
                                                    <div class="ts-thinking">
                                                        <Button Type="@ButtonType.Link" Size="@ButtonSize.Small"
                                                                OnClick="@(() => ToggleThinking(view.Record.Id))">
                                                            @(expanded ? "▾ 收起思考" : "▸ 展开思考")
                                                        </Button>
                                                        @if (expanded)
                                                        {
                                                            <pre class="ts-thinking-body">@view.Record.AiThinking</pre>
                                                        }
                                                    </div>
                                                }

                                                <pre class="ts-text">@view.Record.AiMessage</pre>
                                                <div class="ts-bubble-meta ts-meta-right">
                                                    <span>输出 @view.Record.OutputTotal.ToString("N0")（¥@Money(view.OutputCost)）</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (filteredRecords.Count > pageSize)
                {
                    <div class="ts-pager">
                        <Pagination Current="pageIndex + 1" Total="filteredRecords.Count" PageSize="pageSize"
                                    OnChange="@OnPageChanged" ShowSizeChanger="false"/>
                    </div>
                }
            </div>
        }
    }
</div>

