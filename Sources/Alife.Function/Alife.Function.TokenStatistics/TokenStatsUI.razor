    // ── 时间范围：基准日（窗口右端，不动）+ 跨度（往前回溯 N 天）+ 翻页 ──

    /// <summary>
    /// 基准日：窗口的右端（含当日）。改跨度时这个日期保持不动，窗口往前扩张。
    /// </summary>
    DateTime rangeAnchor = DateTime.Today;

    /// <summary>跨度（天）：从基准日往前回溯的天数。</summary>
    int spanDays = 1;

    /// <summary>跨度输入框：直接改数字即生效，与预设按钮共用同一套逻辑。</summary>
    int SpanInput
    {
        get => spanDays;
        set
        {
            if (value > 0 && value != spanDays)
                ChangeSpan(value);
        }
    }

    DateTime? RangeAnchorDate => rangeAnchor;

    /// <summary>窗口左端（含当日）。</summary>
    DateTime WindowStartDate => rangeAnchor.AddDays(-(spanDays - 1));

    bool CanPageNext => rangeAnchor.Date < DateTime.Today;

    string RangeText => spanDays == 1
        ? $"{rangeAnchor:MM-dd} 单日"
        : $"{WindowStartDate:MM-dd} ~ {rangeAnchor:MM-dd}（{spanDays} 天）";

    void OnRangeAnchorChanged(DateTime? value)
    {
        if (value.HasValue == false)
            return;
        rangeAnchor = value.Value.Date;
        ApplyRange();
    }

    /// <summary>切换跨度时基准日不动，窗口往前扩张/收缩。</summary>
    void OnSpanDaysChanged(int value) => ChangeSpan(value);

    void ChangeSpan(int days)
    {
        spanDays = Math.Clamp(days, 1, 365);
        ApplyRange();
    }

    void PagePreviousRange()
    {
        rangeAnchor = rangeAnchor.AddDays(-spanDays);
        ApplyRange();
    }

    void PageNextRange()
    {
        if (CanPageNext == false)
            return;
        rangeAnchor = rangeAnchor.AddDays(spanDays);
        if (rangeAnchor.Date > DateTime.Today)
            rangeAnchor = DateTime.Today;
        ApplyRange();
    }

    /// <summary>按当前基准日与跨度重算查询窗口，并把记录区间滑块复位。</summary>
    void ApplyRange()
    {
        DateTimeOffset now = DateTimeOffset.Now;
        viewFrom = new DateTimeOffset(WindowStartDate, now.Offset);
        viewTo = new DateTimeOffset(rangeAnchor.AddDays(1), now.Offset);
        spanFrom = viewFrom;
        spanTo = viewTo;
        recordRange = (0, 1000);
        pageIndex = 0;
        Reload();
    }

    /// <summary>当前窗口覆盖到的年份（含今年与去年），节假日按需加载。</summary>
    List<int> HolidayYearsInRange()
    {
        int first = viewFrom.Year;
        int last = viewTo.AddTicks(-1).Year;
        int thisYear = DateTime.Now.Year;

        HashSet<int> years = [thisYear, thisYear - 1];
        for (int year = first; year <= last; year++)
            years.Add(year);

        return [.. years.OrderBy(year => year)];
    }

    /// <summary>首次进入某角色：创建日历并补齐窗口涉及的年份。</summary>
    async Task LoadHolidaysAsync(string characterName)
    {
        HolidayCalendar calendar = TokenStatisticsLocator.CreateHolidayCalendar(characterName);
        await EnsureHolidayYearsAsync(calendar, force: false);

        await InvokeAsync(() => {
            if (string.Equals(holidayCharacter, characterName, StringComparison.Ordinal) == false)
                return;
            holidayCalendar = calendar;
            UpdateHolidayStatus();
            Reload();
        });
    }

    /// <summary>按需补齐年份；force=true 用于面板上手动刷新。</summary>
    async Task EnsureHolidayYearsAsync(HolidayCalendar calendar, bool force)
    {
        List<int> pending = [];
        foreach (int year in HolidayYearsInRange())
        {
            if (force)
            {
                pending.Add(year);
                continue;
            }

            if (calendar.LoadedYears.Contains(year) || calendar.MissingYears.Contains(year))
                continue;
            if (holidayRequestedYears.Contains(year))
                continue;

            holidayRequestedYears.Add(year);
            pending.Add(year);
        }

        foreach (int year in pending)
            await calendar.EnsureYearAsync(year, force: force);
    }

    /// <summary>窗口跨到新年份时补加载；有新增年份则刷新一次界面。</summary>
    async Task EnsureHolidayYearsFromRangeAsync()
    {
        if (holidayCalendar is null)
            return;

        int before = holidayCalendar.LoadedYears.Count;
        await EnsureHolidayYearsAsync(holidayCalendar, force: false);
        if (holidayCalendar.LoadedYears.Count == before)
            return;

        await InvokeAsync(() => {
            UpdateHolidayStatus();
            Reload();
        });
    }

    void UpdateHolidayStatus()
    {
        if (holidayCalendar is null)
        {
            holidayStatus = "加载中…";
            return;
        }

        holidayRefreshedAt = DateTime.Now;
        List<int> loaded = [.. holidayCalendar.LoadedYears];
        List<int> missing = [.. holidayCalendar.MissingYears];

        string loadedText = loaded.Count > 0 ? string.Join("/", loaded) : "无";
        holidayStatus = missing.Count == 0
            ? $"{loadedText} 已加载"
            : $"{loadedText} 已加载；{string.Join("/", missing)} 不可用（按星期判断）";
    }

    /// <summary>面板按钮：强制重拉节假日（应对公告后续修订）。</summary>
    async Task RefreshHolidays()
    {
        if (holidayCalendar is null || string.IsNullOrEmpty(holidayCharacter))
            return;

        holidayStatus = "刷新中…";
        StateHasChanged();

        await EnsureHolidayYearsAsync(holidayCalendar, force: true);
        await InvokeAsync(() => {
            UpdateHolidayStatus();
            Reload();
        });
    }

    /// <summary>把编辑结果写回全局配置库（所有角色共享），并记住本角色的选择。</summary>
    /// <summary>把编辑结果写回全局配置库（所有角色共享），并记住本角色的选择。</summary>
    void SavePriceProfile()
    {
        if (string.IsNullOrEmpty(selectedCharacter))
            return;

        ApplyRuleEdits();
        PriceProfileStore.Save(TokenStatisticsLocator.PriceProfilesFile, priceProfiles);
        TokenPriceStore.SaveProfileId(TokenStatisticsLocator.PriceFileFor(selectedCharacter), priceProfile.Id);
        selectedProfileId = priceProfile.Id;
        priceSnapshot = PriceProfileStore.Serialize(priceProfiles);
        Reload();
    }

    /// <summary>把当前配置恢复成内置默认值（只对两个内置配置有效）。</summary>
    void ResetPriceProfile()
    {
        PriceProfile? builtin = PriceProfileStore.CreateDefaults().FirstOrDefault(item => item.Id == priceProfile.Id);
        if (builtin is null)
            return;

        int index = priceProfiles.FindIndex(item => item.Id == priceProfile.Id);
        if (index >= 0)
            priceProfiles[index] = builtin;
        else
            priceProfiles.Add(builtin);

        priceProfile = builtin;
        LoadRuleEdits();
        SavePriceProfile();
    }

    /// <summary>切换本角色使用的价格配置。</summary>
    void OnProfileChanged(string profileId)
    {
        if (string.IsNullOrEmpty(profileId) || string.IsNullOrEmpty(selectedCharacter))
            return;

        PriceProfile? target = priceProfiles.FirstOrDefault(item => item.Id == profileId);
        if (target is null)
            return;

        selectedProfileId = profileId;
        priceProfile = target;
        TokenPriceStore.SaveProfileId(TokenStatisticsLocator.PriceFileFor(selectedCharacter), profileId);
        LoadRuleEdits();
        Reload();
    }

    /// <summary>基于当前配置复制一份新配置（想改价格又不想动内置配置时用）。</summary>
    void DuplicateProfile()
    {
        PriceProfile copy = new()
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            Name = priceProfile.Name + " 副本",
            IsDefault = false,
            Baseline = ClonePrices(priceProfile.Baseline),
            Overrides = [.. priceProfile.Overrides.Select(rule => new PriceRule {
                Name = rule.Name,
                WorkdaysOnly = rule.WorkdaysOnly,
                Windows = [.. rule.Windows],
                Prices = ClonePrices(rule.Prices),
            })],
        };

        priceProfiles.Add(copy);
        priceProfile = copy;
        selectedProfileId = copy.Id;
        LoadRuleEdits();
        SavePriceProfile();
    }

    static UnitPrices ClonePrices(UnitPrices source) => new()
    {
        InputHitPerM = source.InputHitPerM,
        InputMissPerM = source.InputMissPerM,
        OutputPerM = source.OutputPerM,
    };

    /// <summary>删除自定义配置（两个内置配置不可删）。</summary>
    void DeleteProfile()
    {
        if (priceProfile.IsDefault || priceProfiles.Count <= 1)
            return;

        priceProfiles.RemoveAll(item => item.Id == priceProfile.Id);
        priceProfile = priceProfiles[0];
        selectedProfileId = priceProfile.Id;
        LoadRuleEdits();
        SavePriceProfile();
    }

    void TogglePriceConfig()
    {
        showPriceConfig = !showPriceConfig;
        if (showPriceConfig)
        {
            LoadRuleEdits();
            priceSnapshot = PriceProfileStore.Serialize(priceProfiles);
        }
        else
        {
            priceSnapshot = "";
        }
    }

    /// <summary>是否有未保存的改动（仅编辑面板展开时计算）。</summary>
    bool PriceDirty => showPriceConfig && priceSnapshot.Length > 0
        && string.Equals(priceSnapshot, PriceProfileStore.Serialize(priceProfiles), StringComparison.Ordinal) == false;

    /// <summary>把覆盖规则的时段转成文本编辑框（只影响界面，保存时才写回模型）。</summary>
    void LoadRuleEdits()
    {
        ruleEdits = [.. priceProfile.Overrides.Select(rule => new RuleEdit {
            Rule = rule,
            Windows = [.. rule.Windows.Select(window => new WindowEdit {
                StartText = MinutesToText(window.StartMinute),
                EndText = MinutesToText(window.EndMinute),
            })],
        })];
    }

    void AddRule()
    {
        PriceRule rule = new()
        {
            Name = "覆盖",
            WorkdaysOnly = true,
            Prices = ClonePrices(priceProfile.Baseline),
            Windows = [new TimeWindow(9 * 60, 12 * 60)],
        };

        priceProfile.Overrides.Add(rule);
        ruleEdits.Add(new RuleEdit {
            Rule = rule,
            Windows = [new WindowEdit { StartText = "09:00", EndText = "12:00" }],
        });
    }

    void RemoveRule(RuleEdit edit)
    {
        priceProfile.Overrides.Remove(edit.Rule);
        ruleEdits.Remove(edit);
    }

    void AddWindow(RuleEdit edit)
    {
        edit.Windows.Add(new WindowEdit { StartText = "09:00", EndText = "12:00" });
    }

    void RemoveWindow(RuleEdit edit, WindowEdit window) => edit.Windows.Remove(window);

    /// <summary>把文本编辑框写回各规则的 Windows（解析失败或区间非法的行忽略）。</summary>
    void ApplyRuleEdits()
    {
        foreach (RuleEdit edit in ruleEdits)
        {
            List<TimeWindow> windows = [];
            foreach (WindowEdit window in edit.Windows)
            {
                if (TryParseMinutes(window.StartText, out int start) == false)
                    continue;
                if (TryParseMinutes(window.EndText, out int end) == false)
                    continue;
                if (end <= start)
                    continue;
                windows.Add(new TimeWindow(start, end));
            }

            windows.Sort((left, right) => left.StartMinute.CompareTo(right.StartMinute));
            edit.Rule.Windows = windows;
        }

        priceProfile.Overrides = [.. ruleEdits.Select(edit => edit.Rule)];
    }

    /// <summary>
    /// 单条对话的金额自适应精度：金额很小时（缓存费常见 1e-5 量级）多给几位小数，
    /// 否则四舍五入会把"便宜但有值"的数字抹成 0。
    /// </summary>
    static string Money(double value) => value switch
    {
        >= 1 => value.ToString("F4"),
        >= 0.01 => value.ToString("F5"),
        >= 0.0001 => value.ToString("F6"),
        _ => value.ToString("F7"),
    };
    /// <summary>把 Storage 根目录前缀去掉，界面上显示相对路径更易读。</summary>
    static string ShortenPath(string path)
    {
        string root = Alife.Foundation.AlifePath.StorageFolderPath;
        if (string.IsNullOrEmpty(root))
            return path;
        string prefix = root.TrimEnd(System.IO.Path.DirectorySeparatorChar) + System.IO.Path.DirectorySeparatorChar;
        return path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            ? "Storage" + System.IO.Path.DirectorySeparatorChar + path[prefix.Length..]
            : path;
    }

    static string MinutesToText(int minutes) => $"{minutes / 60:00}:{minutes % 60:00}";

    static bool TryParseMinutes(string? text, out int minutes)
    {
        minutes = 0;
        if (string.IsNullOrWhiteSpace(text))
            return false;

        string[] parts = text.Split(':', '：');
        if (parts.Length != 2)
            return false;
        if (int.TryParse(parts[0], out int hour) == false || int.TryParse(parts[1], out int minute) == false)
            return false;
        if (hour < 0 || hour > 24 || minute < 0 || minute > 59)
            return false;

        minutes = Math.Clamp(hour * 60 + minute, 0, 1440);
        return true;
    }

    /// <summary>面板展示用：把覆盖规则拼成 "高峰（仅工作日 09:00-12:00、14:00-18:00）"。</summary>
    static string OverrideText(PriceProfile? profile)
    {
        if (profile is null)
            return "—";
        if (profile.Overrides.Count == 0)
            return "无（全时段基线价）";

        List<string> parts = [];
        foreach (PriceRule rule in profile.Overrides)
        {
            string windows = rule.Windows.Count == 0
                ? "未设时段"
                : string.Join("、", rule.Windows.Select(window =>
                    $"{MinutesToText(window.StartMinute)}-{MinutesToText(window.EndMinute)}"));
            parts.Add($"{rule.Name}{(rule.WorkdaysOnly ? "（仅工作日）" : "")} {windows}");
        }
        return string.Join("；", parts);
    }

    sealed class RuleEdit
    {
        public PriceRule Rule { get; set; } = new();
        public List<WindowEdit> Windows { get; set; } = [];
    }

    sealed class WindowEdit
    {
        public string StartText { get; set; } = "";
        public string EndText { get; set; } = "";
    }


    void Reload()
    {
        if (string.IsNullOrEmpty(selectedCharacter))
            return;

        // 全局配置库只读一次；角色切换时重新解析"用的是哪个配置"
        if (priceProfiles.Count == 0)
            priceProfiles = TokenStatisticsLocator.LoadPriceProfiles();

        if (string.Equals(priceProfilesCharacter, selectedCharacter, StringComparison.Ordinal) == false)
        {
            priceProfilesCharacter = selectedCharacter;
            priceProfile = TokenStatisticsLocator.ResolvePriceProfile(selectedCharacter, priceProfiles);
            selectedProfileId = priceProfile.Id;
            LoadRuleEdits();
        }

        if (string.Equals(holidayCharacter, selectedCharacter, StringComparison.Ordinal) == false)
        {
            holidayCharacter = selectedCharacter;
            holidayCalendar = null;
            holidayStatus = "加载中…";
            _ = LoadHolidaysAsync(selectedCharacter);
        }

        service = TokenStatisticsLocator.CreateService(selectedCharacter, holidayCalendar, priceProfile);
        _ = EnsureHolidayYearsFromRangeAsync();

        ApplyRecordRange();

        TagFilter filter = new(excludedNames, ignoredParamNames);
        filteredRecords = service.QueryRecords(recordsFrom, recordsTo, filter).ToList();

        // 排行榜下钻：只看选中的主导标签/函数
        if (dominantTagFilter != null)
            filteredRecords = filteredRecords.Where(view => view.HasTag(dominantTagFilter)).ToList();
        if (dominantFuncFilter != null)
            filteredRecords = filteredRecords.Where(view => view.HasFunc(dominantFuncFilter)).ToList();


        // 两层数据：
        //   基础范围（基准日 + 跨度，不做名称筛选、不含记录区间滑块）→ 总览 KPI、柱状图、诊断摘要
        //   明细筛选（基础范围 ∩ 记录区间 ∩ 名称筛选 ∩ 下钻）→ 排行榜、对话记录
        baseRecords = service.QueryRecords(viewFrom, viewTo, new TagFilter([], ignoredParamNames)).ToList();

        summary = new TokenStatisticsService.RangeSummary(
            baseRecords.Count,
            (int)baseRecords.Sum(view => (long)view.Record.InputTotal),
            (int)baseRecords.Sum(view => (long)view.Record.InputCached),
            (int)baseRecords.Sum(view => (long)view.Record.OutputTotal),
            baseRecords.Sum(view => view.MissCost),
            baseRecords.Sum(view => view.HitCost),
            baseRecords.Sum(view => view.OutputCost));

        // 给每条记录标上"开销第 N"（按当前筛选结果降序），不再只标前 10 条
        costRanks.Clear();
        foreach (var view in filteredRecords.OrderByDescending(view => view.Cost))
            costRanks[view.Record.Id] = costRanks.Count + 1;

        // 记录区间内的合计，用于"每条记录占所选范围"的百分比
        knownNames = [.. service.KnownNames(spanFrom, spanTo, filter)];
        parameterizedNames.Clear();
        parameterizedNames.AddRange(service.ParameterizedBaseNames(spanFrom, spanTo));

        long tokens = summary.InputTotal + summary.OutputTotal;
        long missTokens = summary.InputMissTokens;
        kpis =
        [
            new Kpi("对话条数", summary.ChatCount.ToString("N0"), "时间范围内的对话数"),
            new Kpi("缓存", summary.InputCached.ToString("N0"),
                    "¥" + summary.HitCost.ToString("F4") + " · 命中率 " + summary.HitRate.ToString("P1")),
            new Kpi("输入", missTokens.ToString("N0"),
                    "¥" + summary.MissCost.ToString("F4") + " · 与缓存各自计费"),
            new Kpi("输出", summary.OutputTotal.ToString("N0"),
                    "¥" + summary.OutputCost.ToString("F4") + " · 占总量 " + FormatShare(summary.OutputTotal, tokens)),
            new Kpi("总花费", "¥" + summary.Cost.ToString("F4"), "平均每次 ¥" + summary.AverageCost.ToString("F5")),
        ];

        // 与上一段同长度窗口对比（诊断只做对比，不用拍脑袋阈值）
        // 诊断也属于"基础范围"层：本期 = 基准日+跨度内的全部对话；基线 = 紧邻的等长窗口
        List<TokenStatisticsService.RecordView> baselineRecords =
            service.QueryRecords(viewFrom - (viewTo - viewFrom), viewFrom, new TagFilter([], ignoredParamNames)).ToList();

        // "缓存优化空间"的目标值来自历史：近 30 天里样本够、命中率最高的一天
        TokenStatisticsService.HitRateTarget? hitRateTarget = service.BestDailyHitRate(
            viewFrom.AddDays(-TokenStatisticsDiagnostics.LookbackDays), viewFrom, TokenStatisticsDiagnostics.MinSamplesForTrend);

        insights = TokenStatisticsDiagnostics.Analyze(baseRecords, baselineRecords, viewTo - viewFrom,
            time => priceProfile.IsOverridden(time, EffectiveCalendar), holidayStatus, hitRateTarget).ToList();
        BuildRankGroups();
        RefreshBuckets();
        SlicePage();
    }

    void RefreshBuckets()
    {
        if (service == null)
            return;

        // 图表属于"基础范围"层：时间轴与数据都只用基准日 + 跨度，不受记录区间/名称筛选影响
        TimeSpan span = viewTo - viewFrom;
        if (span <= TimeSpan.Zero)
            span = TimeSpan.FromHours(1);
        TimeSpan width;
        BucketLabelMode labelMode;

        if (span.TotalHours <= 36)
        {
            width = TimeSpan.FromHours(1);
            labelMode = BucketLabelMode.Hour;
        }
        else if (span.TotalDays <= 92)
        {
            width = TimeSpan.FromDays(1);
            labelMode = BucketLabelMode.Day;
        }
        else
        {
            width = TimeSpan.FromDays(7);
            labelMode = BucketLabelMode.Day;
        }

        buckets = service.Bucketize(baseRecords, viewFrom, viewTo, width, labelMode).ToList();
        double tokenMax = 0;
        double costMax = 0;
        foreach (var bucket in buckets)
        {
            // 柱高 = 缓存 + 未命中输入 + 输出 = InputTotal + OutputTotal；纵轴按这个总量取整，柱子才不会顶到顶或过矮
            tokenMax = Math.Max(tokenMax, (double)bucket.InputTotal + bucket.OutputTotal);
            costMax = Math.Max(costMax, bucket.Cost);
        }
        niceTokenMax = NiceCeiling(tokenMax);
        niceCostMax = NiceCeiling(costMax);
    }

    void OnRecordSortChanged(string mode)
    {
        recordSortMode = mode;
        pageIndex = 0;
        SlicePage();
    }

    /// <summary>按当前排序方式给出记录顺序：时间正序（默认）或开销降序。</summary>
    IEnumerable<TokenStatisticsService.RecordView> OrderedRecords()
        => recordSortMode == "cost"
            ? filteredRecords.OrderByDescending(view => view.Cost)
            : filteredRecords;

    void SlicePage()
    {
        int maxPage = Math.Max(0, (filteredRecords.Count - 1) / pageSize);
        if (pageIndex > maxPage)
            pageIndex = maxPage;

        pageRecords = OrderedRecords()
            .Skip(pageIndex * pageSize)
            .Take(pageSize)
            .ToList();
    }

    string BarStyle(TokenStatisticsService.Bucket bucket, SeriesDef series)
    {
        double value = series.Value(bucket);
        double ratio = series.Max <= 0 ? 0 : value / series.Max;
        double percent = Math.Clamp(ratio * 100, 0, 100);
        return $"height:{percent:F1}%; background:{series.Color};";
    }

    string DisplayModeCaption => (normalizeMode, costMode) switch
    {
        (true, true) => $"共 {buckets.Count} 个时段；每根柱子按「缓存 / 输入 / 输出」的费用构成做 100% 堆叠（看结构）。",
        (true, false) => $"共 {buckets.Count} 个时段；每根柱子按「缓存 / 输入 / 输出」的 Token 构成做 100% 堆叠（看结构）。",
        (false, true) => $"共 {buckets.Count} 个时段；三段已按当前峰谷单价折算为金额（元）后堆叠，柱高即该时段花费。",
        _ => $"共 {buckets.Count} 个时段；每根柱子堆叠「缓存 / 输入 / 输出」的 Token 数，柱高为三者之和。鼠标悬停查看明细。",
    };

    string AxisTopText => normalizeMode ? "100%" : (costMode ? FormatCostValue(niceCostMax) : FormatTokenValue(niceTokenMax));

    string AxisMidText => normalizeMode ? "50%" : (costMode ? FormatCostValue(niceCostMax / 2) : FormatTokenValue(niceTokenMax / 2));

    bool ShowRightAxis => false;

    static string BucketHitRate(TokenStatisticsService.Bucket bucket)
        => bucket.InputTotal > 0 ? ((double)bucket.InputCached / bucket.InputTotal).ToString("P1") : "—";

    /// <summary>堆叠柱的三个分段：输入未命中、输入缓存命中、输出。每次渲染重算，勾选变化即时生效。</summary>
    List<SeriesDef> ActiveSeries => BuildSeries();

    List<SeriesDef> BuildSeries()
    {
        List<SeriesDef> list = new();
        if (buckets.Count == 0)
            return list;

        // 堆叠总量：按价格口径用金额总量，否则用 Token 总量（输入含缓存，故 = InputTotal + OutputTotal）
        double maxTotal = buckets.Max(b => costMode ? b.Cost : b.InputTotal + b.OutputTotal);

        // 归一化时每段取"该时段内部占比"，柱高合计恒为 100%
        double TokenTotal(TokenStatisticsService.Bucket b) => Math.Max(1d, b.InputTotal + b.OutputTotal);
        double CostTotal(TokenStatisticsService.Bucket b) => b.Cost <= 0 ? 1d : b.Cost;

        if (showInput)
        {
            list.Add(costMode
                ? new SeriesDef("输入未命中", "#1677ff",
                    b => normalizeMode ? b.InputMissCost / CostTotal(b) : b.InputMissCost,
                    normalizeMode ? 1 : maxTotal, true)
                : new SeriesDef("输入未命中", "#1677ff",
                    b => normalizeMode ? (b.InputTotal - b.InputCached) / TokenTotal(b) : b.InputTotal - b.InputCached,
                    normalizeMode ? 1 : maxTotal, false));
        }

        if (showCached)
        {
            list.Add(costMode
                ? new SeriesDef("输入缓存命中", "#36cfc9",
                    b => normalizeMode ? b.InputHitCost / CostTotal(b) : b.InputHitCost,
                    normalizeMode ? 1 : maxTotal, true)
                : new SeriesDef("输入缓存命中", "#36cfc9",
                    b => normalizeMode ? b.InputCached / TokenTotal(b) : b.InputCached,
                    normalizeMode ? 1 : maxTotal, false));
        }

        if (showOutput)
        {
            list.Add(costMode
                ? new SeriesDef("输出", "#9254de",
                    b => normalizeMode ? b.OutputCost / CostTotal(b) : b.OutputCost,
                    normalizeMode ? 1 : maxTotal, true)
                : new SeriesDef("输出", "#9254de",
                    b => normalizeMode ? b.OutputTotal / TokenTotal(b) : b.OutputTotal,
                    normalizeMode ? 1 : maxTotal, false));
        }

        return list;
    }

    string FormatSeriesValue(SeriesDef series, TokenStatisticsService.Bucket bucket)
    {
        double value = series.Value(bucket);
        if (normalizeMode)
            return value.ToString("P1");
        return series.IsCost ? "¥" + value.ToString("F5") : value.ToString("N0");
    }

    sealed record SeriesDef(string Label, string Color, Func<TokenStatisticsService.Bucket, double> Value, double Max, bool IsCost);

    bool ShouldShowLabel(TokenStatisticsService.Bucket bucket)
    {
        if (buckets.Count == 0)
            return false;
        int index = buckets.IndexOf(bucket);
        int step = Math.Max(1, (int)Math.Ceiling(buckets.Count / 12.0));
        if (buckets.Count <= 12)
            return true;
        return index % step == 0;
    }

    static string FormatTokenValue(double value)
    {
        if (value >= 1_000_000)
            return (value / 1_000_000d).ToString("0.##") + "M";
        if (value >= 10_000)
            return (value / 1000d).ToString("0.#") + "k";
        return value.ToString("N0");
    }

    static string FormatCostValue(double value)
        => value >= 0.01 ? value.ToString("F2") : value.ToString("F4");

    static string FormatShare(long part, long total) => total <= 0 ? "—" : (part / (double)total).ToString("P1");

    static double NiceCeiling(double value)
    {
        if (value <= 0)
            return 1;

        double magnitude = Math.Pow(10, Math.Floor(Math.Log10(value)));
        double normalized = value / magnitude;
        double niceNormalized = normalized switch
        {
            <= 1 => 1,
            <= 2 => 2,
            <= 5 => 5,
            _ => 10,
        };
        return niceNormalized * magnitude;
    }

    /// <summary>
    /// 标签/函数的显示名：源(ExecutionService) → 源·ExecutionService。
    /// 直接取括号前会丢掉关键信息（所有来源都变成"源"），这里把参数并进名字里。
    /// </summary>
    static string ChipName(string name)
    {
        int open = name.IndexOfAny(['(', '（']);
        int close = name.LastIndexOfAny([')', '）']);
        if (open < 0 || close <= open)
            return name;

        string inner = name.Substring(open + 1, close - open - 1);
        if (inner.Length > 16)
            inner = inner[..16] + "…";
        return name.Substring(0, open) + "·" + inner;
    }
    static string InsightClass(TokenStatisticsDiagnostics.Severity level) => level switch
    {
        TokenStatisticsDiagnostics.Severity.Critical => "ts-insight-critical",
        TokenStatisticsDiagnostics.Severity.Warning => "ts-insight-warning",
        _ => "ts-insight-info",
    };

    void BuildRankGroups()
    {
        if (service is null)
        {
            rankGroups = [];
            return;
        }

        rankGroups =
        [
            new RankGroup("标签排行", "每条对话按各标签字节占比分摊（可多选并存）", "标签", "tag", service.RankByTags(filteredRecords)),
            new RankGroup("函数排行", "每条对话按各函数字节占比分摊（可多选并存）", "函数", "func", service.RankByFunctions(filteredRecords)),
        ];
    }

    /// <summary>点表头：同一列再点一次反向，换列时数值默认倒序、名称默认正序。</summary>
    void OnRankSort(RankSortColumn column)
    {
        if (rankSort == column)
        {
            rankSortDesc = !rankSortDesc;
            return;
        }

        rankSort = column;
        rankSortDesc = column != RankSortColumn.Name;
    }

    string SortArrow(RankSortColumn column)
        => rankSort == column ? (rankSortDesc ? " ▼" : " ▲") : "";

    string SortHeaderStyle(RankSortColumn column)
        => rankSort == column
            ? "padding:0; height:auto; font-weight:600; color:#1677ff;"
            : "padding:0; height:auto; color:rgba(0,0,0,0.65);";

    static double SortValue(TokenStatisticsService.RankRow row, RankSortColumn column) => column switch
    {
        RankSortColumn.Count => row.ChatCount,
        RankSortColumn.Cached => row.CachedTokens,
        RankSortColumn.CachedCost => row.HitCost,
        RankSortColumn.Input => row.InputMissTokens,
        RankSortColumn.InputCost => row.MissCost,
        RankSortColumn.Output => row.OutputTokens,
        RankSortColumn.OutputCost => row.OutputCost,
        _ => row.Cost,
    };

    /// <summary>按当前排序列排好，并算出占比与累计（都基于排序列的合计）。</summary>
    List<RankRowView> RankRows(RankGroup group)
    {
        List<TokenStatisticsService.RankRow> rows = rankSort == RankSortColumn.Name
            ? (rankSortDesc
                ? [.. group.Rows.OrderByDescending(row => row.Name, StringComparer.Ordinal)]
                : [.. group.Rows.OrderBy(row => row.Name, StringComparer.Ordinal)])
            : (rankSortDesc
                ? [.. group.Rows.OrderByDescending(row => SortValue(row, rankSort)).ThenByDescending(row => row.ChatCount)]
                : [.. group.Rows.OrderBy(row => SortValue(row, rankSort)).ThenByDescending(row => row.ChatCount)]);

        double total = rankSort == RankSortColumn.Name
            ? rows.Sum(row => row.Cost)
            : rows.Sum(row => SortValue(row, rankSort));

        double cumulative = 0;
        List<RankRowView> list = new(rows.Count);
        for (int i = 0; i < rows.Count; i++)
        {
            double value = rankSort == RankSortColumn.Name ? rows[i].Cost : SortValue(rows[i], rankSort);
            double share = total > 0 ? value / total : 0;
            cumulative += share;
            list.Add(new RankRowView(rows[i], i + 1, share, cumulative));
        }
        return list;
    }

    /// <summary>前 12 行之外的汇总（保证"可见行之和 + 其余 = 总额"）。</summary>
    static TokenStatisticsService.RankRow SumRest(List<RankRowView> rest)
        => new(
            $"其余 {rest.Count} 项",
            rest.Sum(view => view.Row.ChatCount),
            rest.Sum(view => view.Row.CachedTokens),
            rest.Sum(view => view.Row.InputMissTokens),
            rest.Sum(view => view.Row.OutputTokens),
            rest.Sum(view => view.Row.HitCost),
            rest.Sum(view => view.Row.MissCost),
            rest.Sum(view => view.Row.OutputCost));

    /// <summary>
    /// 把一组权重换算成整数百分比，用"最大余数法"分配四舍五入的误差，
    /// 保证同一维度（标签 或 函数）内所有百分比相加正好 100%。
    /// </summary>
    static IReadOnlyList<(string Name, int Percent)> ChipShares(IReadOnlyList<TokenStatisticsService.WeightedName> weights)
    {
        if (weights.Count == 0)
            return [];

        double total = weights.Sum(item => item.Weight);
        if (total <= 0)
            return [.. weights.Select(item => (item.Name, 0))];

        double[] exact = [.. weights.Select(item => item.Weight / total * 100)];
        int[] percent = [.. exact.Select(value => (int)Math.Floor(value))];
        int remainder = 100 - percent.Sum();

        if (remainder > 0)
        {
            // 余数按小数部分从大到小分配（最多 100 个名额，够用）
            int[] order = [.. Enumerable.Range(0, exact.Length)
                .OrderByDescending(index => exact[index] - Math.Floor(exact[index]))];
            for (int i = 0; i < remainder && i < order.Length; i++)
                percent[order[i]]++;
        }
        else if (remainder < 0)
        {
            int[] order = [.. Enumerable.Range(0, exact.Length)
                .OrderBy(index => exact[index] - Math.Floor(exact[index]))];
            for (int i = 0; i < -remainder && i < order.Length && percent[order[i]] > 0; i++)
                percent[order[i]]--;
        }

        return [.. weights.Select((item, index) => (item.Name, percent[index]))];
    }

    /// <summary>
    /// 把「标签 + 函数 + 思考」合并成一行占比：全部按 UTF-8 字节数算，
    /// 排序后取整（最大余数法），保证同一张卡上这些百分比相加正好 100%。
    /// </summary>
    static IReadOnlyList<(string Name, int Percent, bool IsFunc)> MergedShares(
        IReadOnlyList<TokenStatisticsService.WeightedName> tags,
        IReadOnlyList<TokenStatisticsService.WeightedName> funcs)
    {
        List<(string Name, int Bytes, bool IsFunc)> items =
        [
            .. tags.Select(item => (item.Name, item.Bytes, false)),
            .. funcs.Select(item => (item.Name, item.Bytes, true)),
        ];

        int total = items.Sum(item => item.Bytes);
        if (total <= 0)
            return [.. items.Select(item => (item.Name, 0, item.IsFunc))];

        double[] exact = [.. items.Select(item => (double)item.Bytes / total * 100)];
        int[] percent = [.. exact.Select(value => (int)Math.Floor(value))];
        int remainder = 100 - percent.Sum();

        if (remainder > 0)
        {
            int[] order = [.. Enumerable.Range(0, exact.Length)
                .OrderByDescending(index => exact[index] - Math.Floor(exact[index]))];
            for (int i = 0; i < remainder && i < order.Length; i++)
                percent[order[i]]++;
        }
        else if (remainder < 0)
        {
            int[] order = [.. Enumerable.Range(0, exact.Length)
                .OrderBy(index => exact[index] - Math.Floor(exact[index]))];
            for (int i = 0; i < -remainder && i < order.Length && percent[order[i]] > 0; i++)
                percent[order[i]]--;
        }

        return [.. items
            .Select((item, index) => (item.Name, percent[index], item.IsFunc))
            .OrderByDescending(entry => entry.Item2)];
    }

    /// <summary>胶囊状态样式：蓝色=参与/已忽略，灰色划线=已排除/未忽略。</summary>
