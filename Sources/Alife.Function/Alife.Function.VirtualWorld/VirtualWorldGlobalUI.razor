@namespace Alife.Function.VirtualWorld
@using Alife.Framework
@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@attribute [SideBarItem]
@implements IAsyncDisposable
@inject ChatActivitySystem ChatActivitySystem
@inject StorageSystem StorageSystem
@inject IMessageService MessageService
@inject IJSRuntime JsRuntime

@* 这个组件自己就是侧栏按钮：点击在侧栏原地开合世界群聊抽屉，不占用任何宿主页面 *@
<Tooltip Title="世界群聊" Placement="Placement.Right">
    <div class="alife-rail-item @(visible ? "active" : "")" @onclick="@ToggleDrawer">
        <Icon Type="@IconType.Outline.Comment"/>
    </div>
</Tooltip>

<Drawer Visible="@visible"
    OnClose="@OnDrawerClose"
    Placement="@DrawerPlacement.Right"
    Title="@("世界群聊")"
    Width="560"
    BodyStyle="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
    <div class="vw-group-toolbar">
        <Flex Justify="@FlexJustify.SpaceBetween" Align="@FlexAlign.Center">
            <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 12px;">共 @(messages.Count) 条群聊消息</AntDesign.Text>
            <Button Icon="@IconType.Outline.Clear"
                    Type="@ButtonType.Link"
                    Danger
                    OnClick="@OnClear">清空</Button>
        </Flex>
    </div>
    <div class="vw-group-body" id="vwGroupBody">
        <div id="vwGroupMessageArea" class="vw-group-message-area">
        @if (messages.Count == 0)
        {
            <Empty Style="margin-top: 80px" Description="@("暂无群聊消息，发送一条吧！")"/>
        }
        else
        {
            @foreach (WorldGroupMessage message in messages)
            {
                <div class="vw-group-message-row @(message.FromUser ? "user" : "ai")">
                    <div class="vw-group-bubble @(message.FromUser ? "vw-group-bubble-user" : "vw-group-bubble-ai")">
                        <div class="vw-group-bubble-header">
                            <span class="vw-group-sender">@message.Sender</span>
                            <span class="vw-group-time">@message.Time.ToString("HH:mm")</span>
                        </div>
                        <div class="vw-group-content">@message.Content</div>
                    </div>
                </div>
            }
        }
        </div>
        <Button Class="vw-group-jump" Icon="@IconType.Outline.Down" OnClick="@ScrollToLatestAsync">回到最新消息</Button>
    </div>

    <div class="vw-group-input-bar">
        <Flex Align="@FlexAlign.Center" Gap="@("8")" Style="margin-bottom: 8px;">
            <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 12px;">消息前缀:</AntDesign.Text>
            <Input @bind-Value="GroupChatLog.MessagePrefix"
                   BindOnInput="true"
                   Size="@InputSize.Small"
                   Style="flex: 1; min-width: 0;"/>
        </Flex>
        <Flex Gap="@("12")" Align="@FlexAlign.Center">
            <TextArea
                      Id="vwGroupInput"
                      @bind-Value="inputText"
                      BindOnInput="true"
                      Style="flex: 1; min-width: 0;"
                      Placeholder="@("输入消息... (Enter 发送，Shift+Enter 换行)")"
                      Rows="3"/>
            <Button Type="@ButtonType.Primary"
                    Icon="@IconType.Outline.Send"
                    OnClick="@(() => SendAsync())">群发</Button>
        </Flex>
    </div>
</Drawer>

<style>
    .vw-group-toolbar {
        flex: 0 0 auto;
        padding: 6px 16px;
        background: var(--alife-bg-container);
        border-bottom: 1px solid var(--alife-border);
    }

    .vw-group-body {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
    }

    .vw-group-message-area {
        flex: 1 1 auto;
        min-width: 0;
        min-height: 0;
        overflow-y: auto;
        padding: 16px;
        background: var(--alife-bg-layout);
    }

    .vw-group-jump {
        position: absolute;
        right: 16px;
        bottom: 12px;
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .vw-group-body[data-at-bottom="false"] .vw-group-jump {
        opacity: 1;
        transform: none;
        pointer-events: auto;
    }

    .vw-group-message-row {
        display: flex;
        width: 100%;
        margin-bottom: 14px;
    }

    .vw-group-message-row.user {
        flex-direction: row-reverse;
    }

    .vw-group-message-row.ai {
        flex-direction: row;
    }

    .vw-group-bubble {
        max-width: 80%;
        padding: 8px 14px;
        border-radius: 12px;
        box-shadow: var(--alife-shadow-card);
    }

    .vw-group-bubble-user {
        background: var(--alife-bubble-user-bg);
        color: var(--alife-bubble-user-text);
        border-bottom-right-radius: 2px;
    }

    .vw-group-bubble-ai {
        background: var(--alife-bubble-ai-bg);
        border: 1px solid var(--alife-border);
        color: var(--alife-bubble-ai-text);
        border-bottom-left-radius: 2px;
    }

    .vw-group-bubble-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 4px;
        font-size: 12px;
        color: var(--alife-text-tertiary);
    }

    .vw-group-content {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-size: 15px;
        line-height: 1.6;
    }

    .vw-group-input-bar {
        flex: 0 0 auto;
        padding: 12px 16px;
        background: var(--alife-bg-container);
        border-top: 1px solid var(--alife-border);
    }

    .vw-group-input-bar textarea {
        resize: vertical;
    }
</style>

@code {
    /// <summary>群聊消息区元素 id，贴底跟随与“回到最新消息”都以它为键，与宿主的对话看板各管各的滚动。</summary>
    const string streamId = "vwGroupMessageArea";

    bool visible;
    bool scrollPending;
    string inputText = "";
    List<WorldGroupMessage> messages = [];
    readonly List<(string Full, string Clean, DateTime Time)> ownPending = [];
    DotNetObjectReference<VirtualWorldGlobalUI>? dotNetRef;
    IJSObjectReference? chatModule;
    bool isInputBound;

    protected override void OnInitialized()
    {
        GroupChatLog.Initialize(StorageSystem);
        messages = GroupChatLog.GetAll();
        VirtualWorldService.BroadcastSent += OnBroadcastSent;
        dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (visible == false)
            return;

        // 抽屉内容首次打开才进 DOM，贴底跟随与回车发送都交给共用的聊天行为模块
        IJSObjectReference module = chatModule ??= await JsRuntime
            .InvokeAsync<IJSObjectReference>("import", "./_content/Alife.Client/alife-chat.js").AsTask();
        await module.InvokeVoidAsync("setupStream", "vwGroupBody", streamId);

        if (isInputBound == false)
        {
            isInputBound = true;
            await module.InvokeVoidAsync("setupEnter", "vwGroupInput", dotNetRef);
        }

        if (scrollPending == false)
            return;

        scrollPending = false;
        await module.InvokeVoidAsync("scrollToLatest", streamId);
    }

    void ToggleDrawer()
    {
        visible = !visible;
        if (visible)
            scrollPending = true;
    }

    // 抽屉自己关闭时不会触发本组件重渲染，侧栏入口的高亮要在这里主动同步
    void OnDrawerClose()
    {
        visible = false;
        StateHasChanged();
    }

    void OnClear()
    {
        GroupChatLog.Clear();
        lock (ownPending)
            ownPending.Clear();
        messages = GroupChatLog.GetAll();
        StateHasChanged();
    }

    void OnBroadcastSent(string broadcastText)
    {
        _ = InvokeAsync(() => {
            string sender = "";
            string content = broadcastText;
            bool fromUser = false;
            lock (ownPending)
            {
                int index = ownPending.FindIndex(entry => entry.Full == broadcastText && (DateTime.Now - entry.Time).TotalSeconds < 10);
                if (index >= 0)
                {
                    (sender, _) = ParseBroadcastText(broadcastText);
                    content = ownPending[index].Clean;
                    fromUser = true;
                    ownPending.RemoveAt(index);
                }
                else
                {
                    (sender, content) = ParseBroadcastText(broadcastText);
                }
                ownPending.RemoveAll(entry => (DateTime.Now - entry.Time).TotalSeconds >= 10);
            }
            GroupChatLog.Add(sender, content, fromUser);
            messages = GroupChatLog.GetAll();
            StateHasChanged();
        });
    }

    /// <summary>聊天行为模块在抽屉第一次打开时导入，能触发发送与回底的界面都在那之后才存在。</summary>
    IJSObjectReference ChatModule => chatModule ?? throw new InvalidOperationException("聊天行为模块尚未加载");

    static (string Sender, string Content) ParseBroadcastText(string broadcastText)
    {
        const string head = "[来自";
        const string tail = "的广播消息]";
        if (broadcastText.StartsWith(head))
        {
            int end = broadcastText.IndexOf(tail, head.Length, StringComparison.Ordinal);
            if (end > head.Length)
                return (broadcastText.Substring(head.Length, end - head.Length), broadcastText.Substring(end + tail.Length));
        }
        return ("", broadcastText);
    }

    [JSInvokable]
    public Task OnEnterAsync(string domInputText) => SendAsync(domInputText);

    async Task SendAsync(string? domInputText = null)
    {
        string text = (domInputText ?? inputText).Trim();
        if (text.Length == 0)
            return;

        Character[] targets = ChatActivitySystem.GetAllChatActivities()
            .Select(activity => activity.Character)
            .Where(character => character.Modules.Contains(ModuleSystem.GetModuleId(typeof(VirtualWorldService))))
            .ToArray();
        if (targets.Length == 0)
        {
            await MessageService.WarningAsync("当前没有其他在线角色接收群发消息");
            return;
        }

        // 确认发得出去才清空：模型与 DOM 一起清，不重建输入框组件
        inputText = "";
        await ChatModule.InvokeVoidAsync("clearInput", "vwGroupInput");

        string fullText = GroupChatLog.MessagePrefix + text;
        lock (ownPending)
            ownPending.Add((fullText, text, DateTime.Now));
        try
        {
            VirtualWorldService.BroadcastMessage(fullText, targets, ChatActivitySystem);
        }
        catch (Exception e)
        {
            await MessageService.ErrorAsync($"发送失败：{e.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    Task ScrollToLatestAsync() => ChatModule.InvokeVoidAsync("scrollToLatest", streamId).AsTask();
    public async ValueTask DisposeAsync()
    {
        VirtualWorldService.BroadcastSent -= OnBroadcastSent;
        dotNetRef?.Dispose();
        dotNetRef = null;

        if (chatModule != null)
            await chatModule.DisposeAsync();
    }
}
