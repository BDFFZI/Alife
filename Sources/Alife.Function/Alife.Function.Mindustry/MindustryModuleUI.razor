@namespace Alife.Function.Mindustry
@inherits Alife.Framework.ModuleUIBase<MindustryModule, MindustryConfig>
@implements IDisposable
@inject Alife.Framework.PluginSystem PluginSystem
@inject Alife.Framework.IAlifeApplication AlifeApplication
@inject Alife.Framework.ConfigurationSystem ConfigurationSystem
@inject IMessageService MessageService
@using System
@using System.Diagnostics
@using System.IO
@using System.Threading
@using System.Threading.Tasks
@using AntDesign

<style>
    .md-install-shell {
        display: grid;
        gap: 16px;
        min-width: 0;
        max-width: 100%;
        container-type: inline-size;
    }

    .md-install-shell > * {
        min-width: 0;
    }

    .md-install-hero {
        padding: 18px 20px;
        border: 1px solid var(--alife-border);
        border-radius: var(--alife-radius);
        background: var(--alife-bg-container);
    }

    .md-install-title {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 650;
    }

    .md-install-copy {
        color: var(--alife-text-secondary);
        line-height: 1.65;
        overflow-wrap: anywhere;
    }

    .md-install-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
    }

    .md-install-wait {
        color: var(--alife-text-secondary);
        line-height: 1.6;
    }

    .md-install-more {
        margin-top: 12px;
        color: var(--alife-text-secondary);
        font-size: 12px;
    }

    .md-install-more summary,
    .md-install-advanced summary {
        width: fit-content;
        cursor: pointer;
        color: var(--alife-text-secondary);
    }

    .md-install-more-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 12px;
        margin-top: 8px;
    }

    .md-install-advanced {
        border: 1px solid var(--alife-border);
        border-radius: var(--alife-radius);
        background: var(--alife-bg-container);
    }

    .md-install-advanced summary {
        padding: 14px 16px;
        color: var(--alife-text);
    }

    .md-install-advanced-body {
        display: grid;
        gap: 16px;
        padding: 0 16px 16px;
    }

    .md-install-status {
        margin-top: 12px;
    }

    .md-install-state {
        display: grid;
        gap: 8px;
        padding: 14px 16px;
        border-radius: var(--alife-radius);
        background: var(--alife-bg-subtle);
        border: 1px solid var(--alife-border);
    }

    .md-install-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-width: 0;
    }

    .md-install-path {
        min-width: 0;
        color: var(--alife-text-tertiary);
        font-family: monospace;
        font-size: 11px;
        overflow-wrap: anywhere;
    }

    .md-install-shell .ant-alert,
    .md-install-shell .ant-alert-content {
        min-width: 0;
    }

    .md-install-form-title {
        margin: 0 0 12px;
        font-size: 14px;
        font-weight: 600;
    }

    @@container (max-width: 320px) {
        .md-install-hero {
            padding: 14px;
        }

        .md-install-state {
            padding: 12px;
        }

        .md-install-title {
            font-size: 16px;
        }

        .md-install-copy {
            font-size: 13px;
            line-height: 1.5;
        }

        .md-install-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 4px;
        }

        .md-install-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .md-install-actions .ant-btn {
            width: 100%;
        }

        .md-install-advanced-body {
            padding: 0 12px 12px;
        }
    }
</style>

<div class="md-install-shell">
    <div class="md-install-hero">
        <div class="md-install-title">开始 Mindustry 陪玩</div>
        <div class="md-install-copy">
            选择游戏目录，安装一次 Mod，然后启动游戏。进入地图后会自动连接。
        </div>
        <div class="md-install-actions">
            @if (status.GameExecutableFound == false)
            {
                <Button Type="@ButtonType.Primary" Loading="@isChoosingGameDirectory" OnClick="ChooseGameFolderAsync">
                    选择游戏根目录
                </Button>
            }
            else if (status.Installed == false)
            {
                <Button Type="@ButtonType.Primary" Loading="@isInstalling" OnClick="InstallBridgeAsync">
                    @(status.ModInstalled ? "更新 Mod" : "安装 Mod")
                </Button>
            }
            else if (status.GameRunning == false)
            {
                <Button Type="@ButtonType.Primary" Loading="@isLaunching" OnClick="LaunchGameAsync">
                    启动并连接
                </Button>
            }
            else if (status.BridgeListening == false)
            {
                <Button Type="@ButtonType.Primary" Loading="@isLaunching" OnClick="RestartGameAsync">
                    重启并连接
                </Button>
            }
            else if (status.InGame == false)
            {
                <div class="md-install-wait">游戏已连接，进入一张地图后会自动识别。</div>
            }
        </div>
        <div class="md-install-status">
            <Alert Type="@StatusType" ShowIcon="true" Message="@status.Message"/>
        </div>
        <details class="md-install-more">
            <summary>其他操作</summary>
            <div class="md-install-more-actions">
                <Button Type="@ButtonType.Link" Loading="@isChoosingGameDirectory" OnClick="ChooseGameFolderAsync">
                    更换游戏目录
                </Button>
                @if (status.ModInstalled)
                {
                    <Button Type="@ButtonType.Link" Loading="@isInstalling" OnClick="InstallBridgeAsync">
                        重新安装 Mod
                    </Button>
                }
                <Button Type="@ButtonType.Link" OnClick="OpenModFolderAsync">打开 Mod 目录</Button>
            </div>
        </details>
    </div>

    <details class="md-install-advanced">
        <summary>连接详情与高级设置</summary>
        <div class="md-install-advanced-body">
            <div class="md-install-state">
                <div class="md-install-row">
                    <Text>游戏目录</Text>
                    <Tag Color="@(status.GameExecutableFound ? TagColor.Green : TagColor.Error)">
                        @(status.GameExecutableFound ? "已找到" : "未找到")
                    </Tag>
                </div>
                <div class="md-install-row">
                    <Text>游戏进程</Text>
                    <Tag Color="@(status.GameRunning ? TagColor.Green : TagColor.Default)">
                        @(status.GameRunning ? "运行中" : "未启动")
                    </Tag>
                </div>
                <div class="md-install-row">
                    <Text>桥接 Mod</Text>
                    <Tag Color="@(!status.ModInstalled ? TagColor.Error : status.ModCurrent ? TagColor.Green : TagColor.Gold)">
                        @(!status.ModInstalled ? "未安装" : status.ModCurrent ? "已安装" : "需要更新")
                    </Tag>
                </div>
                <div class="md-install-row">
                    <Text>配置</Text>
                    <Tag Color="@(status.ConfigReady ? TagColor.Green : TagColor.Default)">
                        @(status.ConfigReady ? "已同步" : "待同步")
                    </Tag>
                </div>
                <div class="md-install-row">
                    <Text>游戏连接</Text>
                    <Tag Color="@(status.Authorized ? TagColor.Green : status.BridgeListening ? TagColor.Gold : TagColor.Default)">
                        @(status.Authorized ? "已连接" : status.BridgeListening ? "等待授权" : "未连接")
                    </Tag>
                </div>
                <div class="md-install-row">
                    <Text>房间状态</Text>
                    <Tag Color="@(status.InGame ? TagColor.Green : TagColor.Default)">
                        @(status.InGame ? "已进入地图" : "等待进入地图")
                    </Tag>
                </div>
                @if (status.GameExecutableFound)
                {
                    <div class="md-install-path">游戏位置：@status.GameDirectory</div>
                }
                <div class="md-install-path">Mod 数据位置：@status.DataDirectory</div>
            </div>

            <div>
                <div class="md-install-form-title">连接设置</div>
                <Form TModel="MindustryConfig" Model="@Configuration" Layout="@FormLayout.Vertical">
                    <FormItem Label="游戏根目录">
                        <Input @bind-Value="@Configuration.GameDirectory" Placeholder="D:\Mindustry"/>
                        <Text Type="TextElementType.Secondary" Style="font-size: 11px;">
                            选择包含 Mindustry.exe 的文件夹。模块会自动识别游戏实际使用的 Mod 数据目录。
                        </Text>
                    </FormItem>
                    <FormItem Label="Mod 数据目录">
                        <Input @bind-Value="@Configuration.DataDirectory" Placeholder="安装后自动识别"/>
                        <Text Type="TextElementType.Secondary" Style="font-size: 11px;">
                            启动过的正式版通常使用 %APPDATA%\Mindustry；检测到的实际位置会显示在上方。
                        </Text>
                    </FormItem>
                    <FormItem Label="桥接端口">
                        <InputNumber @bind-Value="@Configuration.Port" Min="1" Max="65535" Style="width: 100%; max-width: 180px;"/>
                    </FormItem>
                    <FormItem Label="AI 队伍编号">
                        <InputNumber @bind-Value="@Configuration.TeamId" Min="0" Max="255" Style="width: 100%; max-width: 180px;"/>
                        <Text Type="TextElementType.Secondary" Style="font-size: 11px;">
                            0 表示和玩家同队。想在另一支有核心的队伍独立经营时填该队伍编号，例如 Passage 的 2。
                        </Text>
                    </FormItem>
                    <FormItem Label="访问令牌">
                        <InputPassword @bind-Value="@Configuration.Token" Placeholder="安装后自动生成"/>
                    </FormItem>
                </Form>
            </div>
        </div>
    </details>
</div>

@code {
    MindustryBridgeInstallation installation = null!;
    MindustryBridgeState status = new(
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        "正在检查 Mindustry 安装状态。",
        "",
        "",
        "");
    CancellationTokenSource? monitorCancellation;
    bool isInstalling;
    bool isLaunching;
    bool isChoosingGameDirectory;

    AlertType StatusType =>
        status.GameExecutableFound == false ? AlertType.Error :
        status.Authorized && status.Installed ? AlertType.Success :
        status.ModInstalled && status.ModCurrent == false ? AlertType.Warning :
        status.Installed ? AlertType.Info :
        status.DataDirectoryExists ? AlertType.Warning :
        AlertType.Error;

    protected override void OnParametersSet()
    {
        if (installation != null)
            return;

        string pluginId = PluginSystem.PluginContext.GetTypeAttachedPlugin(typeof(MindustryModule))
            ?? "Alife.Function.Mindustry";
        string pluginDirectory = PluginSystem.PluginContext.GetPluginDirectoryPath(pluginId);
        installation = new(pluginDirectory);
        monitorCancellation = new();
        _ = MonitorAsync(monitorCancellation.Token);
    }

    async Task InstallBridgeAsync()
    {
        isInstalling = true;
        StateHasChanged();
        try
        {
            status = await installation.InstallAsync(Configuration, monitorCancellation?.Token ?? CancellationToken.None);
            if (status.Installed)
            {
                SaveConfiguration();
                _ = MessageService.SuccessAsync("Mod 安装完成。下一步启动游戏，进入地图后会自动连接。");
            }
            else
                _ = MessageService.WarningAsync(status.Message);
            StateHasChanged();
        }
        catch (Exception exception)
        {
            _ = MessageService.ErrorAsync($"安装失败：{exception}");
        }
        finally
        {
            isInstalling = false;
            StateHasChanged();
        }
    }

    async Task ChooseGameFolderAsync()
    {
        if (isChoosingGameDirectory)
            return;

        isChoosingGameDirectory = true;
        StateHasChanged();
        try
        {
            string? selectedDirectory = await AlifeApplication.SelectFolderAsync();
            if (string.IsNullOrWhiteSpace(selectedDirectory))
                return;

            string gameDirectory = Path.GetFullPath(selectedDirectory);
            if (installation.IsGameDirectory(gameDirectory) == false)
            {
                _ = MessageService.WarningAsync("选择的文件夹里没有 Mindustry.exe。请选择解压后的游戏根目录。");
                return;
            }

            Configuration.GameDirectory = gameDirectory;
            Configuration.DataDirectory = installation.SuggestedDataDirectory(gameDirectory);
            SaveConfiguration();
            status = await installation.InspectAsync(Configuration, monitorCancellation?.Token ?? CancellationToken.None);
            _ = MessageService.SuccessAsync(status.ModInstalled
                ? "已识别游戏目录。可以启动游戏。"
                : "已识别游戏目录。下一步安装 Mod。");
        }
        catch (Exception exception)
        {
            _ = MessageService.ErrorAsync($"选择游戏目录失败：{exception}");
        }
        finally
        {
            isChoosingGameDirectory = false;
            StateHasChanged();
        }
    }

    async Task LaunchGameAsync()
    {
        if (isLaunching)
            return;

        if (status.GameExecutableFound == false)
        {
            _ = MessageService.WarningAsync("请先选择 Mindustry 游戏根目录。");
            return;
        }
        if (status.GameRunning)
        {
            _ = MessageService.WarningAsync("Mindustry 已经在运行，请直接进入地图。");
            return;
        }

        isLaunching = true;
        StateHasChanged();
        try
        {
            Process.Start(new ProcessStartInfo(status.GameExecutablePath)
            {
                WorkingDirectory = status.GameDirectory,
                UseShellExecute = true
            });
            _ = MessageService.SuccessAsync("Mindustry 已启动。进入地图后会自动连接。");
        }
        catch (Exception exception)
        {
            _ = MessageService.ErrorAsync($"启动 Mindustry 失败：{exception}");
        }
        finally
        {
            isLaunching = false;
            StateHasChanged();
        }
    }

    async Task RestartGameAsync()
    {
        if (isLaunching)
            return;

        isLaunching = true;
        StateHasChanged();
        try
        {
            Process[] processes = Process.GetProcessesByName(Path.GetFileNameWithoutExtension(status.GameExecutablePath));
            try
            {
                foreach (Process process in processes)
                    process.CloseMainWindow();

                for (int attempt = 0; attempt < 40 && processes.Any(process => process.HasExited == false); attempt++)
                    await Task.Delay(250);

                if (processes.Any(process => process.HasExited == false))
                {
                    _ = MessageService.WarningAsync("Mindustry 没有正常退出。请先保存并关闭游戏，再点击“启动并连接”。");
                    return;
                }
            }
            finally
            {
                foreach (Process process in processes)
                    process.Dispose();
            }

            Process.Start(new ProcessStartInfo(status.GameExecutablePath)
            {
                WorkingDirectory = status.GameDirectory,
                UseShellExecute = true
            });
            _ = MessageService.SuccessAsync("Mindustry 已重新启动。进入地图后会自动连接。");
        }
        catch (Exception exception)
        {
            _ = MessageService.ErrorAsync($"重启 Mindustry 失败：{exception}");
        }
        finally
        {
            isLaunching = false;
            StateHasChanged();
        }
    }

    async Task MonitorAsync(CancellationToken cancellationToken)
    {
        await Task.Delay(500, cancellationToken);
        while (cancellationToken.IsCancellationRequested == false)
        {
            try
            {
                MindustryBridgeState next = await installation.InspectAsync(Configuration, cancellationToken);
                await InvokeAsync(() => {
                    if (cancellationToken.IsCancellationRequested == false)
                    {
                        status = next;
                        if (string.IsNullOrWhiteSpace(Configuration.GameDirectory) && next.GameExecutableFound)
                            Configuration.GameDirectory = next.GameDirectory;
                        StateHasChanged();
                    }
                });
                await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }
    }

    Task OpenModFolderAsync()
    {
        string dataDirectory = installation.ResolveDataDirectory(Configuration.DataDirectory);
        string modsDirectory = Path.Combine(dataDirectory, "mods");
        return AlifeApplication.RevealFolderAsync(Directory.Exists(modsDirectory) ? modsDirectory : dataDirectory);
    }

    void SaveConfiguration()
    {
        ConfigurationSystem.SetConfiguration(
            typeof(MindustryModule),
            Configuration,
            Character?.StorageKey ?? "");
        if (Module != null)
            Module.Configuration = Configuration;
    }

    public void Dispose()
    {
        monitorCancellation?.Cancel();
        monitorCancellation?.Dispose();
    }
}
