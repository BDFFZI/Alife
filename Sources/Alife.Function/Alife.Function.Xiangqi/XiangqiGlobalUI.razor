        position: absolute;
        left: 50%;
        top: 50%;
        width: 1.3em;
        height: 1.3em;
        border: 2px solid var(--xq-gold-bright);
        border-radius: 50%;
        box-shadow: 0 0 18px rgba(255, 224, 138, .65), inset 0 0 12px rgba(255, 224, 138, .2);
        transform: translate(-50%, -50%) translateZ(3px);
        pointer-events: none;
        animation: xq-pulse 1.2s ease-in-out infinite;
