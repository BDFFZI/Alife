    .xq-corner.tr {
        right: -16px;
        top: -16px;
        border-left: 0;
        border-bottom: 0;
        border-radius: 0 8px 0 0;
    }

    .xq-corner.bl {
        left: -16px;
        bottom: -16px;
        border-right: 0;
        border-top: 0;
        border-radius: 0 0 0 8px;
    }

    .xq-corner.br {
        right: -16px;
        bottom: -16px;
        border-left: 0;
        border-top: 0;
        border-radius: 0 0 8px 0;
