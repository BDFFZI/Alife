        height: 1.18em;
        border: 1px dashed rgba(255, 224, 138, .55);
        border-radius: 50%;
        transform: translate(-50%, -50%) translateZ(2px);
        pointer-events: none;
        animation: xq-last 1.5s ease-in-out infinite;
