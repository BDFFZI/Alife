@namespace Alife.Function.Xiangqi
@using Alife.Framework
@using Alife.Function.TableGame
@using System.IO
@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@attribute [TableGame("中国象棋", "楚河汉界 · 人机对弈", typeof(XiangqiGameIcon), 20)]
@inherits TableGameUI
@implements IAsyncDisposable
@inject ChatActivitySystem ChatActivitySystem
@inject IMessageService MessageService
@inject PluginSystem PluginSystem
@inject IJSRuntime JsRuntime

@if (Opened)
{
    <div class="xq-stage">
        <div class="xq-sky"></div>
        <div class="xq-moon"></div>
        <svg class="xq-mountains" viewBox="0 0 1200 320" preserveAspectRatio="none" aria-hidden="true">
            <path class="xq-mountain far" d="M0 250 L120 170 L210 215 L330 120 L430 200 L540 150 L650 230 L760 140 L880 210 L1010 150 L1120 220 L1200 180 L1200 320 L0 320 Z"/>
            <path class="xq-mountain near" d="M0 285 L90 235 L190 270 L300 205 L410 265 L520 220 L640 280 L760 225 L880 270 L990 215 L1100 275 L1200 240 L1200 320 L0 320 Z"/>
        </svg>
        <div class="xq-clouds" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="xq-lantern left" aria-hidden="true"><span class="xq-lantern-cap"></span><span class="xq-lantern-body"></span><span class="xq-lantern-tassel"></span></div>
        <div class="xq-lantern right" aria-hidden="true"><span class="xq-lantern-cap"></span><span class="xq-lantern-body"></span><span class="xq-lantern-tassel"></span></div>
        <div class="xq-dust" aria-hidden="true">
            @for (int i = 0; i < 22; i++)
            {
                <span style="@($"left:{i * 41 % 100}%;animation-duration:{7 + i % 6}s;animation-delay:-{i * 0.6:0.0}s;width:{2 + i % 3}px;height:{2 + i % 3}px;")"></span>
            }
        </div>
        <div class="xq-glow"></div>
        <header class="xq-topbar">
            <div class="xq-brand">
                <span class="xq-brand-mark">象</span>
                <span class="xq-brand-text">中国象棋<small>CHINESE CHESS</small></span>
                @if (table.IsPlaying)
                {
                    <span class="xq-status">@StatusText</span>
                }
            </div>
            <div class="xq-actions">
                @if (table.IsPlaying && table.IsPaused && table.IsOver == false)
                {
                    <button class="xq-btn primary" @onclick="@(() => table.Resume())">继续</button>
                }
                @if (table.IsPlaying && table.IsOver)
                {
                    <button class="xq-btn primary" @onclick="@(() => table.Start(table.Seats))">再来一局</button>
                }
                @if (table.IsPlaying)
                {
                    <button class="xq-btn ghost xq-music" @onclick="ToggleMusic" aria-pressed="@(musicEnabled ? "true" : "false")"
                            aria-label="@(musicEnabled ? "关闭背景音乐" : "开启背景音乐")">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 9h4l4-4v14l-4-4H4z"/>
                            <path d="@(musicEnabled ? "M16 8.5a5 5 0 0 1 0 7M18.5 6a8 8 0 0 1 0 12" : "M17 9l4 6M21 9l-4 6")"/>
                        </svg>
                        <span>@(musicEnabled ? "音乐开" : "音乐关")</span>
                    </button>
                    @if (table.IsOver == false && HumanIndex >= 0)
                    {
                        <button class="xq-btn danger" @onclick="Surrender">投降</button>
                    }
                    <button class="xq-btn danger" @onclick="@(() => table.Stop())">结束对局</button>
                }
                <button class="xq-btn ghost" @onclick="@CloseFullscreen">退出全屏</button>
            </div>
        </header>

        @if (openingNotice != null && table.IsOver == false)
        {
            <div class="xq-opening">
                <span class="xq-opening-seal">先</span>
                <span class="xq-opening-text">@openingNotice</span>
            </div>
        }

        @if (table.IsPlaying)
        {
            <div class="xq-content">
                <section class="xq-board-area">
                    <div class="xq-table">
                        <div class="xq-board-shadow"></div>
                        <div class="xq-board-wrap">
                            <div class="xq-board-3d">
                                <div class="xq-board-rim"></div>
                                <div class="xq-board-top">
                                    <svg class="xq-grid" viewBox="0 0 @BoardWidth @BoardHeight" aria-hidden="true">
                                        <rect x="@Padding" y="@Padding" width="@(BoardWidth - Padding * 2)" height="@(BoardHeight - Padding * 2)" class="xq-grid-border"/>
                                        @for (int rank = 0; rank < XiangqiBoard.RankCount; rank++)
                                        {
                                            <line x1="@X(0)" y1="@Y(rank)" x2="@X(XiangqiBoard.FileCount - 1)" y2="@Y(rank)" class="xq-grid-line"/>
                                        }
                                        @for (int file = 0; file < XiangqiBoard.FileCount; file++)
                                        {
                                            @if (file == 0 || file == XiangqiBoard.FileCount - 1)
                                            {
                                                <line x1="@X(file)" y1="@Y(0)" x2="@X(file)" y2="@Y(XiangqiBoard.RankCount - 1)" class="xq-grid-line"/>
                                            }
                                            else
                                            {
                                                <line x1="@X(file)" y1="@Y(0)" x2="@X(file)" y2="@Y(4)" class="xq-grid-line"/>
                                                <line x1="@X(file)" y1="@Y(5)" x2="@X(file)" y2="@Y(XiangqiBoard.RankCount - 1)" class="xq-grid-line"/>
                                            }
                                        }
                                        <line x1="@X(3)" y1="@Y(0)" x2="@X(5)" y2="@Y(2)" class="xq-grid-line"/>
                                        <line x1="@X(5)" y1="@Y(0)" x2="@X(3)" y2="@Y(2)" class="xq-grid-line"/>
                                        <line x1="@X(3)" y1="@Y(7)" x2="@X(5)" y2="@Y(9)" class="xq-grid-line"/>
                                        <line x1="@X(5)" y1="@Y(7)" x2="@X(3)" y2="@Y(9)" class="xq-grid-line"/>
                                        @foreach ((int File, int Rank) mark in new[] { (1, 2), (7, 2), (1, 7), (7, 7), (0, 3), (2, 3), (4, 3), (6, 3), (8, 3), (0, 6), (2, 6), (4, 6), (6, 6), (8, 6) })
                                        {
                                            <path class="xq-grid-mark" d="@CrossPath(mark.File, mark.Rank)"/>
                                        }
                                        @SvgText(X(4), Y(4) - Cell / 2, "xq-river", "楚 河　　　汉 界")
                                    </svg>
                                    <div class="xq-river-shimmer"></div>
                                    @for (int file = 0; file < XiangqiBoard.FileCount; file++)
                                    {
                                        int pointFile = file;
                                        @for (int rank = 0; rank < XiangqiBoard.RankCount; rank++)
                                        {
                                            int pointRank = rank;
                                            <div class="xq-point3d @(IsSelected(pointFile, pointRank) ? "selected" : "")" data-file="@pointFile" data-rank="@pointRank" style="left:@(Left(pointFile))%;top:@(Top(pointRank))%" @onclick="@(() => OnPointClick(pointFile, pointRank))">
                                                <span class="xq-hit3d"></span>
                                                @if (IsLastMovePoint(pointFile, pointRank))
                                                {
                                                    <span class="xq-last3d"></span>
                                                }
                                                @if (IsCapturePoint(pointFile, pointRank))
                                                {
                                                    <span class="xq-capture3d"></span>
                                                }
                                                @if (IsSelected(pointFile, pointRank))
                                                {
                                                    <span class="xq-selected3d"></span>
                                                }
                                                @if (selected is { } origin && table.LegalMoves.Contains(new XiangqiMove(origin.File, origin.Rank, pointFile, pointRank)))
                                                {
                                                    <span class="xq-target3d"></span>
                                                }
                                                @if (table.Board.PieceAt(pointFile, pointRank) is { } piece)
                                                {
                                                    <div class="xq-piece3d @PieceClass(piece) @(IsCheckedGeneral(pointFile, pointRank) ? "check" : "")">
                                                        <span class="xq-piece-shadow"></span>
                                                        <span class="xq-piece-rim"></span>
                                                        <span class="xq-piece-face"><span class="xq-piece-char">@XiangqiBoard.Name(piece)</span></span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                                <span class="xq-corner tl"></span>
                                <span class="xq-corner tr"></span>
                                <span class="xq-corner bl"></span>
                                <span class="xq-corner br"></span>
                            </div>
                        </div>
                        <div class="xq-incense" aria-hidden="true">
                            <span class="xq-incense-smoke"></span>
                            <span class="xq-incense-smoke second"></span>
                            <span class="xq-incense-bowl"></span>
                        </div>
                    </div>
                </section>

                <aside class="xq-panel">
                    <div class="xq-seats">
                        @for (int index = 0; index < table.Seats.Count; index++)
                        {
                            TableSeat seat = table.Seats[index];
                            <div class="xq-seat @(table.TurnSeat == seat ? "turn" : "")">
                                <span class="xq-seat-dot @(index == 0 ? "red" : "black")"></span>
                                <span class="xq-seat-name">@seat.Name</span>
                                <span class="xq-seat-meta">@XiangqiTable.SideName(index == 0 ? XiangqiSide.Red : XiangqiSide.Black)</span>
                            </div>
                        }
                    </div>
                    <div class="xq-hint">@HintText</div>
                    <div class="xq-log-title"><span class="xq-seal">谱</span>棋谱</div>
                    <div class="xq-log">
                        @if (table.Log.Count == 0)
                        {
                            <div class="xq-log-empty">静候落子…</div>
                        }
                        @foreach (string line in table.Log)
                        {
                            <div>@line</div>
                        }
                    </div>
                </aside>
            </div>

            @if (table.IsOver)
            {
                <div class="xq-result">
                    <div class="xq-result-burst"></div>
                    <div class="xq-result-card">
                        @for (int i = 0; i < 16; i++)
                        {
                            <span class="xq-spark" style="@($"--a:{i * 22.5}deg;--d:{1.4 + i % 5 * 0.28:0.00}s;")"></span>
                        }
                        <div class="xq-result-kicker">@StatusText</div>
                        <div class="xq-result-seal">@ResultTitle</div>
                        <div class="xq-result-sub">@ResultSub</div>
                        <div class="xq-result-actions">
                            <button class="xq-btn primary" @onclick="@(() => table.Start(table.Seats))">再来一局</button>
                            <button class="xq-btn ghost" @onclick="@(() => table.Stop())">结束对局</button>
                        </div>
                    </div>
                </div>
            }

            @if (table.IsPaused && table.IsOver == false)
            {
                <div class="xq-pause">
                    <span>@table.TurnSeat?.Name 连续未能完成行动，对局已暂停。</span>
                    <button class="xq-btn primary" @onclick="@(() => table.Resume())">继续</button>
                </div>
            }
        }
        else
        {
            <div class="xq-setup">
                <div class="xq-setup-card">
                    <div class="xq-setup-kicker">ALIFE · TABLE GAME</div>
                    <h2 class="xq-setup-title">楚河 · 汉界</h2>
                    <p class="xq-setup-desc">选择红方和黑方的座位，开局随机决定先手。可以选你自己与一个角色对弈，也可以让两个角色自行对弈。</p>
                    @if (CandidateActivities.Count == 0)
                    {
                        <div class="xq-empty">没有启用“中国象棋”功能的角色。请在角色的功能检视中为它启用该模块。</div>
                    }
                    <div class="xq-setup-row">
                        <span class="xq-setup-label"><span class="xq-seat-dot red"></span>红方</span>
                        <Select TItem="string" TItemValue="string" @bind-Value="redKey" Placeholder="选择座位" Style="width: 100%;">
                            <SelectOption TItem="string" TItemValue="string" Value="@HumanKey" Label="我"/>
                            @for (int index = 0; index < CandidateActivities.Count; index++)
                            {
                                <SelectOption TItem="string" TItemValue="string" Value="@index.ToString()" Label="@CandidateActivities[index].Character.Name"/>
                            }
                        </Select>
                    </div>
                    <div class="xq-setup-row">
                        <span class="xq-setup-label"><span class="xq-seat-dot black"></span>黑方</span>
                        <Select TItem="string" TItemValue="string" @bind-Value="blackKey" Placeholder="选择座位" Style="width: 100%;">
                            <SelectOption TItem="string" TItemValue="string" Value="@HumanKey" Label="我"/>
                            @for (int index = 0; index < CandidateActivities.Count; index++)
                            {
                                <SelectOption TItem="string" TItemValue="string" Value="@index.ToString()" Label="@CandidateActivities[index].Character.Name"/>
                            }
                        </Select>
                    </div>
                    <button class="xq-btn primary xq-start" disabled="@(CanStart == false)" @onclick="@StartGame">开始对弈</button>
                    <div class="xq-setup-foot">落子无悔 · 方寸之间见山河</div>
                </div>
            </div>
        }
    </div>
}



<style>
    .xq-game-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
    }

    .xq-game-icon svg {
        width: 32px;
        height: 32px;
        filter: drop-shadow(0 0 6px rgba(217, 179, 108, .45));
        transition: filter .18s ease, transform .18s ease;
    }

    .game-center-item:hover .xq-game-icon svg,
    .game-center-item.active .xq-game-icon svg {
        filter: drop-shadow(0 0 9px rgba(236, 194, 110, .7));
        transform: scale(1.06);
    }

    .xq-game-disc {
        fill: #f7e6be;
        stroke: #d2a65b;
        stroke-width: 3;
    }

    .xq-game-inner {
        fill: none;
        stroke: #9e2f24;
        stroke-width: 2.4;
    }

    .xq-game-light {
        fill: #fff6dc;
        opacity: .4;
    }

    .xq-game-char {
        fill: #8d251d;
    }

    .xq-stage {
        --xq-gold: #d9b36c;
        --xq-gold-bright: #ffe3a3;
        --xq-red: #e5484d;
        position: fixed;
        inset: 0;
        z-index: 2147483000;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        color: #f3e9d2;
        background:
            radial-gradient(1100px 720px at 50% 18%, #26302c 0%, #141a18 42%, #0a0d0c 72%, #060707 100%);
        font-family: "Noto Serif SC", "Source Han Serif SC", "STKaiti", "KaiTi", serif;
        isolation: isolate;
    }

    .xq-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .xq-brand-mark {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        color: #1a120a;
        font-weight: 700;
    }

    .xq-brand-text {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: .08em;
    }

    .xq-status {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 13px;
        border: 1px solid rgba(217, 179, 108, .3);
        color: #e8cf9c;
    }

    .xq-opening {
        position: absolute;
        left: 50%;
        top: 92px;
        z-index: 6;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 22px 10px 14px;
        border-radius: 999px;
        background: linear-gradient(120deg, rgba(42, 29, 16, .95), rgba(20, 12, 8, .92));
        border: 1px solid rgba(217, 179, 108, .45);
        box-shadow: 0 14px 40px rgba(0, 0, 0, .55), 0 0 26px rgba(217, 179, 108, .16);
        pointer-events: none;
        animation: xq-opening-in .5s cubic-bezier(.18, .9, .24, 1) both;
        transform: translateX(-50%);
    }

    .xq-opening-seal {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: #a52a2a;
        color: #f3e9d2;
        font-size: 15px;
        box-shadow: 0 0 10px rgba(229, 72, 77, .4);
        transform: rotate(-4deg);
    }

    .xq-opening-text {
        font-size: 15px;
        letter-spacing: .06em;
        color: #ffe3a3;
        white-space: nowrap;
    }

    .xq-actions {
        display: flex;
        gap: 10px;
    }

    .xq-btn {
        padding: 7px 16px;
        border-radius: 999px;
        border: 1px solid rgba(217, 179, 108, .35);
        background: rgba(217, 179, 108, .08);
        color: #f3e9d2;
        font-size: 14px;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

    .xq-btn.xq-music {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .xq-music svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .xq-btn:hover {
        transform: translateY(-1px);
        background: rgba(217, 179, 108, .18);
        box-shadow: 0 6px 18px rgba(0, 0, 0, .35);
    }

    .xq-btn.primary {
        color: #1a120a;
        border-color: transparent;
        font-weight: 600;
    }

    .xq-btn.danger {
        border-color: rgba(229, 72, 77, .5);
        background: rgba(229, 72, 77, .12);
        color: #ffb3b5;
    }

    .xq-btn.ghost {
        background: transparent;
    }

    .xq-btn:disabled {
        opacity: .4;
        cursor: not-allowed;
        transform: none;
    }

    .xq-content {
        position: relative;
        flex: 1;
        min-height: 0;
        display: flex;
        gap: 22px;
        padding: 20px 24px;
    }

    .xq-board-area {
        flex: 1;
        min-width: 0;
        display: grid;
        place-items: center;
        padding: 8px;
    }

    .xq-seats {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .xq-seat {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(255, 255, 255, .03);
        border: 1px solid rgba(217, 179, 108, .15);
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .xq-seat.turn {
        border-color: rgba(255, 224, 138, .6);
        box-shadow: 0 0 0 2px rgba(255, 224, 138, .15), 0 0 20px rgba(217, 179, 108, .25);
    }

    .xq-seat-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex: 0 0 auto;
    }

    .xq-seat-dot.red {
        background: #e5484d;
        box-shadow: 0 0 8px rgba(229, 72, 77, .8);
    }

    .xq-seat-dot.black {
        background: #cbb98f;
        box-shadow: 0 0 8px rgba(203, 185, 143, .6);
    }

    .xq-seat-name {
        flex: 1;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .xq-seat-meta {
        font-size: 12px;
        color: rgba(243, 233, 210, .55);
    }

    .xq-hint {
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 13px;
        line-height: 1.6;
        color: #e8cf9c;
        background: rgba(217, 179, 108, .08);
        border: 1px solid rgba(217, 179, 108, .15);
    }

    .xq-log-title {
        font-size: 13px;
        font-weight: 600;
        color: rgba(243, 233, 210, .7);
    }

    .xq-log {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(0, 0, 0, .25);
        font-size: 12px;
        line-height: 1.8;
        color: rgba(243, 233, 210, .7);
    }

    .xq-pause {
        position: absolute;
        left: 50%;
        bottom: 28px;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 20px;
        border-radius: 999px;
        background: rgba(229, 72, 77, .15);
        border: 1px solid rgba(229, 72, 77, .45);
        color: #ffb3b5;
        backdrop-filter: blur(8px);
    }

    .xq-empty {
        padding: 10px 16px;
        border-radius: 10px;
        background: rgba(217, 179, 108, .1);
        border: 1px solid rgba(217, 179, 108, .25);
        color: #e8cf9c;
    }

    .xq-setup-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .xq-setup-label {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .xq-sky,
    .xq-moon,
    .xq-mountains,
    .xq-clouds,
    .xq-dust,
    .xq-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .xq-sky {
        z-index: 0;
        background:
            radial-gradient(ellipse at 72% 12%, rgba(255, 226, 170, .14), transparent 30%),
            radial-gradient(ellipse at 18% 78%, rgba(58, 154, 142, .10), transparent 42%),
            linear-gradient(180deg, rgba(8, 12, 12, .18), rgba(4, 6, 6, .72));
    }

    .xq-moon {
        inset: auto;
        top: 7%;
        right: 14%;
        width: clamp(100px, 14vw, 210px);
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle at 38% 34%, #fff8df 0%, #f0dca8 34%, rgba(201, 164, 94, .35) 62%, transparent 72%);
        box-shadow: 0 0 120px rgba(255, 224, 138, .22);
        filter: blur(2px);
        opacity: .42;
        z-index: 0;
        animation: xq-moon 14s ease-in-out infinite alternate;
    }

    .xq-mountains {
        inset: auto 0 0;
        width: 100%;
        height: 36%;
        z-index: 0;
        opacity: .9;
    }

    .xq-mountain.far {
        fill: rgba(17, 37, 35, .72);
    }

    .xq-mountain.near {
        fill: rgba(7, 17, 16, .92);
    }

    .xq-clouds {
        overflow: hidden;
        z-index: 0;
    }

    .xq-clouds span {
        position: absolute;
        display: block;
        width: 48vw;
        height: 10vw;
        border-radius: 50%;
        background: radial-gradient(ellipse, rgba(174, 210, 200, .12), transparent 70%);
        filter: blur(18px);
        animation: xq-cloud 36s ease-in-out infinite alternate;
    }

    .xq-clouds span:nth-child(1) {
        top: 16%;
        left: -12%;
    }

    .xq-clouds span:nth-child(2) {
        top: 34%;
        right: -16%;
        animation-delay: -12s;
    }

