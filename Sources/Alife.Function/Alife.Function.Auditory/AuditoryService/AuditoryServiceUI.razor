@namespace Alife.Function.Auditory
@using AntDesign
@using Alife.Framework
@using Microsoft.Extensions.Logging
@inherits ModuleUIBase<AuditoryService, AuditoryServiceConfig>
@implements IDisposable
@inject ILogger<AuditoryServiceUI> Logger

<div style="background: #fafafa; padding: 24px; border-radius: 12px; border: 1px solid #f0f0f0;">
    <Flex Direction="FlexDirection.Vertical" Gap="@("24")">
        <div>
            <Title Level="4" Style="margin-bottom: 16px;">听觉能力</Title>
        </div>

        <Flex Direction="FlexDirection.Vertical" Gap="@("16")">
            @if (Module != null)
            {
                <Flex Direction="FlexDirection.Vertical" Gap="@("4")">
                    <Flex Direction="FlexDirection.Horizontal" Align="@FlexAlign.Center" Gap="@("8")">
                        <Switch Checked="@Module.IsRunning"
                                CheckedChanged="@OnRealtimeToggleChanged"/>
                        <Text Strong>麦克风实时识别</Text>
                        @if (Module.IsRunning)
                        {
                            <Badge Status="BadgeStatus.Processing" Text="监听中"/>
                        }
                        else
                        {
                            <Badge Status="BadgeStatus.Default" Text="未启用"/>
                        }
                    </Flex>
                    <Text Type="TextElementType.Secondary" Style="font-size: 12px;">
                        关闭后不再监听麦克风。
                    </Text>
                </Flex>

                <Flex Direction="FlexDirection.Vertical" Gap="@("4")">
                    <Text Strong>麦克风按键说话</Text>
                    <Text Type="TextElementType.Secondary" Style="font-size: 12px;">
                        控制麦克风识别：选择一个按键，只有按住按键时才监听麦克风；留空则麦克风始终监听。
                    </Text>
                    <Flex Direction="FlexDirection.Horizontal" Align="@FlexAlign.Center" Gap="@("8")">
                        <Select TItemValue="string" TItem="string"
                                Style="width: 200px;"
                                @bind-Value="Configuration.PushToTalkKey"
                                Placeholder="麦克风始终监听（不设置）"
                                AllowClear>
                            @foreach (var key in pushToTalkKeys)
                            {
                                <SelectOption Value="@key" Label="@key"/>
                            }
                        </Select>
                        @if (Module.Configuration.PushToTalkKey == Configuration.PushToTalkKey && Configuration.PushToTalkKey != null)
                        {
                            @if (Module.IsRunning)
                            {
                                <Badge Status="BadgeStatus.Processing" Text="麦克风监听中"/>
                            }
                            else
                            {
                                <Badge Status="BadgeStatus.Default" Text="等待按键"/>
                            }
                        }
                    </Flex>
                </Flex>

                <Divider Style="margin: 0;"/>

                <Flex Direction="FlexDirection.Vertical" Gap="@("4")">
                    <Flex Direction="FlexDirection.Horizontal" Align="@FlexAlign.Center" Gap="@("8")">
                        <Switch Checked="@Module.IsListeningActive"
                                CheckedChanged="@OnSystemListeningChanged"/>
                        <Text Strong>监听系统声音</Text>
                        @if (Module.IsListeningActive)
                        {
                            <Badge Status="BadgeStatus.Processing" Text="监听中"/>
                        }
                        else
                        {
                            <Badge Status="BadgeStatus.Default" Text="未启用"/>
                        }
                    </Flex>
                    <Text Type="TextElementType.Secondary" Style="font-size: 12px;">
                        识别电脑正在播放的声音，并按推送间隔合并发送给 AI。
                    </Text>
                    @if (OperatingSystem.IsAndroid())
                    {
                        <span style="color: #d48806; font-size: 12px;">
                            Android 系统内录必须获得“录屏/投屏”授权，这是系统限制；Windows 不需要。
                        </span>
                    }
                </Flex>

                <Flex Direction="FlexDirection.Horizontal" Align="FlexAlign.Start" Gap="@("24")">
                    <div style="text-align: center; min-width: 130px;">
                        <Progress Type="ProgressType.Circle" Percent="@CountdownPercent" Width="96"
                                  StrokeColor="@("#1890ff")"
                                  Format="@((_) => FormatCountdown(Module.SecondsUntilNextPush))"/>
                        <Text Type="TextElementType.Secondary" Style="font-size: 12px;">下次推送倒计时</Text>
                    </div>

                    <div style="flex: 1; min-width: 0;">
                        <Card Size="CardSize.Small" Title="当前缓存内容（待推送）" Style="border-radius: 8px;">
                            @if (string.IsNullOrEmpty(Module.PendingPushText))
                            {
                                <span style="color: rgba(0,0,0,0.45); font-size: 13px;">暂无缓存内容</span>
                            }
                            else
                            {
                                <pre style="max-height: 220px; overflow: auto; background: #f8f8f8; padding: 12px; border-radius: 6px; font-size: 12px; line-height: 1.7; white-space: pre-wrap; word-break: break-all; margin: 0;">@Module.PendingPushText</pre>
                            }
                        </Card>
                    </div>
                </Flex>

                <Flex Direction="FlexDirection.Vertical" Gap="@("4")">
                    <Text Strong>推送间隔</Text>
                    <Text Type="TextElementType.Secondary" Style="font-size: 12px;">
                        系统声音识别结果先缓存，再按间隔和随机抖动合并推送，避免频繁打扰 AI。
                    </Text>
                    <Flex Direction="FlexDirection.Horizontal" Align="@FlexAlign.Center" Gap="@("8")">
                        <InputNumber @bind-Value="@Configuration.PushIntervalSeconds" Min="1" Step="1"
                                     Style="width: 140px;"/>
                        <Text Type="TextElementType.Secondary">秒 ±</Text>
                        <InputNumber @bind-Value="@Configuration.PushJitterSeconds" Min="0" Step="1"
                                     Style="width: 140px;"/>
                        <Text Type="TextElementType.Secondary">秒</Text>
                    </Flex>
                </Flex>

                <Divider Style="margin: 0;"/>

                <Flex Direction="FlexDirection.Vertical" Gap="@("4")">
                    <Text Strong>控制悬浮窗</Text>
                    <Text Type="TextElementType.Secondary" Style="font-size: 12px;">
                        悬浮窗随本模块显示；扬声器按钮控制系统声音，麦克风按钮控制麦克风。按下立即开始，单击切换开关，长按临时说话、松手关闭。位置异常时可重置。
                    </Text>
                    @if (OperatingSystem.IsAndroid())
                    {
                        <span style="font-size: 12px; color: rgba(0,0,0,0.45);">
                            Android 悬浮窗本身始终显示在应用上层。
                        </span>
                    }
                    else
                    {
                        <Flex Direction="FlexDirection.Horizontal" Align="@FlexAlign.Center" Gap="@("8")">
                            <Switch Checked="@Configuration.OverlayTopMost"
                                    CheckedChanged="@OnOverlayTopMostChanged"/>
                            <Text>窗口置顶</Text>
                        </Flex>
                    }
                    <div>
                        <Button OnClick="@ResetOverlayWindow">重置悬浮窗位置</Button>
                    </div>
                </Flex>
            }

            <Divider Style="margin: 0;"/>

            <Flex Direction="FlexDirection.Vertical" Gap="@("4")">
                <Text Strong>回复限定词</Text>
                <Text Type="TextElementType.Secondary" Style="font-size: 12px;">
                    AI回复语音识别消息时，必须包含这些词中的一个，否则会提示回复格式错误。多个标签用逗号分隔。
                </Text>
                <Input Value="@string.Join(",", Configuration.ReplyRestrictedWords)"
                       ValueChanged="@((string value) => OnOutputTagsChanged(value))"
                       Placeholder="&lt;speak&gt;"
                       Style="width: 300px;"/>
            </Flex>
        </Flex>
    </Flex>
</div>

@code {
    readonly string[] pushToTalkKeys = Enum.GetNames<ConsoleKey>();
    System.Timers.Timer? refreshTimer;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Module != null)
            Module.IsListeningChanged += OnIsListeningChanged;

        refreshTimer = new System.Timers.Timer(500);
        refreshTimer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        refreshTimer.Start();
    }

    int CountdownPercent
    {
        get
        {
            if (Module == null || Module.IsListeningActive == false)
                return 0;
            double max = Module.Configuration.PushIntervalSeconds + Module.Configuration.PushJitterSeconds;
            if (max <= 0)
                return 0;
            double percent = (1 - Module.SecondsUntilNextPush / max) * 100;
            return (int)Math.Clamp(percent, 0, 100);
        }
    }

    string FormatCountdown(double seconds)
    {
        if (seconds <= 0)
            return "等待推送";
        if (seconds >= 60)
            return $"{(int)seconds / 60}m{(int)seconds % 60}s";
        return $"{seconds:F0}s";
    }

    void OnIsListeningChanged(bool isListening)
    {
        InvokeAsync(StateHasChanged);
    }

    async Task OnRealtimeToggleChanged(bool enabled)
    {
        if (Module == null)
            return;

        try
        {
            if (enabled)
            {
                await Module.StartRecordingAsync();
            }
            else
            {
                Module.StopRecording();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "切换麦克风识别失败");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task OnSystemListeningChanged(bool enabled)
    {
        if (Module == null)
            return;

        try
        {
            await Module.SetAudioListening(enabled);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "切换系统声音监听失败");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task OnOverlayTopMostChanged(bool enabled)
    {
        Configuration.OverlayTopMost = enabled;
        if (Module != null)
            await Module.SetOverlayTopMostAsync(enabled);
        await InvokeAsync(StateHasChanged);
    }

    async Task ResetOverlayWindow()
    {
        if (Module != null)
            await Module.ResetOverlayWindowAsync();
    }

    void OnOutputTagsChanged(string value)
    {
        Configuration.ReplyRestrictedWords = string.IsNullOrWhiteSpace(value)
            ? []
            : [.. value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];
    }

    public void Dispose()
    {
        if (Module != null)
            Module.IsListeningChanged -= OnIsListeningChanged;
        refreshTimer?.Stop();
        refreshTimer?.Dispose();
    }
}
