@namespace Alife.Function.Doudizhu
@using Alife.Framework
@using Alife.Function.TableGame
@using System.IO
@using System.Linq
@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@attribute [SideBarItem]
@implements IAsyncDisposable
@inject ChatActivitySystem ChatActivitySystem
@inject PluginSystem PluginSystem
@inject IJSRuntime JsRuntime

@* 这个组件自己就是侧栏按钮：点击在客户端内打开全屏牌桌 *@
<Tooltip Title="斗地主" Placement="Placement.Right">
    <div class="alife-rail-item @(visible ? "active" : "")" @onclick="@ToggleFullscreen">
        <svg class="ddz-rail-icon" viewBox="0 0 64 64" aria-hidden="true">
            <g transform="rotate(-17 32 34)">
                <rect x="9" y="15" width="25" height="38" rx="5" class="ddz-rail-card back"/>
            </g>
            <g transform="rotate(17 32 34)">
                <rect x="30" y="15" width="25" height="38" rx="5" class="ddz-rail-card back"/>
            </g>
            <rect x="19" y="9" width="26" height="44" rx="5" class="ddz-rail-card front"/>
            <text x="32" y="39" text-anchor="middle" class="ddz-rail-char">斗</text>
        </svg>
    </div>
</Tooltip>

@if (visible)
{
    <div class="ddz-stage">
        <div class="ddz-sky"></div>
        <div class="ddz-beams" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="ddz-dust" aria-hidden="true">
            @for (int i = 0; i < 26; i++)
            {
                <span style="@($"left:{i * 37 % 100}%;animation-duration:{6 + i % 7}s;animation-delay:-{i * 0.55:0.0}s;width:{2 + i % 3}px;height:{2 + i % 3}px;")"></span>
            }
        </div>
        <div class="ddz-vignette"></div>

        <header class="ddz-topbar">
            <div class="ddz-brand">
                <span class="ddz-brand-mark">斗</span>
                <span class="ddz-brand-text">斗地主<small>LANDLORD</small></span>
                @if (table.IsPlaying)
                {
                    <span class="ddz-status @(IsMyTurn ? "mine" : "")">@StatusText</span>
                }
            </div>
            <div class="ddz-actions">
                @if (table.IsPlaying && table.IsPaused)
                {
                    <button class="ddz-btn primary" @onclick="@(() => table.Resume())">继续</button>
                }
                @if (table.IsPlaying && table.Phase == DoudizhuPhase.Over)
                {
                    <button class="ddz-btn primary" @onclick="RestartGame">再来一局</button>
                }
                @if (table.IsPlaying)
                {
                    <button class="ddz-btn ghost ddz-music" @onclick="ToggleMusic" aria-pressed="@(musicEnabled ? "true" : "false")"
                            aria-label="@(musicEnabled ? "关闭背景音乐" : "开启背景音乐")">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 9h4l4-4v14l-4-4H4z"/>
                            <path d="@(musicEnabled ? "M16 8.5a5 5 0 0 1 0 7M18.5 6a8 8 0 0 1 0 12" : "M17 9l4 6M21 9l-4 6")"/>
                        </svg>
                        <span>@(musicEnabled ? "音乐开" : "音乐关")</span>
                    </button>
                    <button class="ddz-btn danger" @onclick="@(() => table.Stop())">结束牌局</button>
                }
                <button class="ddz-btn ghost" @onclick="CloseFullscreen">退出全屏</button>
            </div>
        </header>

        @if (openingNotice != null && table.Phase != DoudizhuPhase.Over)
        {
            <div class="ddz-opening">
                <span class="ddz-opening-seal">先</span>
                <span class="ddz-opening-text">@openingNotice</span>
            </div>
        }

        @if (turnNotice != null && table.IsPlaying && table.Phase != DoudizhuPhase.Over)
        {
            <div class="ddz-turn-pop @(turnNoticeMine ? "mine" : "")" @key="turnNoticeGeneration" role="status" aria-live="assertive">
                <span class="ddz-turn-pop-ring"></span>
                <span class="ddz-turn-pop-seal">@(turnNoticeMine ? "你" : "换")</span>
                <span class="ddz-turn-pop-copy">
                    <span class="ddz-turn-pop-kicker">@(turnNoticeMine ? "该你了" : "换人")</span>
                    <strong>@turnNotice</strong>
                </span>
            </div>
        }

        @if (table.IsPlaying)
        {
            <div class="ddz-content">
                <section class="ddz-arena">
                    <div class="ddz-opponents">
                        @foreach (int seatIndex in OpponentIndices)
                        {
                            TableSeat seat = table.Seats[seatIndex];
                            <div class="ddz-seat @(table.TurnSeat == seat ? "turn" : "")">
                                <div class="ddz-avatar @(seatIndex == table.LandlordIndex ? "landlord" : "")">@seat.Name.Substring(0, 1)</div>
                                <div class="ddz-seat-info">
                                    <div class="ddz-seat-name">@seat.Name</div>
                                    <div class="ddz-seat-meta">
                                        <span class="ddz-role @(table.Phase != DoudizhuPhase.Bidding && seatIndex == table.LandlordIndex ? "landlord" : "")">@RoleText(seatIndex)</span>
                                        <span class="ddz-count">@table.GetHand(seatIndex).Count 张</span>
                                    </div>
                                </div>
                                @if (table.TurnSeat == seat)
                                {
                                    <span class="ddz-badge">@PhaseVerb</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="ddz-table">
                        <div class="ddz-table-rim"></div>
                        <div class="ddz-felt">
                            <div class="ddz-felt-mark">斗</div>
                            <div class="ddz-bottom">
                                <span class="ddz-bottom-label">底牌</span>
                                <div class="ddz-bottom-cards">
                                    @if (table.Phase == DoudizhuPhase.Bidding)
                                    {
                                        @for (int i = 0; i < 3; i++)
                                        {
                                            <DoudizhuCardView Card="0" Back="true" Mini="true"
                                                              Style="@($"z-index:{i};margin-left:{(i == 0 ? 0 : -18)}px")" />
                                        }
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < table.Bottom.Count; i++)
                                        {
                                            <DoudizhuCardView Card="table.Bottom[i]" Mini="true"
                                                              Ordinal="OrdinalAt(table.Bottom, i)"
                                                              Style="@($"z-index:{i};margin-left:{(i == 0 ? 0 : -18)}px")" />
                                        }
                                    }
                                </div>
                            </div>

                            <div class="ddz-center">
                                @if (table.Phase == DoudizhuPhase.Bidding)
                                {
                                    <div class="ddz-center-idle">静候叫地主</div>
                                }
                                else if (table.LastCards.Count == 0)
                                {
                                    <div class="ddz-center-idle">本轮无人压制 · 自由出牌</div>
                                }
                                else
                                {
                                    <div class="ddz-play-meta">@table.Seats[table.LastPlayerIndex].Name 出牌</div>
                                    <div class="ddz-play-cards">
                                        @for (int i = 0; i < table.LastCards.Count; i++)
                                        {
                                            <DoudizhuCardView Card="table.LastCards[i]" Mini="true"
                                                              Ordinal="OrdinalAt(table.LastCards, i)"
                                                              Style="@($"z-index:{i};margin-left:{(i == 0 ? 0 : -17)}px")" />
                                        }
                                    </div>
                                }
                            </div>

                            <div class="ddz-chips left" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
                            <div class="ddz-chips right" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
                        </div>
                    </div>
                </section>

                <aside class="ddz-panel">
                    <div class="ddz-panel-title"><span class="ddz-seal">桌</span>牌桌</div>
                    <div class="ddz-seat-list">
                        @for (int index = 0; index < table.Seats.Count; index++)
                        {
                            TableSeat seat = table.Seats[index];
                            <div class="ddz-seat-row @(table.TurnSeat == seat ? "turn" : "") @(index == HumanIndex ? "mine" : "")">
                                <span class="ddz-seat-dot @(index == table.LandlordIndex ? "landlord" : "")"></span>
                                <span class="ddz-row-name">@seat.Name</span>
                                <span class="ddz-row-role">@RoleText(index)</span>
                                <span class="ddz-row-count">@table.GetHand(index).Count</span>
                                @if (table.TurnSeat == seat)
                                {
                                    <span class="ddz-row-turn">行动中</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="ddz-hint">@HintText</div>
                    <div class="ddz-log-head"><span class="ddz-seal">牌</span>牌局记录</div>
                    <div class="ddz-log">
                        @if (table.Log.Count == 0)
                        {
                            <div class="ddz-log-empty">静候开局…</div>
                        }
                        @foreach (string line in table.Log.TakeLast(60))
                        {
                            <div>@line</div>
                        }
                    </div>
                </aside>
            </div>

            <div class="ddz-handbar @(IsMyTurn ? "mine" : "")">
                @if (HumanIndex >= 0)
                {
                    IReadOnlyList<int> hand = table.GetHand(HumanIndex);
                    <div class="ddz-turnline">
                        @if (table.Phase == DoudizhuPhase.Over)
                        {
                            <span class="ddz-turn-wait">本局结束</span>
                        }
                        else if (IsMyTurn)
                        {
                            <span class="ddz-turn-now"><span class="ddz-turn-dot"></span>轮到你@(table.Phase == DoudizhuPhase.Bidding ? "叫地主" : "出牌")</span>
                        }
                        else
                        {
                            <span class="ddz-turn-wait">等待 @table.TurnSeat?.Name @(table.Phase == DoudizhuPhase.Bidding ? "叫地主" : "出牌")…</span>
                        }
                        <span class="ddz-hand-count">我的手牌 · @hand.Count 张</span>
                    </div>
                    <div class="ddz-hand">
                        @for (int index = 0; index < hand.Count; index++)
                        {
                            int cardIndex = index;
                            <DoudizhuCardView Card="hand[index]" Selected="@selected.Contains(cardIndex)"
                                              Ordinal="OrdinalAt(hand, index)"
                                              Style="@($"z-index:{index};margin-left:{(index == 0 ? 0 : -26)}px")"
                                              OnClick="@(() => ToggleCard(cardIndex))" />
                        }
                    </div>
                    @if (actionNotice != null)
                    {
                        <div class="ddz-action-notice" @key="actionNoticeGeneration" role="alert" aria-live="assertive">
                            <span class="ddz-action-notice-icon">!</span>
                            <span class="ddz-action-notice-copy">
                                <span class="ddz-action-notice-kicker">无法执行</span>
                                <strong>@actionNotice</strong>
                            </span>
                        </div>
                    }
                    <div class="ddz-controls">
                        @if (table.Phase == DoudizhuPhase.Bidding)
                        {
                            <button class="ddz-btn primary" disabled="@(IsMyTurn == false)" @onclick="CallLandlord">叫地主</button>
                            <button class="ddz-btn ghost" disabled="@(IsMyTurn == false)" @onclick="DeclineBid">不叫</button>
                        }
                        else if (table.Phase == DoudizhuPhase.Playing)
                        {
                            <button class="ddz-btn primary" disabled="@(IsMyTurn == false)" @onclick="PlaySelected">出牌</button>
                            <button class="ddz-btn ghost" disabled="@(IsMyTurn == false)" @onclick="DeclinePlay">不出</button>
                        }
                        <span class="ddz-control-hint">@HintText</span>
                    </div>
                }
                else
                {
                    <div class="ddz-observer">本局没有你的座位，角色们自行对战中。</div>
                }
            </div>

            @if (table.Phase == DoudizhuPhase.Over)
            {
                <div class="ddz-result">
                    <div class="ddz-result-burst"></div>
                    <div class="ddz-result-card">
                        <div class="ddz-result-kicker">@ResultKicker</div>
                        <div class="ddz-result-seal @(ResultTitle == "负" ? "lose" : "")">@ResultTitle</div>
                        <div class="ddz-result-sub">@ResultSub</div>
                        <div class="ddz-result-actions">
                            <button class="ddz-btn primary" @onclick="RestartGame">再来一局</button>
                            <button class="ddz-btn ghost" @onclick="@(() => table.Stop())">结束牌局</button>
                        </div>
                    </div>
                </div>
            }

            @if (table.IsPaused)
            {
                <div class="ddz-pause">
                    <span>@table.TurnSeat?.Name 连续未能完成行动，牌局已暂停。</span>
                    <button class="ddz-btn primary" @onclick="@(() => table.Resume())">继续</button>
                </div>
            }
        }
        else
        {
            <div class="ddz-setup">
                <div class="ddz-setup-card">
                    <div class="ddz-setup-watermark">斗</div>
                    <div class="ddz-setup-kicker">ALIFE · TABLE GAME</div>
                    <h2 class="ddz-setup-title">斗地主</h2>
                    <p class="ddz-setup-desc">选择三位玩家。可以自己入场，也可以让三位角色自行对战。开局随机决定谁先叫地主。</p>
                    @if (CandidateActivities.Count < 2)
                    {
                        <div class="ddz-empty">至少需要两位启用“斗地主”功能的角色，才能凑齐一桌。请在角色的功能检视中启用该模块。</div>
                    }
                    <div class="ddz-setup-slots">
                        <div class="ddz-slot">
                            <span class="ddz-slot-label"><span class="ddz-slot-num">一</span>座位一</span>
                            <Select TItem="string" TItemValue="string" @bind-Value="seatOneKey" Placeholder="选择玩家" Style="width: 100%;">
                                <SelectOption TItem="string" TItemValue="string" Value="@HumanKey" Label="我"/>
                                @for (int index = 0; index < CandidateActivities.Count; index++)
                                {
                                    <SelectOption TItem="string" TItemValue="string" Value="@CandidateActivities[index].Character.Name" Label="@CandidateActivities[index].Character.Name"/>
                                }
                            </Select>
                        </div>
                        <div class="ddz-slot">
                            <span class="ddz-slot-label"><span class="ddz-slot-num">二</span>座位二</span>
                            <Select TItem="string" TItemValue="string" @bind-Value="seatTwoKey" Placeholder="选择玩家" Style="width: 100%;">
                                <SelectOption TItem="string" TItemValue="string" Value="@HumanKey" Label="我"/>
                                @for (int index = 0; index < CandidateActivities.Count; index++)
                                {
                                    <SelectOption TItem="string" TItemValue="string" Value="@CandidateActivities[index].Character.Name" Label="@CandidateActivities[index].Character.Name"/>
                                }
                            </Select>
                        </div>
                        <div class="ddz-slot">
                            <span class="ddz-slot-label"><span class="ddz-slot-num">三</span>座位三</span>
                            <Select TItem="string" TItemValue="string" @bind-Value="seatThreeKey" Placeholder="选择玩家" Style="width: 100%;">
                                <SelectOption TItem="string" TItemValue="string" Value="@HumanKey" Label="我"/>
                                @for (int index = 0; index < CandidateActivities.Count; index++)
                                {
                                    <SelectOption TItem="string" TItemValue="string" Value="@CandidateActivities[index].Character.Name" Label="@CandidateActivities[index].Character.Name"/>
                                }
                            </Select>
                        </div>
                    </div>
                    <button class="ddz-btn primary ddz-start" disabled="@(CanStart == false)" @onclick="StartGame">开始牌局</button>
                    <div class="ddz-setup-foot">三人成局 · 底牌定乾坤</div>
                </div>
            </div>
        }
    </div>
}

<style>
    .ddz-rail-icon {
        width: 36px;
        height: 36px;
        filter: drop-shadow(0 0 6px rgba(232, 192, 125, .45));
        transition: filter .18s ease, transform .18s ease;
    }

    .alife-rail-item:hover .ddz-rail-icon,
    .alife-rail-item.active .ddz-rail-icon {
        filter: drop-shadow(0 0 9px rgba(255, 226, 160, .75));
        transform: scale(1.06);
    }

    .ddz-rail-card {
        stroke: #d9b36c;
        stroke-width: 2;
    }

    .ddz-rail-card.front {
        fill: #f7e6be;
    }

    .ddz-rail-card.back {
        fill: #8e252b;
    }

    .ddz-rail-char {
        fill: #a52a2a;
        font-size: 22px;
        font-weight: 800;
    }

    .ddz-stage {
        --ddz-gold: #e8c07d;
        --ddz-gold-bright: #ffe9b3;
        --ddz-red: #e5484d;
        --ddz-green: #1a7a4c;
        position: fixed;
        inset: 0;
        z-index: 2147483000;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        color: #f7eeda;
        background: radial-gradient(circle at 50% 18%, #14573a 0%, #082b1c 44%, #030d09 100%);
    }

    .ddz-sky {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 16% 8%, rgba(86, 214, 150, .16), transparent 34%),
            radial-gradient(circle at 84% 12%, rgba(232, 192, 125, .12), transparent 32%),
            linear-gradient(180deg, rgba(4, 18, 12, .1), rgba(0, 0, 0, .45));
        pointer-events: none;
    }

    .ddz-beams {
        position: absolute;
        inset: -20% -10% auto;
        height: 70vh;
        display: flex;
        justify-content: space-around;
        pointer-events: none;
        opacity: .5;
    }

    .ddz-beams span {
        width: 130px;
        height: 100%;
        background: linear-gradient(180deg, rgba(255, 233, 179, .22), transparent 80%);
        filter: blur(18px);
        transform-origin: top center;
        animation: ddz-beam 9s ease-in-out infinite alternate;
    }

    .ddz-beams span:nth-child(2) {
        animation-delay: -3s;
        opacity: .6;
    }

    .ddz-beams span:nth-child(3) {
        animation-delay: -6s;
    }

    .ddz-dust {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .ddz-dust span {
        position: absolute;
        bottom: -8px;
        border-radius: 50%;
        background: rgba(255, 226, 160, .6);
        box-shadow: 0 0 8px rgba(255, 226, 160, .45);
        animation: ddz-dust linear infinite;
    }

    .ddz-vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 45%, transparent 42%, rgba(0, 0, 0, .5) 100%);
        pointer-events: none;
    }

    .ddz-topbar {
        position: relative;
        z-index: 4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 26px;
        background: linear-gradient(180deg, rgba(0, 0, 0, .5), rgba(0, 0, 0, .1));
        border-bottom: 1px solid rgba(232, 192, 125, .16);
        backdrop-filter: blur(6px);
    }

    .ddz-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .ddz-brand-mark {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 9px;
        background: linear-gradient(160deg, #fff8e6, #e9d2a4);
        color: #a52a2a;
        font-size: 22px;
        font-weight: 800;
        box-shadow: 0 6px 18px rgba(0, 0, 0, .45), inset 0 0 0 1px rgba(165, 42, 42, .35);
        transform: rotate(-4deg);
    }

    .ddz-brand-text {
        display: flex;
        flex-direction: column;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: .1em;
        line-height: 1.2;
    }

    .ddz-brand-text small {
        font-size: 9px;
        font-weight: 500;
        letter-spacing: .32em;
        color: rgba(255, 233, 179, .55);
    }

    .ddz-status {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 13px;
        border: 1px solid rgba(232, 192, 125, .32);
        color: #ffe9b3;
        background: rgba(0, 0, 0, .2);
    }

    .ddz-status.mine {
        color: #241708;
        font-weight: 700;
        border-color: rgba(255, 233, 179, .8);
        background: linear-gradient(180deg, #ffe9b3, #dfb46c);
        box-shadow: 0 0 16px rgba(232, 192, 125, .4);
        animation: ddz-turn-status 1.6s ease-in-out infinite;
    }

    .ddz-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .ddz-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 18px;
        border-radius: 10px;
        border: 1px solid rgba(232, 192, 125, .28);
        background: rgba(0, 0, 0, .22);
        color: #f7eeda;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease, opacity .15s ease;
    }

    .ddz-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        background: rgba(255, 233, 179, .1);
    }

    .ddz-btn.primary {
        border-color: rgba(255, 233, 179, .55);
        background: linear-gradient(180deg, #e8c07d, #b98a43);
        color: #241708;
        font-weight: 700;
        box-shadow: 0 8px 22px rgba(0, 0, 0, .4), 0 0 18px rgba(232, 192, 125, .16);
    }

    .ddz-btn.danger {
        border-color: rgba(229, 72, 77, .5);
        background: rgba(229, 72, 77, .16);
        color: #ffb8ba;
    }

    .ddz-btn:disabled {
        opacity: .38;
        cursor: default;
        transform: none;
    }

    .ddz-music svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ddz-music path:first-child {
        fill: currentColor;
        stroke: none;
    }

    .ddz-opening {
        position: absolute;
        left: 50%;
        top: 88px;
        z-index: 6;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 22px 10px 14px;
        border-radius: 999px;
        background: linear-gradient(120deg, rgba(42, 29, 16, .96), rgba(12, 24, 16, .94));
        border: 1px solid rgba(232, 192, 125, .45);
        box-shadow: 0 14px 40px rgba(0, 0, 0, .55), 0 0 26px rgba(232, 192, 125, .16);
        pointer-events: none;
        transform: translateX(-50%);
        animation: ddz-opening-in .5s cubic-bezier(.18, .9, .24, 1) both;
    }

    .ddz-opening-seal {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: #a52a2a;
        color: #f3e9d2;
        font-size: 15px;
        box-shadow: 0 0 10px rgba(229, 72, 77, .4);
        transform: rotate(-4deg);
    }

    .ddz-opening-text {
        font-size: 15px;
        letter-spacing: .06em;
        color: #ffe9b3;
        white-space: nowrap;
    }

    .ddz-turn-pop {
        position: absolute;
        left: 50%;
        top: 25%;
        z-index: 7;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 260px;
        padding: 12px 24px 12px 13px;
        border-radius: 999px;
        color: #fff5d8;
        background: linear-gradient(120deg, rgba(22, 18, 12, .96), rgba(12, 42, 26, .94));
        border: 1px solid rgba(232, 192, 125, .45);
        box-shadow: 0 18px 46px rgba(0, 0, 0, .52), 0 0 32px rgba(232, 192, 125, .18);
        pointer-events: none;
        transform: translateX(-50%);
        animation: ddz-turn-pop-in .34s cubic-bezier(.18, .9, .24, 1) both,
                   ddz-turn-pop-out .28s ease .98s both;
    }

    .ddz-turn-pop::before {
        content: "";
        position: absolute;
        inset: -28px;
        z-index: -1;
        border-radius: inherit;
        background: radial-gradient(ellipse, rgba(232, 192, 125, .22), transparent 68%);
        filter: blur(8px);
    }

    .ddz-turn-pop.mine {
        color: #2b1708;
        background: linear-gradient(160deg, #fff4c9, #ecc477 52%, #c79243);
        border-color: rgba(255, 248, 220, .92);
        box-shadow: 0 18px 46px rgba(0, 0, 0, .48), 0 0 40px rgba(255, 233, 179, .5),
                    inset 0 0 0 1px rgba(255, 255, 255, .45);
    }

    .ddz-turn-pop.mine::before {
        background: radial-gradient(ellipse, rgba(255, 224, 142, .56), transparent 70%);
    }

    .ddz-turn-pop-ring {
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        border: 1px solid rgba(255, 233, 179, .62);
        animation: ddz-turn-pop-ring .86s ease-out .1s both;
    }

    .ddz-turn-pop-seal {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        color: #ffe9b3;
        background: linear-gradient(160deg, #4e8ee6, #203f8f);
        border: 1px solid rgba(190, 225, 255, .62);
        box-shadow: 0 0 18px rgba(78, 142, 230, .48);
        font-size: 15px;
        font-weight: 800;
    }

    .ddz-turn-pop.mine .ddz-turn-pop-seal {
        color: #eef7ff;
        background: linear-gradient(160deg, #4e8ee6, #203f8f);
        border-color: rgba(32, 63, 143, .38);
        box-shadow: 0 0 18px rgba(45, 88, 190, .4);
    }

