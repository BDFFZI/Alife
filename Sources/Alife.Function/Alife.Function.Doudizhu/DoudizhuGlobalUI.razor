@code {
    const string HumanKey = "human";
    const double MusicVolume = 0.3;

    readonly DoudizhuTable table = DoudizhuTable.Instance;
    readonly Dictionary<string, string> soundSources = [];
    readonly HashSet<int> selected = [];
    bool clientReady;
    bool visible;
    bool musicEnabled = true;
    string? openingNotice;
    int openingGeneration;
    int lastLogCount;
    bool lastPlaying;
    DoudizhuPhase? lastPhase;
    bool lastMyTurn;
    string? lastTurnKey;
    string? turnNotice;
    bool turnNoticeMine;
    int turnNoticeGeneration;
    string? actionNotice;
    int actionNoticeGeneration;
    string? seatOneKey = HumanKey;
    string? seatTwoKey;
    string? seatThreeKey;

    int HumanIndex => table.HumanIndex;
    bool IsMyTurn => HumanIndex >= 0 && table.TurnSeat == table.Seats[HumanIndex];
    bool CanStart => seatOneKey != null && seatTwoKey != null && seatThreeKey != null
        && seatOneKey != seatTwoKey && seatOneKey != seatThreeKey && seatTwoKey != seatThreeKey;
    bool HumanWon => HumanIndex >= 0 && (table.WinnerIndex == table.LandlordIndex) == (HumanIndex == table.LandlordIndex);
    List<ChatActivity> CandidateActivities => ChatActivitySystem.GetAllChatActivities()
        .Where(activity => activity.Container.Instances.OfType<DoudizhuService>().Any())
        .ToList();
    IEnumerable<int> OpponentIndices => Enumerable.Range(0, table.Seats.Count).Where(index => index != HumanIndex || HumanIndex < 0);
    string PhaseVerb => table.Phase == DoudizhuPhase.Bidding ? "叫牌中" : "思考中";
    string TurnAction => table.Phase == DoudizhuPhase.Bidding ? "叫地主" : "出牌";
    string StatusText => table.Phase switch
    {
        DoudizhuPhase.Bidding => IsMyTurn ? "轮到你 · 叫地主" : $"{table.TurnSeat?.Name} 叫地主",
        DoudizhuPhase.Playing => IsMyTurn ? "轮到你 · 出牌" : $"{table.TurnSeat?.Name} 出牌",
        _ => ResultKicker,
    };
    string ResultKicker => table.Phase != DoudizhuPhase.Over
        ? ""
        : table.WinnerIndex == table.LandlordIndex ? "地主获胜" : "农民获胜";
    string ResultTitle => table.Phase != DoudizhuPhase.Over
        ? ""
        : HumanIndex < 0 ? "终" : HumanWon ? "胜" : "负";
    string ResultSub => table.Phase != DoudizhuPhase.Over
        ? ""
        : table.WinnerIndex == table.LandlordIndex
            ? $"地主 {table.Seats[table.LandlordIndex].Name} 拿下牌局"
            : $"农民 {string.Join("、", Enumerable.Range(0, table.Seats.Count).Where(index => index != table.LandlordIndex).Select(index => table.Seats[index].Name))} 联手取胜";
    string HintText
    {
        get
        {
            if (table.Phase == DoudizhuPhase.Over)
                return "";
            if (IsMyTurn == false)
                return $"等待 {table.TurnSeat?.Name} 行动…";
            if (table.Phase == DoudizhuPhase.Bidding)
                return "轮到你。叫地主可获得三张底牌，不叫则轮到下家。";
            return table.LastCards.Count == 0
                ? "轮到你，本轮由你自由出牌。"
                : $"轮到你，需要压过 {table.Seats[table.LastPlayerIndex].Name} 的牌，或选择不出。";
        }
    }

    protected override void OnInitialized()
    {
        table.Changed += OnTableChanged;
        lastPlaying = table.IsPlaying;
        lastLogCount = table.Log.Count;
        lastPhase = table.IsPlaying ? table.Phase : null;
        lastMyTurn = table.IsPlaying && IsMyTurn;
        lastTurnKey = TurnKey();

        List<ChatActivity> candidates = CandidateActivities;
        if (candidates.Count > 0)
            seatTwoKey = candidates[0].Character.Name;
        if (candidates.Count > 1)
            seatThreeKey = candidates[1].Character.Name;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await EnsureClientScriptAsync();
    }
    public async ValueTask DisposeAsync()
    {
        table.Changed -= OnTableChanged;
        if (clientReady)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("__alifeDdzStopMusic", 0.2);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    string RoleText(int index)
    {
        if (table.Phase == DoudizhuPhase.Bidding)
            return "待定";
        return index == table.LandlordIndex ? "地主" : "农民";
    }
    static int OrdinalAt(IReadOnlyList<int> cards, int index)
    {
        int ordinal = 0;
        for (int cursor = 0; cursor < index; cursor++)
        {
            if (cards[cursor] == cards[index])
                ordinal++;
        }
        return ordinal;
    }
    void ToggleFullscreen()
    {
        visible = !visible;
    }
    void CloseFullscreen()
    {
        visible = false;
        StateHasChanged();
    }
    void OnTableChanged()
    {
        _ = InvokeAsync(async () => {
            bool started = table.IsPlaying && (lastPlaying == false || (lastPhase == DoudizhuPhase.Over && table.Phase != DoudizhuPhase.Over));
            string? turnKey = TurnKey();
            bool turnChanged = started == false && turnKey != null && turnKey != lastTurnKey;
            selected.Clear();
            actionNotice = null;
            actionNoticeGeneration++;
            if (started)
                AnnounceOpening();
            else if (turnChanged)
                AnnounceTurn();
            else if (turnKey == null)
            {
                turnNotice = null;
                turnNoticeGeneration++;
            }
            lastTurnKey = turnKey;
            StateHasChanged();
            await PlayStateSoundsAsync();
        });
    }
    string? TurnKey()
    {
        if (table.IsPlaying == false || table.Phase == DoudizhuPhase.Over || table.TurnSeat == null)
            return null;
        return $"{table.TurnSeat.Name}|{table.Phase}";
    }
    void AnnounceOpening()
    {
        TableSeat? seat = table.TurnSeat;
        if (seat == null)
            return;

        openingNotice = $"开局随机 · {seat.Name} 先叫地主";
        int generation = ++openingGeneration;
        _ = HideOpeningAsync(generation);
    }
    async Task HideOpeningAsync(int generation)
    {
        await Task.Delay(3200);
        if (generation != openingGeneration)
            return;
        openingNotice = null;
        await InvokeAsync(StateHasChanged);
    }
    void AnnounceTurn()
    {
        TableSeat? seat = table.TurnSeat;
        if (seat == null)
            return;

        turnNoticeMine = HumanIndex >= 0 && seat == table.Seats[HumanIndex];
        turnNotice = turnNoticeMine ? $"轮到你 · {TurnAction}" : $"轮到 {seat.Name} · {TurnAction}";
        int generation = ++turnNoticeGeneration;
        _ = HideTurnNoticeAsync(generation);
    }
    async Task HideTurnNoticeAsync(int generation)
    {
        await Task.Delay(1400);
        if (generation != turnNoticeGeneration)
            return;
        turnNotice = null;
        await InvokeAsync(StateHasChanged);
    }
    void ShowActionNotice(string message)
    {
        actionNotice = message;
        int generation = ++actionNoticeGeneration;
        _ = HideActionNoticeAsync(generation);
    }
    async Task HideActionNoticeAsync(int generation)
    {
        await Task.Delay(2500);
        if (generation != actionNoticeGeneration)
            return;
        actionNotice = null;
        await InvokeAsync(StateHasChanged);
    }
    void ToggleCard(int index)
    {
        if (table.Phase != DoudizhuPhase.Playing || IsMyTurn == false)
        {
            if (table.Phase == DoudizhuPhase.Playing)
                ShowActionNotice($"还没轮到你，等待 {table.TurnSeat?.Name} 行动。");
            return;
        }
        if (selected.Remove(index) == false)
            selected.Add(index);
    }
    void StartGame()
    {
        if (CanStart == false)
            return;

        table.Start([CreateSeat(seatOneKey!), CreateSeat(seatTwoKey!), CreateSeat(seatThreeKey!)]);
    }
    TableSeat CreateSeat(string key)
    {
        if (key == HumanKey)
            return new TableSeat { Name = "我" };

        ChatActivity activity = CandidateActivities.First(activity => activity.Character.Name == key);
        return new TableSeat { Name = activity.Character.Name, Character = activity.Character, ChatBot = activity.ChatBot };
    }
    void RestartGame()
    {
        table.Start(table.Seats);
    }
    void CallLandlord()
    {
        Attempt(table.Call(HumanIndex));
    }
    void DeclineBid()
    {
        Attempt(table.Pass(HumanIndex));
    }
    void PlaySelected()
    {
        if (selected.Count == 0)
        {
            ShowActionNotice("请先选择要出的牌。");
            return;
        }

        List<int> hand = [.. table.GetHand(HumanIndex)];
        List<int> cards = selected.OrderBy(index => index).Select(index => hand[index]).ToList();
        Attempt(table.Play(HumanIndex, cards));
    }
    void DeclinePlay()
    {
        if (table.LastCards.Count == 0)
        {
            ShowActionNotice("你是本轮首家，必须出牌。");
            return;
        }

        Attempt(table.Pass(HumanIndex));
    }
    void Attempt(string? error)
    {
        if (error != null)
            ShowActionNotice(error);
    }

    async Task ToggleMusic()
    {
        musicEnabled = !musicEnabled;
        if (musicEnabled && visible && table.IsPlaying && table.Phase != DoudizhuPhase.Over)
            await PlayMusicAsync();
        if (musicEnabled == false)
            await StopMusicAsync();
    }
    async Task PlayStateSoundsAsync()
    {
        bool playing = table.IsPlaying;
        bool started = playing && (lastPlaying == false || (lastPhase == DoudizhuPhase.Over && table.Phase != DoudizhuPhase.Over));
        if (started)
        {
            lastLogCount = 0;
            await PlayAsync("start");
            if (table.Phase != DoudizhuPhase.Over)
            {
                await Task.Delay(700);
                if (table.IsPlaying && table.Phase != DoudizhuPhase.Over)
                    await PlayMusicAsync();
            }
        }
        if (playing && table.Log.Count > lastLogCount)
        {
            for (int index = lastLogCount; index < table.Log.Count; index++)
            {
                string line = table.Log[index];
                if (line.Contains("叫地主"))
                    await PlayAsync("check");
                else if (line.Contains("出 "))
                    await PlayAsync(line.Contains("炸弹") || line.Contains("王炸") ? "capture" : "move");
            }
        }
        if (table.Phase == DoudizhuPhase.Over && lastPhase != DoudizhuPhase.Over)
        {
            await PlayAsync(EndSound());
            await StopMusicAsync();
        }
        if (playing == false && lastPlaying)
            await StopMusicAsync();

        bool myTurn = playing && IsMyTurn && table.Phase != DoudizhuPhase.Over;
        if (myTurn && lastMyTurn == false && started == false)
        {
            await Task.Delay(160);
            await PlayAsync("turn");
        }

        lastPlaying = playing;
        lastLogCount = table.Log.Count;
        lastPhase = playing ? table.Phase : null;
        lastMyTurn = myTurn;
    }
    string EndSound()
    {
        if (HumanIndex < 0)
            return "end";
        return HumanWon ? "win" : "lose";
    }
    async Task PlayAsync(string name)
    {
        string source = SoundSource(name);
        if (source.Length == 0)
            return;

        await EnsureClientScriptAsync();
        await JsRuntime.InvokeVoidAsync("__alifeDdzPlay", name, source, SoundVolume(name));
    }
    async Task PlayMusicAsync()
    {
        if (musicEnabled == false)
            return;

        string source = SoundSource("bgm");
        if (source.Length == 0)
            return;

        await EnsureClientScriptAsync();
        await JsRuntime.InvokeVoidAsync("__alifeDdzMusic", "bgm", source, MusicVolume);
    }
    async Task StopMusicAsync()
    {
        if (clientReady == false)
            return;

        await JsRuntime.InvokeVoidAsync("__alifeDdzStopMusic", 1.1);
    }
    async Task EnsureClientScriptAsync()
    {
        if (clientReady)
            return;

        await JsRuntime.InvokeVoidAsync("eval", ClientScript);
        clientReady = true;
    }
    static double SoundVolume(string name)
    {
        return name switch
        {
            "move" => 0.6,
            "capture" => 0.82,
            "check" => 0.78,
            "turn" => 0.5,
            "start" => 0.72,
            "win" => 0.8,
            "lose" => 0.7,
            "end" => 0.72,
            _ => 0.7
        };
    }
    string SoundSource(string name)
    {
        if (soundSources.TryGetValue(name, out string? cached))
            return cached;

        string? pluginId = PluginSystem.PluginContext.GetTypeAttachedPlugin(typeof(DoudizhuService));
        if (pluginId == null)
            return "";

        string path = Path.Combine(PluginSystem.PluginContext.GetPluginDirectoryPath(pluginId), "Resources", name + ".ogg");
        if (File.Exists(path) == false)
            return "";

        string source = "data:audio/ogg;base64," + Convert.ToBase64String(File.ReadAllBytes(path));
        soundSources[name] = source;
        return source;
    }

    // 音效与场景脚本随插件注入，不依赖客户端 wwwroot。
    const string ClientScript = """
        if (!window.__alifeDdzPlay) {
            let audioContext = null;
            let musicGain = null;
            let musicSource = null;
            const buffers = new Map();

            window.__alifeDdzEnsure = function () {
                if (!audioContext) {
                    const AudioCtor = window.AudioContext || window.webkitAudioContext;
                    audioContext = new AudioCtor();
                }
                if (audioContext.state === "suspended") audioContext.resume();
                return audioContext;
            };
            function decode(uri) {
                const comma = uri.indexOf(",");
                const binary = atob(uri.slice(comma + 1));
                const bytes = new Uint8Array(binary.length);
                for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
                return bytes;
            }
            async function load(name, uri) {
                let buffer = buffers.get(name);
                if (buffer) return buffer;
                buffer = await window.__alifeDdzEnsure().decodeAudioData(decode(uri).buffer);
                buffers.set(name, buffer);
                return buffer;
            }
            function ramp(gain, target, seconds) {
                const context = window.__alifeDdzEnsure();
                const now = context.currentTime;
                gain.gain.cancelScheduledValues(now);
                gain.gain.setValueAtTime(gain.gain.value, now);
                gain.gain.linearRampToValueAtTime(target, now + seconds);
            }
            window.__alifeDdzPlay = async function (name, uri, volume) {
                try {
                    const context = window.__alifeDdzEnsure();
                    const buffer = await load(name, uri);
                    const source = context.createBufferSource();
                    const gain = context.createGain();
                    source.buffer = buffer;
                    gain.gain.value = volume;
                    source.connect(gain).connect(context.destination);
                    source.start();
                } catch (error) {
                    console.warn("alife doudizhu sound", error);
                }
            };
            window.__alifeDdzMusic = async function (name, uri, volume) {
                try {
                    if (typeof window.__alifeSoundStopMusic === "function")
                        window.__alifeSoundStopMusic(0.6);
                    const context = window.__alifeDdzEnsure();
                    if (musicSource) return;
                    const buffer = await load(name, uri);
                    if (!musicGain) {
                        musicGain = context.createGain();
                        musicGain.connect(context.destination);
                    }
                    musicSource = context.createBufferSource();
                    musicSource.buffer = buffer;
                    musicSource.loop = true;
                    musicSource.connect(musicGain);
                    musicGain.gain.value = 0;
                    musicSource.start();
                    ramp(musicGain, volume, 1.6);
                } catch (error) {
                    console.warn("alife doudizhu music", error);
                }
            };
            window.__alifeDdzStopMusic = function (seconds) {
                if (!musicSource || !musicGain) return;
                const source = musicSource;
                musicSource = null;
                ramp(musicGain, 0, seconds);
                setTimeout(function () {
                    try { source.stop(); } catch (error) { }
                }, seconds * 1000 + 60);
            };
            window.addEventListener("pointerdown", function (event) {
                if (event.target && event.target.closest && event.target.closest(".ddz-stage")) window.__alifeDdzEnsure();
            }, true);
            window.addEventListener("keydown", function (event) {
                if (event.target && event.target.closest && event.target.closest(".ddz-stage")) window.__alifeDdzEnsure();
            }, true);
        }

        """;
}
