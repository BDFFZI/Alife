@inject CharacterSystem CharacterSystem
@inject ChatActivitySystem ChatActivitySystem
@inject NavigationManager Navigation
@inject ClientDataStore ClientDataStore
@inject UIAttributeSystem UIAttributeSystem
@implements IDisposable

<div class="alife-rail">
    @* 侧栏按钮由 SideBarItemAttribute 声明，本处只排序并渲染；按钮长什么样、点了做什么，全在组件自己身上 *@
    <div class="alife-rail-group">
        @foreach (UIRegistration registration in sidebarItems)
        {
            <PluginErrorBoundary @key="@registration.ComponentType">
                <ChildContent>
                    <DynamicComponent Type="@registration.ComponentType"/>
                </ChildContent>
                <ErrorContent Context="ex">
                    <PluginErrorPanel Value="ex" Silent="true"/>
                </ErrorContent>
            </PluginErrorBoundary>
        }
    </div>

    <div class="alife-rail-split"></div>

    <div class="alife-rail-scroll">
        @foreach (Character character in CharacterSystem.GetAllCharacters())
        {
            bool isActive = ChatActivitySystem.IsActivated(character);
            <Tooltip Title="@character.Name" Placement="Placement.Right">
                <NavLink href="@($"/agent/{character.Name}")" Class="alife-rail-item" ActiveClass="active"
                         @onclick="@(() => ClientDataStore.SetLastCharacter(character))">
                    <Avatar Size="@AvatarSize.Large"
                            Style="background: var(--alife-primary); color: var(--alife-text-inverse); font-weight: 600;">@(character.Name.FirstOrDefault())</Avatar>
                    @if (isActive)
                    {
                        <StatusDot Online="true" Style="position: absolute; bottom: 2px; right: 2px;"/>
                    }
                </NavLink>
            </Tooltip>
        }

        @* 创建新角色排在角色列表末尾：和上面的角色是同一类东西 *@
        <Tooltip Title="@("创建新角色")" Placement="Placement.Right">
            <div class="alife-rail-item alife-rail-add" @onclick="@(() => isCreating = true)">
                <Icon Type="@IconType.Outline.Plus"/>
            </div>
        </Tooltip>
    </div>

    <div class="alife-rail-split"></div>
</div>

<Modal Title="创建新角色"
       Visible="@isCreating"
       OnOk="@OnConfirmCreate"
       OnCancel="@(() => isCreating = false)">
    <AntDesign.Text>请输入角色名称：</AntDesign.Text>
    <Input @bind-Value="@newCharacterName"/>
    <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 8px; display: block;">
        注意：非法字符将被自动替换，建议使用中文或英文。
    </AntDesign.Text>
</Modal>

@code {
    bool isCreating;
    string newCharacterName = "";

    /// <summary>侧栏按钮（内置 + 插件，已按开关过滤并排好序）。</summary>
    IReadOnlyList<UIRegistration> sidebarItems = [];

    protected override void OnInitialized()
    {
        CharacterSystem.CharacterListChanged += OnCharacterListChanged;
        ChatActivitySystem.Activated += OnActivityChanged;
        ChatActivitySystem.Deactivated += OnActivityChanged;
        UIAttributeSystem.RegistrationsChanged += OnRegistrationsChanged;
        RefreshSidebarItems();
    }
    public void Dispose()
    {
        CharacterSystem.CharacterListChanged -= OnCharacterListChanged;
        ChatActivitySystem.Activated -= OnActivityChanged;
        ChatActivitySystem.Deactivated -= OnActivityChanged;
        UIAttributeSystem.RegistrationsChanged -= OnRegistrationsChanged;
    }

    void OnRegistrationsChanged() => InvokeAsync(() => {
        RefreshSidebarItems();
        StateHasChanged();
    });
    void OnActivityChanged(ChatActivity _) => OnCharacterListChanged();
    void OnCharacterListChanged() => InvokeAsync(StateHasChanged);

    void RefreshSidebarItems()
    {
        sidebarItems = UIAttributeSystem.GetEnabledRegistrations<SideBarItemAttribute>()
            .OrderByDescending(registration => ((SideBarItemAttribute)registration.Attribute).Order)
            .ThenBy(registration => UIAttribute.IdentityOf(registration.ComponentType), StringComparer.Ordinal)
            .ToList();
    }

    async void OnConfirmCreate()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(newCharacterName)) return;
            Character character = CharacterSystem.CreateCharacter(newCharacterName);
            await CharacterSystem.SaveCharacter(character);
            isCreating = false;
            Navigation.NavigateTo($"/agent/{newCharacterName}");
            ClientDataStore.SetLastCharacter(character);
            newCharacterName = "";
        }
        catch (Exception e)
        {
            AlifeLog.LogError(e);
        }
    }
}
