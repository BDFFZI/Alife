@inherits LayoutComponentBase
@implements IDisposable
@inject CharacterSystem CharacterSystem
@inject NavigationManager NavigationManager
@inject ClientDataStore ClientDataStore
@inject UIThemeSystem UITheme
@inject IJSRuntime JsRuntime

<div class="app-shell">
    <nav class="app-sidebar">
        <NavMenu/>
    </nav>

    <section class="app-main">
        @Body
    </section>
</div>

<div class="overlay-layer">
    <CharacterLoadingOverlay/>
    <AutoActivateOverlay/>
    <UpdateNotificationOverlay/>
    <GlobalUIOverlay/>
</div>

<style>
    .app-shell {
        height: 100vh;
        display: flex;
        overflow: hidden;
        background: var(--alife-bg-layout);
    }

    .app-sidebar {
        flex: 0 0 auto;
        width: var(--alife-sidebar-width);
        display: flex;
        flex-direction: column;
        /* 底部留出与侧栏上边距对称的空白，日志入口落在这一格里 */
        padding-bottom: 12px;
        background: var(--alife-sidebar-bg);
        border-right: 1px solid var(--alife-sidebar-border);
    }

    .app-main {
        flex: 1 1 auto;
        min-width: 0;
        position: relative;
        overflow: hidden;
        background: var(--alife-bg-layout);
    }

    .overlay-layer {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1000;
    }
</style>

@code {

    protected override void OnInitialized()
    {
        if (new Uri(NavigationManager.Uri).AbsolutePath is "/")
        {
            if (CharacterSystem.GetAllCharacters().Count > 0)
            {
                Character character = ClientDataStore.GetLastCharacter() ?? CharacterSystem.GetAllCharacters().First();
                NavigationManager.NavigateTo($"/agent/{character.Name}");
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == false)
            return;

        UITheme.ThemeChanged += OnThemeChanged;
        await ApplyThemeAsync();
    }
    public void Dispose()
    {
        UITheme.ThemeChanged -= OnThemeChanged;
    }

    void OnThemeChanged() => InvokeAsync(ApplyThemeAsync);

    /// <summary>样式表切换只能在浏览器侧完成（AntDesign 主题是编译期 CSS），C# 这边只管状态。</summary>
    Task ApplyThemeAsync() => JsRuntime.InvokeVoidAsync("alifeTheme.apply", UITheme.Mode).AsTask();
}
