@using System.Linq
@using Alife.Client.Components.Pages.SystemManagement
@inject CharacterSystem CharacterSystem
@inject ModuleSystem ModuleSystem
@inject NavigationManager Navigation

<div class="step-content">
    <div class="step-icon" style="background:var(--alife-success-bg);color:var(--alife-success);">
        <Icon Type="@IconType.Outline.CheckCircle" Style="font-size:28px;"/>
    </div>
    <h2 class="step-title">配置完成</h2>
    <p class="step-desc">Alife 已准备就绪，以下是关键功能入口</p>

    <div class="nav-cards">
        <div class="nav-card">
            <div class="nc-icon" style="background:var(--alife-primary-border);color:var(--alife-primary);">
                <Icon Type="@IconType.Outline.User"/>
            </div>
            <div class="nc-body">
                <h3 class="nc-title">角色编辑</h3>
                <p class="nc-desc">创建和管理智能角色，编辑设定、启动对话</p>
                <Button Size="@ButtonSize.Small" Block OnClick="@GoToCharacterOrSystem">进入角色页</Button>
            </div>
        </div>
        <div class="nav-card">
            <div class="nc-icon" style="background:var(--alife-success-bg);color:var(--alife-success);">
                <Icon Type="@IconType.Outline.Build"/>
            </div>
            <div class="nc-body">
                <h3 class="nc-title">功能管理</h3>
                <p class="nc-desc">配置各种已装功能的具体参数</p>
                <Button Size="@ButtonSize.Small" Block OnClick="@GoToModuleCenter">前往系统管理</Button>
            </div>
        </div>
        <div class="nav-card">
            <div class="nc-icon" style="background:var(--alife-warning-bg);color:var(--alife-warning);">
                <Icon Type="@IconType.Outline.Shop"/>
            </div>
            <div class="nc-body">
                <h3 class="nc-title">插件市场</h3>
                <p class="nc-desc">浏览和安装社区插件，扩展功能边界</p>
                <Button Size="@ButtonSize.Small" Block OnClick="@GoToPluginMarket">前往插件市场</Button>
            </div>
        </div>
    </div>

    <div class="step-actions" style="margin-top:20px;">
        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" Icon="@IconType.Outline.Home" Block
                OnClick="@GoToCharacterOrSystem">
            开始使用 Alife
        </Button>
    </div>
</div>

@code {
    void GoToCharacterOrSystem()
    {
        var first = CharacterSystem.GetAllCharacters().FirstOrDefault();
        if (first != null)
        {
            Navigation.NavigateTo($"/agent/{first.Name}");
        }
        else
        {
            Character ch = CharacterSystem.CreateCharacter("真央");
            ch.Description = "主人的猫娘";
            ch.Prompt = """
                        一位带有橘色长发，可爱活泼的猫娘少女。
                        生活态度积极乐观，充满好奇心，喜欢主动探索玩耍，粘着主人。
                        行为做事聪明能干，样样精通，总能轻而易举的化解主人遇到的各种问题。
                        说话谈吐幽默风趣，自然口语化，让人有真实感，亲近感，还喜欢说喵~
                        内心暗暗喜欢着自己的主人，将他视作自己的全部，甚至为此愿意满足他的任何需求，将其视作活着的意义。
                        """;
            ch.Modules = new HashSet<string>(ModuleSystem.GetAllModules()
                .Select(type => ModuleSystem.GetModuleId(type)));
            CharacterSystem.SaveCharacter(ch);
            Navigation.NavigateTo($"/agent/{ch.Name}");
        }
    }

    void GoToPluginMarket()
    {
        ClientNavigation.RequestNavigation(typeof(PluginMarketTab));
        Navigation.NavigateTo("/system");
    }

    void GoToModuleCenter()
    {
        ClientNavigation.RequestNavigation(typeof(ModuleCenterTab));
        Navigation.NavigateTo("/system");
    }
}

<style>
    .step-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    .step-title {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 700;
        color: var(--alife-text);
        text-align: center;
    }

    .step-desc {
        margin: 0 0 20px;
        font-size: 13px;
        color: var(--alife-text-tertiary);
        text-align: center;
    }

    .nav-cards {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
    }

    .nav-card {
        padding: 14px;
        background: var(--alife-bg-subtle);
        border: 1px solid var(--alife-bg-hover);
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .nav-card:hover {
        border-color: var(--alife-primary-border);
        background: var(--alife-primary-bg);
    }

    .nc-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-bottom: 8px;
    }

    .nc-title {
        margin: 0 0 4px;
        font-size: 13px;
        font-weight: 600;
        color: var(--alife-text);
    }

    .nc-desc {
        margin: 0 0 8px;
        font-size: 11px;
        color: var(--alife-text-tertiary);
        line-height: 1.4;
    }

    .step-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: auto;
    }
</style>
