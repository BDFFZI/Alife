<div class="step-content">
    <div class="step-icon" style="background:rgba(114,46,209,.1);color:#722ed1;">
        <Icon Type="@IconType.Outline.CloudServer" Style="font-size:28px;"/>
    </div>
    <h2 class="step-title">配置下载镜像</h2>
    <p class="step-desc">
        在中国大陆可使用镜像下载环境依赖、插件和客户端更新。GitHub 镜像可选。
    </p>

    <Alert ShowIcon="true" Type="AlertType.Warning" Style="margin: 12px;"
           Message="Github镜像很不稳定，你需要定期在镜像设置页面更新，否则将无法正常使用！"></Alert>
    
    <div class="mirror-list">
        @foreach (var mirror in AvailableMirrors)
        {
            <div class="mirror-item">
                <div class="mirror-main">
                    <div class="mirror-name">
                        @mirror.Name
                        <Tag>@mirror.Provider</Tag>
                        @if (mirror.Recommended)
                        {
                            <Tag Color="@("green")">稳定</Tag>
                        }
                        else
                        {
                            <Tag Color="@("orange")">不稳定</Tag>
                        }
                    </div>
                    <Text Type="@TextElementType.Secondary" Style="font-size: 12px;">@mirror.Description</Text>
                    
                    @if (mirror.Id == "github")
                    {
                        @if (enabledMirrors[mirror.Id])
                        {
                            <GithubMirrorPicker @bind-SelectedDomain="@selectedGithubDomain"/>
                        }
                    }
                    else
                    {
                        @if (mirror.UrlMappings.Any())
                        {
                            <div class="mirror-urls">
                                @foreach (var kv in mirror.UrlMappings)
                                {
                                    <div class="mirror-url-row">
                                        <Text Type="@TextElementType.Secondary" Style="font-size: 11px;">镜像</Text>
                                        <Text Code Style="font-size: 11px;">@kv.Value</Text>
                                    </div>
                                }
                            </div>
                        }
                        @if (mirror.EnvironmentVariables.Any())
                        {
                            <div class="mirror-urls">
                                @foreach (var kv in mirror.EnvironmentVariables)
                                {
                                    <div class="mirror-url-row">
                                        <Text Type="@TextElementType.Secondary" Style="font-size: 11px;">@kv.Key</Text>
                                        <Text Code Style="font-size: 11px;">@kv.Value</Text>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                <Switch @bind-Value="@enabledMirrors[mirror.Id]"/>
            </div>
        }
    </div>

    <div class="step-nav">
        <Button Size="@ButtonSize.Large" OnClick="@OnPrev">
            <Icon Type="@IconType.Outline.ArrowLeft"/>
            上一步
        </Button>
        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" OnClick="@OnNext">
            下一步
            <Icon Type="@IconType.Outline.ArrowRight"/>
        </Button>
    </div>
</div>

@code {

    record MirrorItem(
        string Id,
        string Name,
        string Provider,
        string Description,
        bool Recommended,
        Dictionary<string, string> UrlMappings,
        Dictionary<string, string> EnvironmentVariables
    );

    static readonly List<MirrorItem> AvailableMirrors = [
        new(
            "pypi",
            "PyPI 镜像",
            "阿里云",
            "用于在国内下载 Python 包环境",
            true,
            new Dictionary<string, string>(),
            new Dictionary<string, string> {
                { "PIP_INDEX_URL", "https://mirrors.aliyun.com/pypi/simple/" },
                { "PIP_TRUSTED_HOST", "mirrors.aliyun.com" }
            }
        ),
        new(
            "pytorch-cuda",
            "PyTorch-CUDA 镜像",
            "阿里云",
            "用于在国内下载 CUDA 环境",
            true,
            new Dictionary<string, string> {
                { "--index-url https://download.pytorch.org/whl/cu128", "--find-links https://mirrors.aliyun.com/pytorch-wheels/cu128" }
            },
            new Dictionary<string, string>()
        ),
        new(
            "github",
            "GitHub 加速",
            "社区",
            "用于下载 GitHub 上的插件和客户端更新",
            false,
            new Dictionary<string, string>(),
            new Dictionary<string, string>()
        ),
    ];

    string selectedGithubDomain = "";

    [Parameter] public EventCallback OnPrevStep { get; set; }
    [Parameter] public EventCallback OnNextStep { get; set; }

    readonly Dictionary<string, bool> enabledMirrors = new();

    protected override void OnInitialized()
    {
        foreach (MirrorItem mirror in AvailableMirrors)
            enabledMirrors[mirror.Id] = true;
    }

    void ApplyMirrors()
    {
        var urlMap = new Dictionary<string, string>();
        var envVars = new Dictionary<string, string>();

        foreach (var mirror in AvailableMirrors)
        {
            if (enabledMirrors.GetValueOrDefault(mirror.Id))
            {
                if (mirror.Id == "github")
                {
                    if (selectedGithubDomain.Length > 0)
                        GithubMirrorPicker.SetMappings(urlMap, selectedGithubDomain);
                }
                else
                {
                    foreach (var kv in mirror.UrlMappings)
                        urlMap[kv.Key] = kv.Value;
                    foreach (var kv in mirror.EnvironmentVariables)
                        envVars[kv.Key] = kv.Value;
                }
            }
        }

        AlifeMirror.SetMirrorUrlMap(urlMap);
        AlifeMirror.SetMirrorEnvironmentVariables(envVars);
        AlifeMirror.SetupEnvironment();
    }

    async Task OnPrev() { await OnPrevStep.InvokeAsync(); }
    async Task OnNext()
    {
        ApplyMirrors();
        await OnNextStep.InvokeAsync();
    }
}

<style>
    .step-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    .step-title {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 700;
        color: var(--alife-text);
        text-align: center;
    }

    .step-desc {
        margin: 0 0 20px;
        font-size: 13px;
        color: var(--alife-text-tertiary);
        text-align: center;
    }

    .step-nav {
        display: flex;
        justify-content: space-between;
        margin-top: 16px;
        gap: 12px;
    }

    .mirror-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .mirror-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: var(--alife-bg-subtle);
        border-radius: 8px;
        border: 1px solid var(--alife-border);
    }

    .mirror-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .mirror-name {
        font-weight: 500;
        font-size: 13px;
        color: var(--alife-text);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .mirror-urls {
        margin-top: 6px;
    }

    .mirror-url-row {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        line-height: 1.6;
    }
</style>
