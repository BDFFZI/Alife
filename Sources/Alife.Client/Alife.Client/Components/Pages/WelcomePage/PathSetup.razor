@inject IAlifeClient AlifeClient
@inject IAlifeApplication AlifeApplication
@inject INotificationService NotificationService

<div class="step-content">
    <div class="step-icon" style="background:var(--alife-warning-bg);color:var(--alife-warning);">
        <Icon Type="@IconType.Outline.FolderOpen" Style="font-size:28px;"/>
    </div>
    <h2 class="step-title">路径配置</h2>
    <p class="step-desc">检测并配置关键路径，确保路径不包含中文字符</p>

    @if (hasNonAsciiPath)
    {
        <div class="path-error">
            <Icon Type="@IconType.Outline.CloseCircle" Style="color:var(--alife-error);"/>
            <div>
                <div style="font-weight:500;">检测到以下路径包含中文字符</div>
                <div style="margin-top:4px;">请修改为纯英文路径，否则部分功能将无法正常使用！</div>
            </div>
        </div>
    }

    <div class="path-list">
        <div class="path-item">
            <div class="path-header">
                <span class="path-label">运行时路径</span>
                <span class="path-status @(HasNonAscii(runtimePath) ? "error" : "ok")">
                    @(HasNonAscii(runtimePath) ? "包含中文" : "正常")
                </span>
            </div>
            <div class="path-edit">
                <Input Value="@runtimePath" ReadOnly/>
                <Button Icon="@IconType.Outline.FolderOpen" OnClick="PickRuntimeFolderAsync"></Button>
            </div>
        </div>

        <div class="path-item">
            <div class="path-header">
                <span class="path-label">存储路径</span>
                <span class="path-status @(HasNonAscii(storagePath) ? "error" : "ok")">
                    @(HasNonAscii(storagePath) ? "包含中文" : "正常")
                </span>
            </div>
            <div class="path-edit">
                <Input Value="@storagePath" ReadOnly/>
                <Button Icon="@IconType.Outline.FolderOpen" OnClick="PickStorageFolderAsync"></Button>
            </div>
        </div>

        <div class="path-item">
            <div class="path-header">
                <span class="path-label">临时文件路径</span>
                <span class="path-status @(HasNonAscii(tempPath) ? "error" : "ok")">
                    @(HasNonAscii(tempPath) ? "包含中文" : "正常")
                </span>
            </div>
            <div class="path-edit">
                <Input Value="@tempPath" ReadOnly/>
                <Button Icon="@IconType.Outline.FolderOpen" OnClick="PickTempFolderAsync"></Button>
            </div>
        </div>

    </div>

    <div class="step-actions">
        <Button Size="@ButtonSize.Large" OnClick="@OnPrev">
            <Icon Type="@IconType.Outline.ArrowLeft"/>
            上一步
        </Button>
        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" Disabled="@hasNonAsciiPath" OnClick="@OnNext">
            下一步
            <Icon Type="@IconType.Outline.ArrowRight"/>
        </Button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnPrevStep { get; set; }
    [Parameter] public EventCallback OnNextStep { get; set; }

    string runtimePath = "";
    string storagePath = "";
    string tempPath = "";
    bool hasNonAsciiPath = false;

    protected override void OnInitialized()
    {
        LoadPaths();
    }

    void LoadPaths()
    {
        runtimePath = AlifePath.RuntimeFolderPath;
        storagePath = AlifePath.StorageFolderPath;
        tempPath = AlifePath.TempFolderPath;

        CheckAllPaths();
    }

    void CheckAllPaths()
    {
        hasNonAsciiPath = HasNonAscii(runtimePath) || HasNonAscii(storagePath);
    }

    static bool HasNonAscii(string path)
    {
        return path.Any(c => c > 127);
    }

    async Task PickRuntimeFolderAsync()
    {
        string? result = await PickFolderAsync();
        if (string.IsNullOrWhiteSpace(result))
            return;

        AlifeClient.SetRuntimeFolderPath(result);
        runtimePath = result;
        CheckAllPaths();
    }

    async Task PickStorageFolderAsync()
    {
        string? result = await PickFolderAsync();
        if (string.IsNullOrWhiteSpace(result))
            return;

        AlifeClient.SetStorageFolderPath(result);
        storagePath = result;
        CheckAllPaths();
    }

    async Task PickTempFolderAsync()
    {
        string? result = await PickFolderAsync();
        if (string.IsNullOrWhiteSpace(result))
            return;

        AlifeClient.SetTempFolderPath(result);
        tempPath = result;
        CheckAllPaths();
    }

    async Task<string?> PickFolderAsync()
    {
        try
        {
            return await AlifeApplication.SelectFolderAsync();
        }
        catch (Exception e)
        {
            await NotificationService.Error(new NotificationConfig { Message = e.Message });
            return null;
        }
    }

    async Task OnPrev()
    {
        await OnPrevStep.InvokeAsync();
    }
    async Task OnNext()
    {
        await OnNextStep.InvokeAsync();
    }
}

<style>
    .step-content {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .step-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    .step-title {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 700;
        color: var(--alife-text);
        text-align: center;
    }

    .step-desc {
        margin: 0 0 20px;
        font-size: 13px;
        color: var(--alife-text-tertiary);
        text-align: center;
    }

    .path-error {
        margin-bottom: 12px;
        padding: 10px 12px;
        background: var(--alife-error-bg);
        border: 1px solid var(--alife-error-border);
        border-radius: 8px;
        font-size: 12px;
        color: var(--alife-error);
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .path-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 16px;
    }

    .path-item {
        padding: 12px;
        background: var(--alife-bg-subtle);
        border-radius: 8px;
        border: 1px solid var(--alife-border);
    }

    .path-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 4px;
    }

    .path-label {
        font-weight: 500;
        font-size: 13px;
        color: var(--alife-text);
    }

    .path-status {
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .path-status.ok {
        background: var(--alife-success-bg);
        color: var(--alife-success);
        border: 1px solid var(--alife-success-border);
    }

    .path-status.error {
        background: var(--alife-error-bg);
        color: var(--alife-error);
        border: 1px solid var(--alife-error-border);
    }

    .path-edit {
        display: flex;
        gap: 8px;
        margin-top: 8px;
    }

    .path-edit .ant-input {
        flex: 1;
    }

    .step-actions {
        display: flex;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 16px;
        gap: 12px;
    }
</style>
