
@page "/system"
@implements IDisposable
@using System.Reflection
@using System.Runtime.Loader

<div
    style="height: calc(100vh - 24px); margin: 12px; overflow: hidden; display: flex; flex-direction: column; background: #fff; border-radius: 8px; border: 1px solid #f0f0f0; animation: fadeIn 0.5s ease-out;">
    <div
        style="padding: 16px; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
        <Title Level="3" Style="margin: 0;">系统管理中心</Title>
    </div>

    <div style="flex: 1; overflow: hidden;">
        <Tabs @bind-ActiveKey="activeKey" TabPosition="@TabPosition.Left" Style="height: 100%;">
            @foreach (var item in ScanMenuItems())
            {
                <TabPane Key="@item.Key">
                    <TabTemplate>
                        <Flex Direction="@FlexDirection.Vertical" Align="@FlexAlign.Center" Gap="@("4")">
                            <Icon Type="@item.IconType"/>
                            <span style="font-size: 12px">@item.Name</span>
                        </Flex>
                    </TabTemplate>
                    <ChildContent>
                        <DynamicComponent Type="@item.ContentType"/>
                    </ChildContent>
                </TabPane>
            }
        </Tabs>
    </div>
</div>

<style>
    .ant-tabs-content-holder {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .ant-tabs-content {
        height: 100%;
    }

    .ant-tabs-tabpane {
        height: 100%;
        overflow: hidden;
    }
</style>

@code {
    string activeKey = "overview";

    /// <summary>菜单项快照（仅本界面消费，无需独立服务）。</summary>
    sealed record MenuItem(string Key, string Name, string IconType, Type ContentType, int Order);

    /// <summary>
    /// 扫描所有已加载程序集中标记了 SystemMenuAttribute 的组件类型，按 Order 排序。
    /// 扫描源用 AssemblyLoadContext.All：内置在 Default 上下文，插件在各自独立上下文，仅扫 AppDomain 会漏插件程序集。
    /// </summary>
    IReadOnlyList<MenuItem> ScanMenuItems()
    {
        List<MenuItem> items = new();
        HashSet<Assembly> visited = new();

        foreach (AssemblyLoadContext context in AssemblyLoadContext.All)
        {
            foreach (Assembly assembly in context.Assemblies)
            {
                if (!visited.Add(assembly))
                    continue;

                Type[] types;
                try
                {
                    types = assembly.GetTypes();
                }
                catch (ReflectionTypeLoadException)
                {
                    continue;
                }

                foreach (Type type in types)
                {
                    SystemMenuAttribute? attribute = type.GetCustomAttribute<SystemMenuAttribute>();
                    if (attribute == null)
                        continue;

                    items.Add(new MenuItem(
                        attribute.Key,
                        attribute.Name,
                        attribute.IconType,
                        type,
                        attribute.Order));
                }
            }
        }

        return items
            .OrderBy(item => item.Order)
            .ThenBy(item => item.Key, StringComparer.Ordinal)
            .ToList();
    }

    protected override void OnInitialized()
    {
        ClientNavigation.RegisterNavigator(OnNavigationRequested);
    }
    public void Dispose()
    {
        ClientNavigation.UnregisterNavigator(OnNavigationRequested);
    }

    void OnNavigationRequested(string path)
    {
        activeKey = path;
        InvokeAsync(StateHasChanged);
    }
}
