
@page "/system"
@implements IDisposable
@inject UIAttributeSystem UIAttributeSystem

<div class="alife-shell alife-shell-col workspace-fade">
    <div class="alife-shell-head">
        <div>
            <div class="alife-page-title">系统管理中心</div>
            <div class="alife-page-sub">配置、镜像、插件与界面开关</div>
        </div>
    </div>

    <div class="alife-shell-body">
        @* 菜单集合变化时重建 Tabs：AntDesign 的 Tabs 按面板序号记忆当前面板，增删面板会让它和 ActiveKey 错位 *@
        <Tabs @key="@tabsKey" @bind-ActiveKey="activeKey" TabPosition="@TabPosition.Left" Style="height: 100%;">
            @foreach (MenuItem item in menuItems)
            {
                <TabPane Key="@UIAttribute.IdentityOf(item.ComponentType)">
                    <TabTemplate>
                        <Flex Direction="@FlexDirection.Vertical" Align="@FlexAlign.Center" Gap="@("4")">
                            <Icon Type="@item.Menu.IconType"/>
                            <span style="font-size: 12px">@item.Menu.Name</span>
                        </Flex>
                    </TabTemplate>
                    <ChildContent>
                        <PluginErrorBoundary @key="@(UIAttribute.IdentityOf(item.ComponentType) + "#" + boundaryRevision)">
                            <ChildContent>
                                <DynamicComponent Type="@item.ComponentType"/>
                            </ChildContent>
                            <ErrorContent Context="ex">
                                <PluginErrorPanel Value="ex" OnRetry="@(() => boundaryRevision++)"/>
                            </ErrorContent>
                        </PluginErrorBoundary>
                    </ChildContent>
                </TabPane>
            }
        </Tabs>
    </div>
</div>

<style>
    .workspace-fade {
        animation: workspace-fade-in 0.35s ease-out;
    }

    @@keyframes workspace-fade-in {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    .ant-tabs-content-holder {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        /* flex 子项默认 min-width:auto 会被内容撑宽，导致内容溢出到窗口右侧 */
        min-width: 0;
    }

    .ant-tabs-content {
        height: 100%;
        min-width: 0;
    }

    .ant-tabs-tabpane {
        height: 100%;
        overflow: hidden;
        min-width: 0;
    }
</style>

@code {
    string activeKey = "overview";

    // 插件界面出错后“重新加载”时递增，用于强制重建错误边界与其内容
    int boundaryRevision;

    /// <summary>本页自己的菜单视图模型：键名、文字、图标、排序都是 SystemMenuAttribute 的字段，不在框架层统一。</summary>
    sealed record MenuItem(SystemMenuAttribute Menu, Type ComponentType);

    /// <summary>左侧菜单项快照（含插件菜单，已按开关过滤）。</summary>
    IReadOnlyList<MenuItem> menuItems = [];

    /// <summary>当前菜单键名集合，作为 Tabs 的 key：集合一变就重建，保证重建后仍停在 ActiveKey 上。</summary>
    string tabsKey = "";

    protected override void OnInitialized()
    {
        UIAttributeSystem.RegistrationsChanged += OnRegistrationsChanged;
        ClientNavigation.RegisterNavigator(OnNavigationRequested);
        RefreshMenuItems();
    }
    public void Dispose()
    {
        UIAttributeSystem.RegistrationsChanged -= OnRegistrationsChanged;
        ClientNavigation.UnregisterNavigator(OnNavigationRequested);
    }

    void OnRegistrationsChanged()
    {
        InvokeAsync(() =>
        {
            RefreshMenuItems();
            StateHasChanged();
        });
    }
    void OnNavigationRequested(Type target)
    {
        activeKey = UIAttribute.IdentityOf(target);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 重新取用菜单项。插件界面被关闭或卸载后，当前选中的菜单可能已经不存在，此时退回第一个可用菜单。
    /// </summary>
    void RefreshMenuItems()
    {
        menuItems = UIAttributeSystem.GetEnabledRegistrations<SystemMenuAttribute>()
            .Select(registration => new MenuItem((SystemMenuAttribute)registration.Attribute, registration.ComponentType))
            .OrderByDescending(item => item.Menu.Order)
            .ThenBy(item => UIAttribute.IdentityOf(item.ComponentType), StringComparer.Ordinal)
            .ToList();
        tabsKey = string.Join('|', menuItems.Select(item => UIAttribute.IdentityOf(item.ComponentType)));
        if (menuItems.Count == 0 || menuItems.Any(item => UIAttribute.IdentityOf(item.ComponentType) == activeKey))
            return;

        activeKey = UIAttribute.IdentityOf(menuItems[0].ComponentType);
    }
}
