@attribute [SystemMenu("插件市场", "shop", 40, Closable = false)]
@inject PluginSystem PluginSystem
@inject PluginCommunityService PluginCommunityService
@inject IJSRuntime JsRuntime
@inject StorageSystem StorageSystem
@inject INotificationService NotificationService
@implements IAsyncDisposable

<div class="alife-pane-fill">
    @* 标题栏 *@
    <div
        style="padding: 12px 16px; border-bottom: 1px solid var(--alife-border); display: flex; justify-content: space-between; align-items: center; background: var(--alife-bg-container);">
        <div style="display: flex; align-items: center; gap: 4px;">
            <Title Level="4" Style="margin: 0;">插件市场</Title>
            <Tooltip Title="使用插件前必读的安全须知">
                <Button Type="@ButtonType.Link" Icon="@IconType.Outline.InfoCircle"
                        OnClick="@(() => showNoticeModal = true)"
                        Class="@("notice-btn" + (showNoticeModal || hideNoticeAnimation ? " notice-paused" : ""))">
                    使用须知
                </Button>
            </Tooltip>
        </div>
        <Flex Gap="@("12")" Align="FlexAlign.Center">
            <AntDesign.Text Type="@TextElementType.Secondary" Style="flex-shrink: 0; white-space: nowrap;">范围</AntDesign.Text>
            <Select TItemValue="string" TItem="string" Value="@viewMode" ValueChanged="@(ChangeViewMode)" Style="width: 110px;">
                <SelectOption Value="@("all")" Label="全部插件"/>
                <SelectOption Value="@("installed")" Label="已安装"/>
                <SelectOption Value="@("local")" Label="本地插件"/>
            </Select>
            @if (viewMode != "local")
            {
                <Tooltip Placement="Placement.Bottom">
                    <TitleTemplate>
                        <div style="max-width: 300px; line-height: 1.6;">
                            <div>按时间：最新版本发布时间越新越靠前。</div>
                            <div>按点赞：按「赞 − 踩」排序，允许负数，同分按发布时间。</div>
                            <div>综合热度：(max(赞 − 踩, 0) + 1) ÷ (距最新版本天数 + 2)<sup>1.3</sup>，同分按发布时间。</div>
                            <div>排序使用社区数据快照；点击右侧重载按钮可刷新，GitHub 定时同步可能延迟。</div>
                        </div>
                    </TitleTemplate>
                    <ChildContent>
                        <AntDesign.Text Type="@TextElementType.Secondary" Style="flex-shrink: 0; white-space: nowrap; cursor: help;">排序</AntDesign.Text>
                    </ChildContent>
                </Tooltip>
                <Select TItemValue="string" TItem="string" Value="@sortMode" ValueChanged="@(ChangeSortMode)" Style="width: 120px;">
                    <SelectOption Value="@("time")" Label="按时间"/>
                    <SelectOption Value="@("votes")" Label="按点赞"/>
                    <SelectOption Value="@("hot")" Label="综合热度"/>
                </Select>
            }
            <Tooltip Title="重载插件市场">
                <Button Type="@ButtonType.Link" Icon="@IconType.Outline.CloudDownload" OnClick="@FetchOnlinePlugin"
                        Loading="isFetching"></Button>
            </Tooltip>
            <Tooltip Title="打开市场目录">
                <Button Type="@ButtonType.Link" Icon="@IconType.Outline.FolderOpen"
                        OnClick="@OpenPluginFolder"></Button>
            </Tooltip>
            <PluginUpgradeButton/>
            <Badge Count="@(cartItems.Count)">
                <Button Type="@ButtonType.Primary" Shape="@ButtonShape.Round"
                        OnClick="@(() => showCartModal = true)">
                    <WrenchIcon/>
                    插件操作
                </Button>
            </Badge>
        </Flex>
    </div>

    @* 搜索栏 *@
    <div style="padding: 8px 16px; background: var(--alife-bg-container); border-bottom: 1px solid var(--alife-border);">
        <div style="display: flex; gap: 8px; align-items: center;">
            <Search Placeholder="搜索插件名称、ID、描述..." @bind-Value="searchText" OnSearch="@(() => FilterPlugins())"
                    Style="flex: 1;"/>
            <AutoComplete @bind-Value="authorSearchText"
                          Options="authorOptions"
                          Placeholder="作者筛选"
                          Style="flex: 1; min-width: 180px;"
                          AllowClear="true"
                          AllowFilter="true"
                          OnSelectionChange="@((e) => {
                                                 authorSearchText = e.Value?.ToString() ?? "";
                                                 FilterPlugins();
                                             })"
                          OnInput="@(e => {
                                       authorSearchText = e.Value?.ToString() ?? "";
                                       FilterPlugins();
                                   })">
            </AutoComplete>
            <Select TItemValue="string" TItem="string"
                    DataSource="@platformOptions"
                    @bind-Value="platformFilter"
                    @bind-Value:after="OnPlatformFilterChanged"
                    Placeholder="平台筛选"
                    Style="flex: 1; min-width: 160px;"
                    AllowClear="true"
                    ValueOnClear="@("")">
            </Select>
            <AntDesign.Text Type="@TextElementType.Secondary" Style="flex-shrink: 0; white-space: nowrap;">
                共 @VisiblePluginCount 个
            </AntDesign.Text>
        </div>
        @if (allTags.Length > 0)
        {
            <div style="display: flex; gap: 6px; align-items: center; margin-top: 8px; flex-wrap: wrap;">
                <div
                    style="display: flex; flex-wrap: wrap; gap: 6px; max-height: 54px; overflow: hidden; flex: 1; min-width: 0;">
                    @foreach (var tag in allTags)
                    {
                        <Tag Color="@GetTagColor(tag)"
                             Style="@GetTagStyle(tag)"
                             OnClick="@(() => ToggleTag(tag))">
                            @GetTagPrefix(tag)@tag
                        </Tag>
                    }
                </div>
                <Popover Trigger="@([Trigger.Click])" Placement="@Placement.BottomRight">
                    <ChildContent>
                        <Tag Style="cursor: pointer; flex-shrink: 0;">
                            <Icon Type="@IconType.Outline.Search"/>
                        </Tag>
                    </ChildContent>
                    <ContentTemplate>
                        <div style="width: 200px;">
                            <Input Placeholder="搜索标签..." @bind-Value="tagSearchText" Size="@InputSize.Small"/>
                            <div style="max-height: 200px; overflow-y: auto; margin-top: 8px;">
                                @foreach (var tag in allTags.Where(t => string.IsNullOrEmpty(tagSearchText) || t.Contains(tagSearchText, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <Tag Color="@GetTagColor(tag)"
                                         Style="@GetTagStyle(tag)"
                                         OnClick="@(() => ToggleTag(tag))">
                                        @GetTagPrefix(tag)@tag
                                    </Tag>
                                }
                            </div>
                        </div>
                    </ContentTemplate>
                </Popover>
            </div>
        }
    </div>

    @* 插件列表 *@
    <div style="flex: 1; display: flex; flex-direction: column; min-height: 0; min-width: 0;">
        <div id="pluginMarketContainer"
             style="flex: 1; overflow: hidden; padding: 12px; min-width: 0; display: flex; align-items: center; justify-content: center;">
            @if (isFetching)
            {
                <Spin Tip="加载中..." Style="display: flex; justify-content: center; padding: 48px;"/>
            }
            else if (VisiblePluginCount == 0)
            {
                @if (allPlugins.Length == 0 && viewMode != "local")
                {
                    <div
                        style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; opacity: 0.6;">
                        <Icon Type="@IconType.Outline.CloudDownload" Style="font-size: 48px; margin-bottom: 16px;"/>
                        <AntDesign.Text Style="font-size: 14px; margin-bottom: 8px;">暂无插件信息</AntDesign.Text>
                        <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 12px;">
                            请点击右上角的「从云端拉取」按钮获取插件市场信息
                        </AntDesign.Text>
                    </div>
                }
                else
                {
                    <Empty Description="@(viewMode == "local" ? "没有未在市场注册的本地插件" : "未找到匹配的插件")"/>
                }
            }
            else
            {
                <div id="pluginMarketGrid"
                     style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; padding: 4px; justify-content: center; align-content: center; width: 100%;">
                    @if (viewMode == "local")
                    {
                        @foreach ((string pluginId, PluginManifest manifest) in pagedLocalPlugins)
                        {
                            <LocalPluginCardUI PluginId="@pluginId" Version="@manifest.Version"
                                               OnClick="@(() => inspectingLocalPluginId = pluginId)"/>
                        }
                    }
                    else
                    {
                        @foreach (PluginPackage plugin in pagedPlugins)
                        {
                            <PluginCardUI PluginPackage="plugin" IsInCart="@(cartItems.Any(p => p.Id == plugin.Id))"
                                          OnClick="@(() => OnShowDetail(plugin))"
                                          OnToggleCart="@((val) => ToggleCart(plugin, val))"/>
                        }
                    }
                </div>
            }
        </div>

        @if (!isFetching && VisiblePluginCount > 0 && TotalPages > 1)
        {
            <div
                style="flex-shrink: 0; display: flex; justify-content: center; padding: 12px; border-top: 1px solid var(--alife-border); background: var(--alife-bg-container);">
                <Pagination Current="currentPage" Total="VisiblePluginCount" PageSize="pageSize"
                            OnChange="@ChangePageIndex" ShowSizeChanger="false"/>
            </div>
        }
    </div>
</div>

@* 插件详情弹窗 *@
<Modal Title="@(inspectingPlugin?.Name ?? inspectingLocalPluginId ?? "")"
       Visible="@(inspectingPlugin != null || inspectingLocalPluginId != null)"
       OnCancel="@CloseDetail"
       Footer="null"
       Width="640"
       Centered="true"
       Style="top: 40px;">
    @if (inspectingPlugin != null)
    {
        <PluginDetailView PluginPackage="inspectingPlugin"
                          IsInCart="@(cartItems.Any(p => p.Id == inspectingPlugin?.Id))"
                          OnToggleCart="@((val) => ToggleCart(inspectingPlugin!, val))"
                          OnBack="@(() => inspectingPlugin = null)"/>
    }
    else if (inspectingLocalPluginId != null)
    {
        <div style="padding: 8px 0;">
            <Flex Align="FlexAlign.Center" Gap="@("12")">
                <Title Level="4" Style="margin: 0;">@inspectingLocalPluginId</Title>
                <Tag>本地</Tag>
            </Flex>
            <AntDesign.Text Type="@TextElementType.Secondary" Style="display: block; margin-top: 8px;">
                未在插件市场注册，当前版本：@InspectingLocalPlugin?.Version
            </AntDesign.Text>
            <Popconfirm Title="@($"确定要卸载 {inspectingLocalPluginId} 吗？")"
                        OkText="卸载" CancelText="取消"
                        OnConfirm="@UninstallLocalPlugin">
                <Button Danger Loading="isOperatingLocal" Style="margin-top: 20px;">
                    <Icon Type="@IconType.Outline.Delete"/>
                    卸载
                </Button>
            </Popconfirm>
        </div>
    }
</Modal>

@* 插件操作弹窗 *@
<Modal Title="@($"插件操作 ({cartItems.Count})")"
       Visible="showCartModal"
       OnCancel="@(() => showCartModal = false)"
       Footer="null"
       Width="480"
       Centered="true">
    <PluginCartView @bind-CartItems="cartItems" OnOperationComplete="@(() => showCartModal = false)"/>
</Modal>

<style>
    @@keyframes upgrade-bounce {
        0%, 100% {
            transform: rotate(0deg) scale(1);
        }
        20% {
            transform: rotate(-15deg) scale(1.25);
        }
        40% {
            transform: rotate(12deg) scale(1.15);
        }
        60% {
            transform: rotate(-10deg) scale(1.2);
        }
        80% {
            transform: rotate(8deg) scale(1.1);
        }
    }

    .notice-btn {
        color: var(--alife-warning) !important;
        animation: upgrade-bounce 1s ease-in-out infinite;
        transform-origin: center bottom;
    }

    .notice-btn:hover {
        animation: none;
        transform: scale(1.1);
    }

    .notice-paused {
        animation: none !important;
    }
</style>

@* 使用须知弹窗 *@
<Modal Title="使用须知"
       Visible="showNoticeModal"
       OnCancel="@(() => showNoticeModal = false)"
       Footer="null"
       Width="560"
       Centered="true">
    <div style="height: 420px; overflow-y: auto; line-height: 1.9; font-size: 14px;">
        <Alert Message="插件极其危险"
               Description="任何人都可以开发插件，因此要小心存在不法分子的情况。优先选择熟知，来源可信，结构干净的插件。同时，使用前一定要先让 AI 分析其源码，然后再谨慎使用。如果遇到有问题的插件，请及时在 Github 页或用其他途径向官方反馈。"
               Type="@AlertType.Error" ShowIcon="true" Style="margin-bottom: 16px;"/>
        <Divider Style="margin: 16px 0;"/>
        <div style="padding: 4px 0;">
            <div style="font-weight: 600; font-size: 15px; margin-bottom: 8px;">自己开发和贡献插件</div>
            <div style="color: var(--alife-text-secondary);">
                如果想自己开发和贡献插件，请参考：
                <br/>
                <a href="https://github.com/BDFFZI/Alife#-%E6%8F%92%E4%BB%B6%E5%BC%80%E5%8F%91-plugin-development"
                   target="_blank" style="color: var(--alife-primary); word-break: break-all;">
                    https://github.com/BDFFZI/Alife#-插件开发-plugin-development
                </a>
            </div>
        </div>
        <Divider Style="margin: 16px 0;"/>
        <Checkbox @bind-Value="hideNoticeAnimation" OnChange="@OnHideNoticeAnimationChanged"
                  Style="color: var(--alife-text-secondary);">
            我已知晓，不再提醒
        </Checkbox>
    </div>
    <div style="display: flex; justify-content: flex-end; padding-top: 12px; border-top: 1px solid var(--alife-border);">
        <Button Type="@ButtonType.Primary" OnClick="@(() => showNoticeModal = false)">我知道了</Button>
    </div>
</Modal>

<ErrorWindowUI @bind-Value="@operException"/>

@code {
    const string UnknownPlatform = "未知";
    bool isFetching;
    bool isOperatingLocal;
    Exception? operException;
    PluginPackage? inspectingPlugin;
    string? inspectingLocalPluginId;
    DotNetObjectReference<PluginMarketTab>? dotnetRef;

    //筛选输入条件
    string viewMode = "all";
    string sortMode = "time";
    string searchText = "";
    string authorSearchText = "";
    string platformFilter = "";
    readonly Dictionary<string, bool> selectedTags = []; // true=include, false=exclude
    string tagSearchText = "";
    int currentPage = 1;
    int pageSize = 12;

    //筛选源和结果
    string[] allTags = [];
    string[] authorOptions = [];
    string[] platformOptions = [];
    int VisiblePluginCount => viewMode == "local" ? filteredLocalPlugins.Length : filteredPlugins.Length;
    int TotalPages => (int)Math.Ceiling(VisiblePluginCount / (double)pageSize);
    PluginPackage[] allPlugins = [];
    PluginPackage[] filteredPlugins = [];
    PluginPackage[] pagedPlugins = [];
    KeyValuePair<string, PluginManifest>[] allLocalPlugins = [];
    KeyValuePair<string, PluginManifest>[] filteredLocalPlugins = [];
    KeyValuePair<string, PluginManifest>[] pagedLocalPlugins = [];
    PluginManifest? InspectingLocalPlugin =>
        inspectingLocalPluginId != null &&
        PluginSystem.GetAllLocalPlugins().TryGetValue(inspectingLocalPluginId, out PluginManifest manifest)
            ? manifest
            : null;

    List<PluginPackage> cartItems = [];
    bool showCartModal;
    bool showNoticeModal;
    bool hideNoticeAnimation;

    protected override void OnInitialized()
    {
        hideNoticeAnimation = StorageSystem.GetObject("Settings/PluginNoticeConfig", new NoticeAnimationConfig())?.HideNoticeAnimation ?? false;
        sortMode = StorageSystem.GetObject("Settings/PluginMarketSort", "time") ?? "time";
        UpdatePluginOptions();
        PluginSystem.PluginSynced += OnPluginSynced;
        PluginCommunityService.SnapshotUpdated += OnCommunityUpdated;
        _ = PluginCommunityService.RefreshSnapshotAsync();
    }
    public async ValueTask DisposeAsync()
    {
        PluginSystem.PluginSynced -= OnPluginSynced;
        PluginCommunityService.SnapshotUpdated -= OnCommunityUpdated;
        await JsRuntime.InvokeVoidAsync("unwatchPluginMarketResize");
        dotnetRef?.Dispose();
    }

    void OnPluginSynced()
    {
        UpdatePluginOptions();
    }
    void OnCommunityUpdated()
    {
        _ = InvokeAsync(UpdatePluginOptions);
    }
    void UpdatePluginOptions()
    {
        if (viewMode == "local")
        {
            IReadOnlyDictionary<string, PluginPackage> marketPlugins = PluginSystem.GetAllOnlinePlugins();
            allPlugins = [];
            allLocalPlugins = PluginSystem.GetAllLocalPlugins()
                .Where(pair => marketPlugins.ContainsKey(pair.Key) == false)
                .OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
                .ToArray();
        }
        else
        {
            allLocalPlugins = [];
            IEnumerable<PluginPackage> candidatePlugins = PluginSystem.GetAllOnlinePlugins().Values
                .Where(package => package.Releases != null && package.Releases.Count != 0);
            IEnumerable<PluginPackage> onlinePlugins = sortMode switch
            {
                "votes" => candidatePlugins
                    .OrderByDescending(plugin => GetNetVotes(plugin.Id))
                    .ThenByDescending(GetLatestReleaseDate),
                "hot" => candidatePlugins
                    .OrderByDescending(GetHotScore)
                    .ThenByDescending(GetLatestReleaseDate),
                _ => candidatePlugins.OrderByDescending(GetLatestReleaseDate)
            };

            if (viewMode == "installed")
            {
                IReadOnlyDictionary<string, PluginManifest> installed = PluginSystem.GetAllLocalPlugins();
                allPlugins = onlinePlugins
                    .Where(p => installed.ContainsKey(p.Id))
                    .ToArray();
            }
            else
            {
                allPlugins = onlinePlugins.ToArray();
            }
        }

        allTags = allPlugins
            .Where(p => p.Tags != null)
            .SelectMany(p => p.Tags!)
            .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .ToArray();

        authorOptions = allPlugins
            .Select(p => p.Author)
            .Where(p => !string.IsNullOrEmpty(p))
            .GroupBy(author => author, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .ToArray();

        platformOptions = allPlugins
            .SelectMany(GetPlatformCategories)
            .GroupBy(platform => platform, StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key == UnknownPlatform ? 1 : 0)
            .ThenBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(g => g.Key)
            .ToArray();

        if (!string.IsNullOrEmpty(platformFilter) &&
            !platformOptions.Contains(platformFilter, StringComparer.OrdinalIgnoreCase))
            platformFilter = "";

        foreach (var key in selectedTags.Keys.Where(k => !allTags.Contains(k, StringComparer.OrdinalIgnoreCase)).ToList())
            selectedTags.Remove(key);

        FilterPlugins();
    }
    static DateTime GetLatestReleaseDate(PluginPackage plugin) => plugin.Releases!.Max(pair => pair.Value.Date);
    double GetHotScore(PluginPackage plugin)
    {
        double ageDays = (DateTime.Now - GetLatestReleaseDate(plugin)).TotalDays;
        int netVotes = Math.Max(GetNetVotes(plugin.Id), 0);
        return (netVotes + 1) / Math.Pow(ageDays + 2, 1.3);
    }
    int GetNetVotes(string pluginId) =>
        PluginCommunityService.GetUpVotes(pluginId) -
        PluginCommunityService.GetDownVotes(pluginId);
    static IEnumerable<string> GetPlatformCategories(PluginPackage package)
    {
        string[] platforms = package.Platforms?
            .Where(platform => !string.IsNullOrWhiteSpace(platform))
            .Select(platform => platform.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

        return platforms.Length == 0 ? [UnknownPlatform] : platforms;
    }
    void FilterPlugins(bool resetPage = true)
    {
        if (viewMode == "local")
        {
            IEnumerable<KeyValuePair<string, PluginManifest>> localResult = allLocalPlugins;
            if (!string.IsNullOrWhiteSpace(searchText))
                localResult = localResult.Where(pair => pair.Key.Contains(searchText, StringComparison.OrdinalIgnoreCase));
            filteredLocalPlugins = localResult.ToArray();
        }
        else
        {
            IEnumerable<PluginPackage> result = allPlugins;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                result = result.Where(p =>
                    p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    p.Id.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    p.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(authorSearchText))
            {
                result = result.Where(p =>
                    p.Author.Contains(authorSearchText, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrEmpty(platformFilter))
            {
                result = result.Where(p =>
                    GetPlatformCategories(p).Contains(platformFilter, StringComparer.OrdinalIgnoreCase));
            }

            if (selectedTags.Any())
            {
                var includeTags = selectedTags.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
                var excludeTags = selectedTags.Where(kv => !kv.Value).Select(kv => kv.Key).ToList();

                if (includeTags.Any())
                    result = result.Where(p => p.Tags != null && includeTags.All(t => p.Tags.Contains(t, StringComparer.OrdinalIgnoreCase)));
                if (excludeTags.Any())
                    result = result.Where(p => p.Tags == null || !excludeTags.Any(t => p.Tags.Contains(t, StringComparer.OrdinalIgnoreCase)));
            }

            filteredPlugins = result.ToArray();
        }

        if (resetPage)
            currentPage = 1;

        PagePlugins();
    }
    void PagePlugins()
    {
        if (viewMode == "local")
        {
            pagedLocalPlugins = filteredLocalPlugins
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToArray();
        }
        else
        {
            pagedPlugins = filteredPlugins
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToArray();
        }

        InvokeAsync(StateHasChanged);
    }

    class Dimensions
    {
        public int Width { get; init; }
        public int Height { get; init; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        const string JsHelpers =
            "window.getPluginMarketDimensions = () => {" +
            "    const container = document.getElementById('pluginMarketContainer');" +
            "    if (!container) return { width: 0, height: 0 };" +
            "    return { width: container.clientWidth, height: container.clientHeight };" +
            "};" +
            "window._pluginMarketResizeObserver = null;" +
            "window.watchPluginMarketResize = (dotnetRef) => {" +
            "    window.unwatchPluginMarketResize();" +
            "    const container = document.getElementById('pluginMarketContainer');" +
            "    if (!container) return;" +
            "    let debounceTimer = null;" +
            "    window._pluginMarketResizeObserver = new ResizeObserver((entries) => {" +
            "        if (debounceTimer) clearTimeout(debounceTimer);" +
            "        debounceTimer = setTimeout(() => {" +
            "            const entry = entries[0];" +
            "            if (entry) {" +
            "                const { width, height } = entry.contentRect;" +
            "                dotnetRef.invokeMethodAsync('OnContainerResized', Math.round(width), Math.round(height));" +
            "            }" +
            "        }, 100);" +
            "    });" +
            "    window._pluginMarketResizeObserver.observe(container);" +
            "};" +
            "window.unwatchPluginMarketResize = () => {" +
            "    if (window._pluginMarketResizeObserver) {" +
            "        window._pluginMarketResizeObserver.disconnect();" +
            "        window._pluginMarketResizeObserver = null;" +
            "    }" +
            "};";
        await JsRuntime.InvokeVoidAsync("eval", JsHelpers);

        dotnetRef = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("watchPluginMarketResize", dotnetRef);

        var dimensions = await JsRuntime.InvokeAsync<Dimensions>("getPluginMarketDimensions");
        if (dimensions is { Width: > 0, Height: > 0 })
            ApplyPageSize(dimensions.Width, dimensions.Height);
    }
    [JSInvokable]
    public void OnContainerResized(int width, int height)
    {
        if (width > 0 && height > 0)
            ApplyPageSize(width, height);
    }
    void ApplyPageSize(int containerWidth, int containerHeight)
    {
        int newPageSize = CalculatePageSize(containerWidth, containerHeight);
        if (newPageSize != pageSize && newPageSize > 0)
        {
            pageSize = newPageSize;
            int newTotalPages = (int)Math.Ceiling(VisiblePluginCount / (double)pageSize);
            if (currentPage > newTotalPages && newTotalPages > 0)
                currentPage = newTotalPages;
            PagePlugins();
            StateHasChanged();
        }

        int CalculatePageSize(int containerWidth, int containerHeight)
        {
            const int CardMinWidth = 220;
            const int CardHeight = 100;
            const int Gap = 12;
            const int Padding = 24;

            int columns = Math.Max(1, (containerWidth - Padding + Gap) / (CardMinWidth + Gap));
            int rows = Math.Max(1, (containerHeight - Padding + Gap) / (CardHeight + Gap));

            return columns * rows;
        }
    }

    async Task FetchOnlinePlugin()
    {
        if (isFetching)
            return;

        isFetching = true;
        StateHasChanged();

        try
        {
            await PluginSystem.SyncOnlinePluginPackages();
            await PluginCommunityService.RefreshSnapshotAsync();
            await PluginSystem.SyncLocalPluginEnvironment();
        }
        catch (Exception e)
        {
            operException = e;
            StateHasChanged();
        }

        isFetching = false;
        StateHasChanged();
    }

    #region 页面功能回调

    void OpenPluginFolder()
    {
        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo {
            FileName = PluginSystem.PluginMarket.PluginPackagesCacheDirectory,
            UseShellExecute = true
        });
    }
    void ChangeViewMode(string value)
    {
        viewMode = value;
        UpdatePluginOptions();
    }
    void ChangeSortMode(string value)
    {
        sortMode = value;
        StorageSystem.SetObject("Settings/PluginMarketSort", value);
        UpdatePluginOptions();
    }
    void OnPlatformFilterChanged()
    {
        FilterPlugins();
    }
    void ChangePageIndex(PaginationEventArgs args)
    {
        currentPage = args.Page;
        PagePlugins();
    }
    void CloseDetail()
    {
        inspectingPlugin = null;
        inspectingLocalPluginId = null;
    }
    async Task UninstallLocalPlugin()
    {
        string? pluginId = inspectingLocalPluginId;
        if (pluginId == null || isOperatingLocal)
            return;

        isOperatingLocal = true;
        operException = null;
        StateHasChanged();

        try
        {
            await PluginSystem.PluginMarket.UninstallPlugins(pluginId);
            await PluginSystem.SyncLocalPluginEnvironment();
            inspectingLocalPluginId = null;
            _ = NotificationService.Success(new NotificationConfig { Message = $"已卸载 {pluginId}" });
        }
        catch (Exception ex)
        {
            operException = ex;
        }
        finally
        {
            isOperatingLocal = false;
            StateHasChanged();
        }
    }

    void OnHideNoticeAnimationChanged(bool checkedValue)
    {
        var config = StorageSystem.GetObject("Settings/PluginNoticeConfig", new NoticeAnimationConfig()) ?? new NoticeAnimationConfig();
        config.HideNoticeAnimation = hideNoticeAnimation;
        StorageSystem.SetObject("Settings/PluginNoticeConfig", config);
        StateHasChanged();
    }

    #endregion

    class NoticeAnimationConfig
    {
        public bool HideNoticeAnimation { get; set; }
    }

    #region 插件选项回调

    void ToggleCart(PluginPackage plugin, bool addToCart)
    {
        if (addToCart)
        {
            if (cartItems.All(p => p.Id != plugin.Id))
                cartItems.Add(plugin);
        }
        else
        {
            cartItems.RemoveAll(p => p.Id == plugin.Id);
        }
        StateHasChanged();
    }
    void OnShowDetail(PluginPackage pluginPackage)
    {
        inspectingPlugin = pluginPackage;
    }

    #endregion

    readonly string[] tagColorPool = ["#f50", "#2db7f5", "#87d068", "#108ee9", "#f56a00", "#722ed1", "#eb2f96", "#52c41a", "#1890ff", "#faad14"];
    string GetTagColor(string tag)
    {
        if (!selectedTags.TryGetValue(tag, out var mode))
            return "";
        return mode
            ? tagColorPool[Math.Abs(tag.GetHashCode()) % tagColorPool.Length]
            : "#ff4d4f";
    }
    string GetTagStyle(string tag)
    {
        if (!selectedTags.TryGetValue(tag, out var mode))
            return "cursor: pointer; border: 1px dashed var(--alife-border-strong); background: var(--alife-bg-subtle);";
        if (mode)
            return "cursor: pointer;";
        return "cursor: pointer; text-decoration: line-through;";
    }
    string GetTagPrefix(string tag)
    {
        if (selectedTags.TryGetValue(tag, out var mode) && !mode)
            return "✕ ";
        return "";
    }
    void ToggleTag(string tag)
    {
        if (!selectedTags.TryGetValue(tag, out var mode))
            selectedTags[tag] = true; // not selected → include
        else if (mode)
            selectedTags[tag] = false; // include → exclude
        else
            selectedTags.Remove(tag); // exclude → not selected
        FilterPlugins();
    }

}
