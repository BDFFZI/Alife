@attribute [SystemMenu("系统配置","home",60)]
@inject INotificationService NotificationService
@inject IAlifeClient AlifeClient
@inject IAlifeApplication AlifeApplication
@inject AlifeClientConfig AlifeClientConfig
@inject UIThemeSystem UITheme

<div class="alife-page">
    <div class="alife-page-head">
        <div>
            <div class="alife-page-title">系统配置</div>
            <div class="alife-page-sub">目录、启动项与外观。路径与启动配置修改后需重启客户端。</div>
        </div>
    </div>

    <div class="alife-field">
        <div class="alife-field-head"><span class="alife-field-title">数据存储目录 (Storage)</span></div>
        <div class="alife-field-row">
            <Input @bind-Value="storageFolderPath" Style="flex: 1;" ReadOnly/>
            <Button Icon="@IconType.Outline.FolderOpen" OnClick="@PickStorageFolderAsync"></Button>
        </div>
        <span class="alife-hint">存放角色数据、对话记录等用户数据。重启后生效。</span>
    </div>

    <div class="alife-field">
        <div class="alife-field-head"><span class="alife-field-title">运行时目录 (Runtime)</span></div>
        <div class="alife-field-row">
            <Input @bind-Value="runtimeFolderPath" Style="flex: 1;" ReadOnly/>
            <Button Icon="@IconType.Outline.FolderOpen" OnClick="@PickRuntimeFolderAsync"></Button>
        </div>
        <span class="alife-hint">存放浏览器缓存、运行环境等可再生数据。重启后生效。</span>
    </div>

    <div class="alife-field">
        <div class="alife-field-head"><span class="alife-field-title">临时目录 (Temp)</span></div>
        <div class="alife-field-row">
            <Input @bind-Value="tempFolderPath" Style="flex: 1;" ReadOnly/>
            <Button Icon="@IconType.Outline.FolderOpen" OnClick="@PickTempFolderAsync"></Button>
        </div>
        <span class="alife-hint">存放运行期间的临时文件，启动时会清空，请选择空目录。重启后生效。</span>
    </div>

    <div class="alife-field">
        <div class="alife-field-head">
            <span class="alife-field-title">开机自启</span>
            <Switch @key="autoStartRevision" Checked="autoStartOnBoot" CheckedChanged="@OnAutoStartChanged"/>
        </div>
        <span class="alife-hint">开启后，系统启动时自动运行 Alife。</span>
    </div>

    <div class="alife-field">
        <div class="alife-field-head">
            <span class="alife-field-title">黑夜模式</span>
            <Switch Value="@UITheme.IsDark" ValueChanged="@OnDarkModeChanged"/>
        </div>
        <span class="alife-hint">界面配色切换为深色，立即生效并记住偏好。</span>
    </div>

    <div class="alife-divider"></div>

    <div class="alife-field">
        <div class="alife-section-title">启动配置</div>
        <span class="alife-hint">控制客户端启动时执行的初始化步骤，按需调整后可加速启动速度。重启后生效。</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 20px; margin: 16px 0 24px 0;">
        <div>
            <div class="alife-field-head">
                <span class="alife-field-title">拉取云端信息</span>
                <Switch Checked="@AlifeClientConfig.FetchOnlineInfo" CheckedChanged="OnFetchOnlineInfoChanged"/>
            </div>
            <span class="alife-hint">启动时从云端拉取客户端版本和插件清单。部分老插件依赖云端清单判断环境依赖，若已确保插件环境正常，可以关闭。</span>
        </div>

        <div>
            <div class="alife-field-head">
                <span class="alife-field-title">加载本地插件</span>
                <Switch Checked="@AlifeClientConfig.LoadLocalPlugins" CheckedChanged="OnLoadLocalPluginsChanged"/>
            </div>
            <span class="alife-hint">启动时加载插件文件夹中的插件。若所有功能都已内置在客户端中，可以关闭。</span>
        </div>

        <div>
            <div class="alife-field-head">
                <span class="alife-field-title">检查插件环境</span>
                <Switch Checked="@AlifeClientConfig.EnsureEnvironment"
                        CheckedChanged="OnEnsureEnvironmentChanged"
                        Disabled="@(!AlifeClientConfig.LoadLocalPlugins)"/>
            </div>
            <span class="alife-hint">启动时尝试补全插件环境，可确保环境完整，但会降低启动速度。环境出问题时仍可在插件环境页面手动重载。</span>
        </div>

        <div>
            <div class="alife-field-head">
                <span class="alife-field-title">启用 MCP 服务</span>
                <Switch Checked="@AlifeClientConfig.McpServer" CheckedChanged="OnMcpServerChanged"/>
            </div>
            <span class="alife-hint">开放 MCP 服务，让外部程序（或AI）可以调用 Alife 的系统能力。不需要此功能时可以关闭。</span>
        </div>

        <div>
            <div class="alife-field-head">
                <span class="alife-field-title">MCP 服务端口</span>
                <AntDesign.InputNumber TValue="int" Value="@AlifeClientConfig.McpServerPort"
                                       ValueChanged="OnMcpServerPortChanged"
                                       Min="1" Max="65535"
                                       Disabled="@(AlifeClientConfig.McpServer == false)"
                                       Style="width: 120px;"/>
            </div>
            <span class="alife-hint">MCP 服务监听的本地端口。仅在启用 MCP 服务时有效，修改端口后需同步修改外部程序的连接配置。</span>
        </div>
    </div>

    <div class="alife-divider"></div>

    <div class="alife-section-title" style="margin-bottom: 12px;">版本信息</div>
    <Descriptions Column="1" Size="@DescriptionsSize.Small" Bordered>
        <DescriptionsItem Title="当前版本">
            <Text Code Style="font-size: 12px;">v@(ClientUpgrade.CurrentVersion)</Text>
        </DescriptionsItem>
        @if (ClientUpgrade.NewVersion != null)
        {
            <DescriptionsItem Title="最新版本">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <Text Code Style="font-size: 12px; color: var(--alife-success);">v@(ClientUpgrade.NewVersion.Version)</Text>
                    @if (isUpgradeDownloading)
                    {
                        <Progress Percent="@upgradeDownloadProgress" Status="ProgressStatus.Active"
                                  Style="flex: 1;"></Progress>
                    }
                    else
                    {
                        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@StartClientUpdate">立即升级
                        </Button>
                    }
                </div>
            </DescriptionsItem>
        }
    </Descriptions>
    <div style="margin-top: 8px;">
        @if (isUpgradeChecking)
        {
            <span class="alife-hint">正在检查更新...</span>
        }
        else if (ClientUpgrade.NewVersion == null)
        {
            <Button Size="@ButtonSize.Small" OnClick="@CheckClientUpdate">检查更新</Button>
        }
    </div>
</div>

@code {
    bool isUpgradeChecking;
    bool isUpgradeDownloading;
    int upgradeDownloadProgress;

    //路径配置
    string storageFolderPath = AlifePath.StorageFolderPath;
    string runtimeFolderPath = AlifePath.RuntimeFolderPath;
    string tempFolderPath = AlifePath.TempFolderPath;
    //其他配置
    bool autoStartOnBoot;
    int autoStartRevision;

    protected override void OnInitialized()
    {
        autoStartOnBoot = AlifeClient.GetAutoStart();
    }

    void OnDarkModeChanged(bool value) => UITheme.SetDark(value);

    void OnFetchOnlineInfoChanged(bool value)
    {
        AlifeClientConfig.FetchOnlineInfo = value;
        SaveStartupConfig();
    }
    void OnLoadLocalPluginsChanged(bool value)
    {
        AlifeClientConfig.LoadLocalPlugins = value;
        SaveStartupConfig();
    }
    void OnEnsureEnvironmentChanged(bool value)
    {
        AlifeClientConfig.EnsureEnvironment = value;
        SaveStartupConfig();
    }
    void OnMcpServerChanged(bool value)
    {
        AlifeClientConfig.McpServer = value;
        SaveStartupConfig();
    }
    void OnMcpServerPortChanged(int value)
    {
        AlifeClientConfig.McpServerPort = value;
        SaveStartupConfig();
    }
    void SaveStartupConfig()
    {
        AlifeClientConfig.Save();
        _ = NotificationService.Success(new NotificationConfig { Message = "启动配置已保存！重启后生效喵~" });
    }

    async Task OnAutoStartChanged(bool value)
    {
        try
        {
            AlifeClient.SetAutoStart(value);
            autoStartOnBoot = AlifeClient.GetAutoStart();
            await NotificationService.Success(new NotificationConfig { Message = value ? "已开启开机自启" : "已关闭开机自启" });
        }
        catch (Exception error)
        {
            await NotificationService.Error(new NotificationConfig { Message = error.Message });
        }
        finally
        {
            autoStartRevision++;
        }
    }

    async Task CheckClientUpdate()
    {
        isUpgradeChecking = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await ClientUpgrade.FetchNewVersion();
            if (ClientUpgrade.NewVersion == null)
                _ = NotificationService.Success(new NotificationConfig { Message = "当前已是最新版本。" });
        }
        catch (Exception e)
        {
            await NotificationService.Error(new NotificationConfig {
                NotificationType = NotificationType.Error,
                Message = "检查更新失败。",
            });
            AlifeLog.LogError(e);
        }
        finally
        {
            isUpgradeChecking = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    async Task StartClientUpdate()
    {
        isUpgradeDownloading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await ClientUpgrade.InstallNewVersion(AlifeClient, progress => {
                upgradeDownloadProgress = progress;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception error)
        {
            await NotificationService.Error(new NotificationConfig { Message = error.Message });
        }
        finally
        {
            isUpgradeDownloading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task PickStorageFolderAsync()
    {
        string? result = await PickFolderAsync();
        if (string.IsNullOrWhiteSpace(result) is false)
        {
            storageFolderPath = result;
            AlifeClient.SetStorageFolderPath(storageFolderPath);
            _ = NotificationService.Success(new NotificationConfig { Message = "存储路径已保存！重启后生效喵~" });
        }
    }
    async Task PickRuntimeFolderAsync()
    {
        string? result = await PickFolderAsync();
        if (string.IsNullOrWhiteSpace(result) is false)
        {
            runtimeFolderPath = result;
            AlifeClient.SetRuntimeFolderPath(runtimeFolderPath);
            _ = NotificationService.Success(new NotificationConfig { Message = "运行时目录已保存！重启后生效喵~" });
        }
    }
    async Task PickTempFolderAsync()
    {
        string? result = await PickFolderAsync();
        if (string.IsNullOrWhiteSpace(result) is false)
        {
            tempFolderPath = result;
            AlifeClient.SetTempFolderPath(tempFolderPath);
            _ = NotificationService.Success(new NotificationConfig { Message = "临时目录已保存！重启后生效喵~" });
        }
    }
    async Task<string?> PickFolderAsync()
    {
        try
        {
            return await AlifeApplication.SelectFolderAsync();
        }
        catch (Exception error)
        {
            await NotificationService.Error(new NotificationConfig { Message = error.Message });
            return null;
        }
    }
}
