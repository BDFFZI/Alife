@page "/agent/{name}"
@inject CharacterSystem CharacterSystem
@inject ChatActivitySystem ChatActivitySystem
@inject ConfirmService ConfirmService
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject IAlifeApplication AlifeApplication
@inject UIAttributeSystem UIAttributeSystem
@using System.IO
@implements IDisposable

@if (character == null)
{
    <div class="workspace-loading">
        <Icon Type="@IconType.Outline.Loading" Style="font-size: 28px;"/>
        <span>正在寻找角色喵...</span>
    </div>
}
else
{
    <div class="alife-shell alife-shell-row">
        @* 角色侧边二级导航：身份信息 + 菜单 + 常用操作 *@
        <aside class="alife-pane-side">
            <div class="workspace-id">
                <Avatar Size="@AvatarSize.Large"
                        Style="background: var(--alife-primary); width: 56px; height: 56px; line-height: 56px; font-size: 22px;">
                    @(character.Name.FirstOrDefault())
                </Avatar>
                <div class="workspace-name">@character.Name</div>
                <div class="workspace-state">
                    <StatusDot Online="@(activity != null)"/>
                    <span>@(activity != null ? "正在运行" : "待机中")</span>
                </div>
            </div>

            @* 功能菜单：内置项与插件项都由 CharacterMenuAttribute 声明，本页只负责渲染 *@
            <div class="workspace-menu">
                <Menu Mode="@MenuMode.Inline" SelectedKeys="@(new[] { activeMenuKey })" Style="background: transparent;">
                    @foreach (MenuItem item in menuItems)
                    {
                        <MenuItem Key="@UIAttribute.IdentityOf(item.ComponentType)" OnClick="@(() => activeMenuKey = UIAttribute.IdentityOf(item.ComponentType))">
                            <Icon Type="@item.Menu.IconType"/>
                            <span>@item.Menu.Name</span>
                        </MenuItem>
                    }
                </Menu>
            </div>

            @* 常用功能快捷访问 *@
            <div class="workspace-actions">
                <Button Block Icon="@IconType.Outline.FolderOpen" OnClick="@(OpenStorageDirectory)">打开存储目录</Button>

                @if (activity == null)
                {
                    <Button Type="@ButtonType.Primary" Block OnClick="@(ActivateCharacter)">
                        激活角色
                    </Button>
                }
                else
                {
                    var isCancelled = activity.ChatBot.ChatBreakTokenSource.IsCancellationRequested;
                    <Button Danger Block Loading="@isStopping" Disabled="@isCancelled" OnClick="@(DeactivateCharacter)">
                        停止运行
                    </Button>
                    @if (isStopping && !isCancelled)
                    {
                        <Button Danger Block
                                OnClick="@(() => activity.ChatBot.ChatBreakTokenSource.Cancel())">
                            打断对话
                        </Button>
                    }
                }

                <Button Danger Block OnClick="@DeleteCharacter">删除角色</Button>
            </div>
        </aside>

        <div class="alife-pane-body" @key="@Name">
            @if (activeItem != null)
            {
                <PluginErrorBoundary @key="@(Name + UIAttribute.IdentityOf(activeItem.ComponentType) + "#" + boundaryRevision)">
                    <ChildContent>
                        <DynamicComponent Type="@activeItem.ComponentType"
                                          Parameters="@(MenuParameters())"/>
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <PluginErrorPanel Value="ex" OnRetry="@(() => boundaryRevision++)"/>
                    </ErrorContent>
                </PluginErrorBoundary>
            }
        </div>
    </div>
}

<style>
    .workspace-loading {
        height: calc(100vh - 24px);
        margin: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: var(--alife-text-tertiary);
    }

    .workspace-id {
        padding: 20px 16px;
        text-align: center;
        border-bottom: 1px solid var(--alife-border);
    }

    .workspace-name {
        margin-top: 10px;
        font-size: 16px;
        font-weight: 600;
        color: var(--alife-text);
        overflow-wrap: anywhere;
    }

    .workspace-state {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 8px;
        font-size: 12px;
        color: var(--alife-text-secondary);
    }

    .workspace-menu {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 8px 0;
    }

    .workspace-actions {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 16px;
        border-top: 1px solid var(--alife-border);
    }

    /* 内联菜单换成胶囊样式：侧栏已有分隔线，不需要 AntDesign 那条右侧竖线 */
    .workspace-menu .ant-menu-inline {
        border-right: none;
        background: transparent;
    }

    .workspace-menu .ant-menu-item {
        margin: 2px 8px;
        width: calc(100% - 16px);
        height: 36px;
        line-height: 36px;
        border-radius: var(--alife-radius-sm);
    }

    .workspace-menu .ant-menu-item::after {
        display: none;
    }

    .workspace-menu .ant-menu-item-selected {
        background: var(--alife-primary-bg);
        color: var(--alife-primary);
        font-weight: 600;
    }
</style>

@code {
    [Parameter] public string Name { get; set; } = "";

    Character? character;
    ChatActivity? activity;

    bool isStopping;
    int boundaryRevision;
    string activeMenuKey = "";

    /// <summary>本页自己的菜单视图模型：键名、文字、图标、排序都是 CharacterMenuAttribute 的字段，不在框架层统一。</summary>
    sealed record MenuItem(CharacterMenuAttribute Menu, Type ComponentType);

    /// <summary>角色菜单项（内置 + 插件，已按开关过滤）。</summary>
    IReadOnlyList<MenuItem> menuItems = [];

    MenuItem? activeItem => menuItems.FirstOrDefault(item => UIAttribute.IdentityOf(item.ComponentType) == activeMenuKey);

    protected override void OnInitialized()
    {
        ChatActivitySystem.Activated += OnChatActivityActivated;
        ChatActivitySystem.Deactivated += OnChatActivityDeactivated;
        ChatActivitySystem.Deactivating += OnChatActivityDeactivating;
        UIAttributeSystem.RegistrationsChanged += OnRegistrationsChanged;
        RefreshMenuItems();
    }
    protected override void OnParametersSet()
    {
        character = CharacterSystem.GetAllCharacters().FirstOrDefault(c => c.Name == Name);
        activity = character != null ? ChatActivitySystem.GetChatActivity(character) : null;
    }
    public void Dispose()
    {
        ChatActivitySystem.Activated -= OnChatActivityActivated;
        ChatActivitySystem.Deactivated -= OnChatActivityDeactivated;
        ChatActivitySystem.Deactivating -= OnChatActivityDeactivating;
        UIAttributeSystem.RegistrationsChanged -= OnRegistrationsChanged;
    }

    void OnRegistrationsChanged()
    {
        InvokeAsync(() =>
        {
            RefreshMenuItems();
            StateHasChanged();
        });
    }
    /// <summary>
    /// 重新取用菜单项。插件界面被关闭或卸载后，当前选中的菜单可能已经不存在，此时退回第一个可用菜单。
    /// </summary>
    void RefreshMenuItems()
    {
        menuItems = UIAttributeSystem.GetEnabledRegistrations<CharacterMenuAttribute>()
            .Select(registration => new MenuItem((CharacterMenuAttribute)registration.Attribute, registration.ComponentType))
            .OrderByDescending(item => item.Menu.Order)
            .ThenBy(item => UIAttribute.IdentityOf(item.ComponentType), StringComparer.Ordinal)
            .ToList();
        if (menuItems.Count == 0 || menuItems.Any(item => UIAttribute.IdentityOf(item.ComponentType) == activeMenuKey))
            return;

        activeMenuKey = UIAttribute.IdentityOf(menuItems[0].ComponentType);
    }
    /// <summary>
    /// 按 CharacterMenu 基类的约定喂给菜单内容组件的参数：DynamicComponent 只认 Parameters 字典，不接受同名属性。
    /// 渲染到此处时 character 必然存在（外层已按空角色分支）。
    /// </summary>
    Dictionary<string, object?> MenuParameters()
    {
        return new Dictionary<string, object?> {
            { "Character", character! },
            { "ChatActivity", activity },
        };
    }
    void OnChatActivityActivated(ChatActivity chatActivity)
    {
        if (chatActivity.Character != character)
            return;

        activity = chatActivity;
        InvokeAsync(StateHasChanged);
    }
    void OnChatActivityDeactivating(ChatActivity obj)
    {
        if (activity != obj)
            return;

        isStopping = true;
        InvokeAsync(StateHasChanged);
    }
    void OnChatActivityDeactivated(ChatActivity obj)
    {
        if (activity != obj)
            return;

        isStopping = false;
        activity = null;
        InvokeAsync(StateHasChanged);
    }

    async Task OpenStorageDirectory()
    {
        if (character == null)
            return;

        try
        {
            string path = Path.GetFullPath($"{AlifePath.StorageFolderPath}/{character.StorageKey}");
            await AlifeApplication.RevealFolderAsync(path);
        }
        catch (Exception ex)
        {
            await NotificationService.Error(new NotificationConfig { Message = "打开存储目录失败", Description = ex.Message });
        }
    }
    void ActivateCharacter()
    {
        if (character == null || activity != null)
            return;

        //角色设定直接绑在 Character 实例上，激活前落盘一次，避免未点“应用设定”的改动只留在内存里
        Task.Run(async () => {
            await CharacterSystem.SaveCharacter(character);
            await ChatActivitySystem.Activate(character);
        });
    }
    void DeactivateCharacter()
    {
        if (character == null || activity == null)
            return;

        Task.Run(() => ChatActivitySystem.Deactivate(character));
    }
    async Task DeleteCharacter()
    {
        if (character == null)
            return;

        ConfirmResult confirmResult = await ConfirmService.Show(
            $"确认要删除角色 [{character.Name}] 吗？此操作不可撤销！",
            "警告",
            ConfirmButtons.YesNo,
            ConfirmIcon.Warning);

        if (confirmResult == ConfirmResult.Yes)
        {
            if (activity != null)
                await ChatActivitySystem.Deactivate(character);

            CharacterSystem.DeleteCharacter(character);
            _ = NotificationService.Success(new NotificationConfig { Message = $"角色 [{character.Name}] 已删除喵。" });
            Navigation.NavigateTo("/system");
        }
    }
}
