@inherits CharacterMenu
@attribute [CharacterMenu("对话看板","comment",30)]
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject IAlifeApplication AlifeApplication

<div class="chat-panel">
    @* 顶部操作栏：前缀、条数上限、思考展开都直接读写客户端聊天状态 *@
    <div class="chat-toolbar">
        <span class="alife-label">消息前缀</span>
        <Input @bind-Value="ClientChatStatistics.MessageTag" Size="@InputSize.Small" Style="width: 180px;"/>
        <span class="alife-label">最大条数</span>
        <AntDesign.InputNumber @bind-Value="ClientChatStatistics.MaxMessageCount" Min="10" Max="10000"
                               Size="@InputSize.Small" Style="width: 88px;"/>
        <span class="alife-label">展开思考</span>
        <Switch Value="@ClientChatStatistics.ShowReasoning" ValueChanged="@OnShowReasoningChanged"/>
        <span class="alife-spacer"></span>
        <Button Type="@ButtonType.Link" Danger Icon="@IconType.Outline.Clear" OnClick="@OnClear">清理对话日志</Button>
    </div>

    @* 消息区：滚动贴底、回到底部浮标都由 alife-chat.js 接管 *@
    <div class="chat-body" id="chatBody">
        <div class="chat-stream" id="messageArea">
            @if (messages == null)
            {
                <Empty Style="margin-top: 80px" Description="@("消息存储不存在！")"/>
            }
            else if (messages.Count == 0)
            {
                <Empty Style="margin-top: 80px" Description="@("暂无聊天信息，开始对话吧喵！")"/>
            }
            else
            {
                @lock (messages)
                {
                    //用户消息的序号（第几轮）和列表下标不是一回事：
                    //列表是 [User1, AI1, User2, AI2]，点 User2 时下标是 2，但它是第 1 轮（0 起算）。
                    //框架按「第几条用户消息」定位，所以必须单独维护这个计数器。
                    int userTurnCounter = -1;

                    @for (int i = 0; i < messages.Count; i++)
                    {
                        ChatMessage message = messages[i];

                        //必须复制到局部变量：for 的 i 是共享变量，渲染完已经变成 Count，
                        //lambda 捕获它会传越界值。
                        int rowIndex = i;
                        if (message.IsUser) userTurnCounter++;
                        int userTurn = userTurnCounter;
                        <div class="chat-row @(message.IsUser ? "chat-row-user" : "")">
                            <div class="chat-bubble @(message.IsUser ? "chat-bubble-user" : "chat-bubble-ai")">
                                @if (!string.IsNullOrEmpty(message.Reasoning))
                                {
                                    <div class="chat-reasoning">
                                        <div class="chat-reasoning-title"
                                             @onclick="@(() => message.ReasoningExpanded = message.ReasoningExpanded == false)">
                                            <Icon Type="@(message.IsReasoning ? IconType.Outline.Loading : IconType.Outline.Bulb)"/>
                                            <span>思考过程</span>
                                            <span class="chat-reasoning-caret @(message.ReasoningExpanded ? "is-open" : "")">▼</span>
                                        </div>

                                        @if (message.ReasoningExpanded)
                                        {
                                            @if (!string.IsNullOrEmpty(message.ThinkingReason))
                                            {
                                                <div class="chat-reasoning-reason">思考原因：@message.ThinkingReason</div>
                                            }
                                            <div class="chat-reasoning-content">@message.Reasoning</div>
                                        }
                                    </div>
                                }
                                @if (message.IsUser && ReferenceEquals(message, editingMessage))
                                {
                                    <textarea class="chat-inline-edit" @bind="editingText" rows="3"
                                              @ref="inlineEditRef"></textarea>
                                    <div class="chat-inline-actions">
                                        <button type="button" class="chat-inline-cancel" @onclick="@CancelEdit">取消</button>
                                        <button type="button" class="chat-inline-confirm" @onclick="@ConfirmEdit">
                                            确定并重发
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="chat-text">@message.DisplayContent</div>
                                }
                                @if (message.IsInputting)
                                {
                                    <div class="chat-typing">
                                        <Icon Type="@IconType.Outline.Loading"/>
                                        <span>输入中</span>
                                    </div>
                                }
                            </div>

                            @* 每轮消息下方的操作条：hover 时才显现，和常见 Agent 一致 *@
                            @if (message.IsUser)
                            {
                                <div class="chat-msg-actions">
                                    <button type="button" title="编辑这条输入并重新发送"
                                            disabled="@isGenerating"
                                            @onclick="@(() => OnEditMessage(message, userTurn))">
                                        <Icon Type="@IconType.Outline.Edit"/>
                                    </button>
                                    <button type="button"
                                            title="回档到这里：保留这句输入，删掉之后的所有内容并重新回答"
                                            disabled="@isGenerating"
                                            @onclick="@(() => OnRollback(userTurn))">
                                        <Icon Type="@IconType.Outline.Rollback"/>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="chat-msg-actions @(message.IsInputting ? "chat-msg-actions-always" : "")">
                                    @if (rowIndex == messages.Count - 1)
                                    {
                                        @* 生成中给停止，生成完给重生。
                                           不要把 IsInputting 放进外层条件 —— 生成中正是最需要停止按钮的时候。 *@
                                        if (message.IsInputting || isGenerating)
                                        {
                                            <button type="button" title="停止生成"
                                                    @onclick="@OnStop">
                                                <Icon Type="@IconType.Outline.Pause"/>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" title="重新生成（这一版会保留，可左右切换回看）"
                                                    @onclick="@OnRegenerate">
                                                <Icon Type="@IconType.Outline.Reload"/>
                                            </button>
                                        }
                                    }

                                    @* 多版本导航：所有 AI 气泡都能切，历史版本不会丢 *@
                                    @if (message.CanSwitchVersion)
                                    {
                                        <button type="button" title="上一版"
                                                disabled="@(message.VersionIndex <= 0)"
                                                @onclick="@(() => SwitchVersion(message, message.VersionIndex - 1))">
                                            <Icon Type="@IconType.Outline.Left"/>
                                        </button>
                                        <span class="chat-version-label">
                                            @(message.VersionIndex + 1)/@message.Versions.Count
                                        </span>
                                        <button type="button" title="下一版"
                                                disabled="@(message.VersionIndex >= message.Versions.Count - 1)"
                                                @onclick="@(() => SwitchVersion(message, message.VersionIndex + 1))">
                                            <Icon Type="@IconType.Outline.Right"/>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            }
        </div>

        <button type="button" class="chat-jump" @onclick="@ScrollToLatestAsync">
            <Icon Type="@IconType.Outline.Down"/>
            <span>回到最新消息</span>
        </button>
    </div>

    @if (ChatActivity != null)
    {
        <div id="chatSplitter" class="chat-splitter"></div>

        <div class="chat-input-bar">
            <div class="chat-input-main">
                <TextArea Id="chatInput"
                          Class="chat-input"
                          Placeholder="@("输入消息... (Enter 发送，Shift+Enter 换行，Ctrl+V 粘贴文本或文件)")"
                          @bind-Value="inputText"
                          BindOnInput="true"
                          Rows="3"></TextArea>

                @if (isGenerating)
                {
                    <div class="chat-busy">
                        <Icon Type="@IconType.Outline.Loading"/>
                        <span>@(string.IsNullOrEmpty(occupiedReasonText) ? "对话占用中" : occupiedReasonText)</span>
                    </div>
                }
            </div>

            <div class="chat-input-actions">
                <Tooltip Title="@("上传文件")">
                    <Button Icon="@IconType.Outline.Upload" OnClick="@OnUploadFile"
                            Disabled="@isGenerating"/>
                </Tooltip>

                @* 发送 / 终止 同一位置切换：生成中时这里就是终止按钮，最不容易漏掉 *@
                @if (isGenerating)
                {
                    <Tooltip Title="@("中断当前生成")">
                        <Button Type="@ButtonType.Primary" Danger
                                Icon="@IconType.Outline.Pause"
                                OnClick="@OnStop">终止输出</Button>
                    </Tooltip>
                }
                else
                {
                    <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Send"
                            OnClick="@OnSendClickAsync">发送</Button>
                }
            </div>
        </div>
    }
</div>

<ErrorWindowUI @bind-Value="@chatException" Title="聊天出错喵！"/>

<style>
    .chat-panel {
        height: 100%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: var(--alife-bg-layout);
    }

    .chat-toolbar {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 8px 16px;
        background: var(--alife-bg-container);
        border-bottom: 1px solid var(--alife-border);
    }

    .chat-body {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
    }

    .chat-stream {
        flex: 1 1 auto;
        min-width: 0;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 20px 24px;
    }

    .chat-jump {
        position: absolute;
        right: 24px;
        bottom: 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border: 1px solid var(--alife-border);
        border-radius: 999px;
        background: var(--alife-bg-elevated);
        color: var(--alife-primary);
        font-size: 12px;
        cursor: pointer;
        box-shadow: var(--alife-shadow-float);
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .chat-body[data-at-bottom="false"] .chat-jump {
        opacity: 1;
        transform: none;
        pointer-events: auto;
    }

    .chat-jump:hover {
        border-color: var(--alife-primary-border);
    }

    .chat-row {
        display: flex;
        flex-direction: column;   /* 气泡在上、操作条在下；横排会把操作条挤到气泡旁边点不到 */
        align-items: flex-start;
        width: 100%;
        margin-bottom: 14px;
    }

    .chat-row-user {
        align-items: flex-end;
    }

    .chat-bubble {
        max-width: 78%;
        padding: 10px 14px;
        border-radius: 14px;
        box-shadow: var(--alife-shadow-card);
    }

    .chat-bubble-user {
        background: var(--alife-bubble-user-bg);
        color: var(--alife-bubble-user-text);
        border-bottom-right-radius: 4px;
    }

    .chat-bubble-ai {
        background: var(--alife-bubble-ai-bg);
        color: var(--alife-bubble-ai-text);
        border: 1px solid var(--alife-border);
        border-bottom-left-radius: 4px;
    }

    .chat-text {
        font-size: 15px;
        line-height: 1.65;
        white-space: pre-wrap;
        overflow-wrap: break-word;
    }

    /* 每条气泡下方的操作条：平时半透明，hover 整行才完全显现 */
    .chat-msg-actions {
        display: flex;
        gap: 6px;
        margin-top: 2px;
        padding: 0 4px;
        opacity: 0.25;
        transition: opacity 0.15s;
    }
    .chat-row:hover .chat-msg-actions,
    .chat-msg-actions:focus-within { opacity: 1; }

    /* 生成中的停止按钮必须常亮：这是需要立刻点到的操作，不该等 hover */
    .chat-msg-actions-always { opacity: 1; }

    /* 气泡内联编辑：改完直接确定重发，不占用底部输入框 */
    .chat-inline-edit {
        width: 100%;
        min-width: 260px;
        box-sizing: border-box;
        padding: 8px 10px;
        font: inherit;
        font-size: 15px;
        line-height: 1.6;
        color: var(--alife-text);
        background: var(--alife-bg-elevated, rgba(255,255,255,0.06));
        border: 1px solid var(--alife-primary);
        border-radius: 6px;
        resize: vertical;
        outline: none;
    }
    .chat-inline-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 6px;
    }
    .chat-inline-actions button {
        padding: 3px 12px;
        font-size: 12px;
        border-radius: 4px;
        cursor: pointer;
        border: 1px solid var(--alife-border);
        background: transparent;
        color: var(--alife-text-secondary);
    }
    .chat-inline-actions .chat-inline-confirm {
        color: #fff;
        background: var(--alife-primary);
        border-color: var(--alife-primary);
    }

    .chat-msg-actions button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 22px;
        padding: 0;
        color: var(--alife-text-tertiary);
        background: transparent;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }
    .chat-msg-actions button:hover:not(:disabled) {
        color: var(--alife-primary);
        background: var(--alife-hover-bg, rgba(128,128,128,0.12));
    }
    .chat-msg-actions button:disabled { opacity: 0.35; cursor: default; }

    /* 多版本导航的 1/2 标号 */
    .chat-version-label {
        display: inline-flex;
        align-items: center;
        padding: 0 2px;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        color: var(--alife-text-tertiary);
        user-select: none;
    }

    /* 用户消息的操作条右对齐 */
    .chat-row-user .chat-msg-actions { justify-content: flex-end; }

    .chat-typing {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 6px;
        font-size: 12px;
        color: var(--alife-text-tertiary);
    }

    .chat-reasoning {
        margin-bottom: 10px;
        padding: 8px 10px;
        background: var(--alife-bg-subtle);
        border-left: 3px solid var(--alife-border-strong);
        border-radius: 6px;
        font-size: 13px;
    }

    .chat-reasoning-title {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--alife-text-tertiary);
        font-weight: 500;
        cursor: pointer;
        user-select: none;
    }

    .chat-reasoning-caret {
        display: inline-block;
        font-size: 11px;
        transition: transform 0.15s ease;
    }

    .chat-reasoning-caret.is-open {
        transform: rotate(180deg);
    }

    .chat-reasoning-content {
        margin-top: 6px;
        color: var(--alife-text-secondary);
        white-space: pre-wrap;
        overflow-wrap: break-word;
        font-style: italic;
    }

    .chat-reasoning-reason {
        margin-top: 6px;
        padding: 4px 8px;
        color: var(--alife-primary);
        background: var(--alife-primary-bg);
        border: 1px solid var(--alife-primary-border);
        border-radius: 6px;
        font-size: 12px;
    }

    .chat-splitter {
        flex: 0 0 auto;
        height: 5px;
        position: relative;
        z-index: 10;
        cursor: row-resize;
        background: transparent;
    }

    .chat-splitter::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 2px;
        width: 40px;
        height: 2px;
        transform: translateX(-50%);
        border-radius: 2px;
        background: var(--alife-border-strong);
        transition: background 0.2s;
    }

    .chat-splitter:hover::before {
        background: var(--alife-primary);
    }

    .chat-input-bar {
        flex: 0 0 auto;
        display: flex;
        align-items: flex-end;
        gap: 12px;
        min-height: 100px;
        padding: 12px 24px;
        background: var(--alife-bg-container);
        border-top: 1px solid var(--alife-border);
    }

    .chat-input-main {
        flex: 1 1 auto;
        align-self: stretch;
        position: relative;
        min-width: 0;
        min-height: 0;
    }

    .chat-input-actions {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chat-input {
        height: 100% !important;
        min-height: 64px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 14px;
        line-height: 1.6;
        background: var(--alife-bg-container);
        resize: none;
    }

    .chat-busy {
        position: absolute;
        bottom: 8px;
        right: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 10px;
        border: 1px solid var(--alife-primary-border);
        border-radius: 20px;
        background: var(--alife-primary-bg);
        color: var(--alife-primary);
        font-size: 12px;
        z-index: 10;
        pointer-events: none;
        animation: chat-busy-pulse 2s infinite;
    }

    @@keyframes chat-busy-pulse {
        0% { opacity: 0.6; }
        50% { opacity: 1; }
        100% { opacity: 0.6; }
    }
</style>

@code {
    /// <summary>消息区元素 id：贴底跟随与“回到最新消息”都以它为键，页面上可能并存多个消息流。</summary>
    const string streamId = "messageArea";
    /// <summary>流式输出的渲染节拍：几十毫秒的合并延迟看不出来，但能让重排次数少一个数量级。</summary>
    const int messageRenderIntervalMs = 60;

    string inputText = "";
    /// <summary>正在内联编辑的用户消息；null 表示没有在编辑。</summary>
    ChatMessage? editingMessage;
    /// <summary>正在编辑的是第几条用户消息（0 起算）。</summary>
    int editingUserTurn = -1;
    /// <summary>内联编辑框的内容。</summary>
    string editingText = "";
    ElementReference inlineEditRef;
    bool isWorking;
    /// <summary>
    /// 真正在生成回复（chatSemaphore 被占）。
    /// isWorking 还包含「后台有插件占着资源」，用那个当按钮禁用条件会让按钮长期点不动，
    /// 所以对话控制一律看 isGenerating。
    /// </summary>
    bool isGenerating;
    bool isInputAreaBound;
    bool isDisposed;
    bool isMessageDirty;
    bool isMessageRenderLoopRunning;
    List<ChatMessage>? messages;
    string? occupiedReasonText = "";
    Exception? chatException;
    DotNetObjectReference<ChatWindowUI>? dotNetRef;
    IJSObjectReference? chatModule;

    /// <summary>至少有一轮问答才能重生/回退。</summary>
    bool CanRegenerate
    {
        get
        {
            List<ChatMessage>? list = messages;
            if (list == null) return false;
            lock (list) return list.Any(m => m.IsUser);
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        messages = ClientChatStatistics.GetMessages(Character.Name);
        inputText = ClientChatStatistics.GetDraft(Character.Name);
        ClientChatStatistics.MessageChanged += OnMessageChanged;
        ClientChatStatistics.ChatExceptionThrew += OnChatExceptionThrew;
        ClientChatStatistics.ChatbotMapUpdated += OnChatbotMapUpdated;

        StartUpdateLoop();

        async void StartUpdateLoop()
        {
            try
            {
                while (!isDisposed)
                {
                    if (ChatActivity != null)
                    {
                        ChatBot chatBot = ChatActivity.ChatBot;

                        bool working = isWorking;
                        bool generating = isGenerating;
                        string? occupiedReason = occupiedReasonText;
                        chatBot.ResourceOccupiedReason.Query(list => {
                            working = chatBot.IsChatOccupied || chatBot.IsChatHistoryOccupied || list.Count != 0;
                            generating = chatBot.IsChatOccupied;
                            occupiedReason = string.Join(" | ", list.Select(marker => marker.Reason));
                        });

                        if (working != isWorking || generating != isGenerating || occupiedReasonText != occupiedReason)
                        {
                            isWorking = working;
                            isGenerating = generating;
                            occupiedReasonText = occupiedReason;
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    await Task.Delay(200);
                }
            }
            catch (Exception e)
            {
                AlifeLog.LogError(e);
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        IJSObjectReference module = chatModule ??= await ImportModuleAsync();

        if (firstRender)
            await module.InvokeVoidAsync("setupStream", "chatBody", streamId);

        // 输入区只在角色激活后存在，出现与消失都要重新绑定一次（绑定本身是幂等的）
        bool hasInputArea = ChatActivity != null;
        if (hasInputArea == isInputAreaBound)
            return;

        isInputAreaBound = hasInputArea;
        if (hasInputArea == false)
            return;

        dotNetRef ??= DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("setupSplitter", "chatSplitter", "messageArea", 100, 100);
        await module.InvokeVoidAsync("setupEnter", "chatInput", dotNetRef);
        await module.InvokeVoidAsync("setupPaste", "chatInput", dotNetRef);
    }
    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        ClientChatStatistics.SetDraft(Character.Name, inputText);
        ClientChatStatistics.MessageChanged -= OnMessageChanged;
        ClientChatStatistics.ChatExceptionThrew -= OnChatExceptionThrew;
        ClientChatStatistics.ChatbotMapUpdated -= OnChatbotMapUpdated;
        dotNetRef?.Dispose();
        dotNetRef = null;

        if (chatModule != null)
            await chatModule.DisposeAsync();
    }

    /// <summary>聊天行为（贴底、回车、粘贴、拖拽）是一份共用脚本，宿主与插件按同一个 URL 取用。</summary>
    Task<IJSObjectReference> ImportModuleAsync() =>
        JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Alife.Client/alife-chat.js").AsTask();

    /// <summary>浏览器侧行为模块只在渲染完成后存在，而调用它的都是渲染之后的事件回调。</summary>
    IJSObjectReference ChatModule => chatModule ?? throw new InvalidOperationException("对话看板的脚本模块尚未加载");

    [JSInvokable]
    public Task OnEnterAsync(string domInputText) => SendAsync(domInputText);

    [JSInvokable]
    public Task<string?> CreateTempImageAsync(string base64Data, string extension)
    {
        try
        {
            byte[] data = Convert.FromBase64String(base64Data);
            string filePath = Path.Combine(AlifePath.TempFolderPath, $"pasted_{DateTime.Now:HHmmss}_{Guid.NewGuid():N}.{extension}");
            Directory.CreateDirectory(AlifePath.TempFolderPath);
            File.WriteAllBytes(filePath, data);
            return Task.FromResult<string?>(filePath);
        }
        catch (Exception e)
        {
            AlifeLog.LogError(e);
            return Task.FromResult<string?>(null);
        }
    }

    void OnMessageChanged(string name)
    {
        if (name == Character.Name)
            QueueMessageRender();
    }
    void OnChatExceptionThrew(string name, Exception exception)
    {
        if (name == Character.Name)
        {
            chatException = exception;
            InvokeAsync(StateHasChanged);
        }
    }
    void OnChatbotMapUpdated() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// 流式输出按 chunk 回调，逐块渲染会让界面每秒重排上百次；
    /// 这里把渲染合并到固定节拍上，只有消息还在变时才持续刷新。
    /// </summary>
    void QueueMessageRender() => InvokeAsync(RenderMessagesAsync);

    async Task RenderMessagesAsync()
    {
        if (isMessageRenderLoopRunning)
        {
            isMessageDirty = true;
            return;
        }

        isMessageRenderLoopRunning = true;
        try
        {
            do
            {
                isMessageDirty = false;
                StateHasChanged();
                await Task.Delay(messageRenderIntervalMs);
            }
            while (isMessageDirty && isDisposed == false);
        }
        catch (Exception e)
        {
            AlifeLog.LogError(e);
        }
        finally
        {
            isMessageRenderLoopRunning = false;
        }
    }

    void OnClear()
    {
        ClientChatStatistics.ClearMessages(Character.Name);
        StateHasChanged();
    }
    /// <summary>全局开关只管“新到达的消息默认展开”和“把所有已显示的思考一次性展开/收起”，之后用户仍然可以自己点开某一条。</summary>
    void OnShowReasoningChanged(bool value)
    {
        ClientChatStatistics.ShowReasoning = value;
        if (messages != null)
        {
            lock (messages)
            {
                foreach (ChatMessage message in messages)
                    message.ReasoningExpanded = value;
            }
        }

        StateHasChanged();
    }
    async Task OnUploadFile()
    {
        string? path = await AlifeApplication.SelectFileAsync();
        if (string.IsNullOrWhiteSpace(path))
            return;

        await ChatModule.InvokeVoidAsync("appendLine", "chatInput", path).AsTask();
    }
    async Task OnSendClickAsync() => await SendAsync(inputText);
    Task ScrollToLatestAsync() => ChatModule.InvokeVoidAsync("scrollToLatest", streamId).AsTask();
    async Task SendAsync(string rawInputText)
    {
        //生成中发送键已变成终止键，但 Enter 仍会走到这里 —— 挡住，避免打断当前输出
        if (isGenerating) return;

        // 输入框的值有两个来源：Enter 走 DOM（避免最后一次按键还没回到 .NET），按钮走绑定字段。
        // 清空时两边都要清，所以这里不再重建 TextArea 组件。
        inputText = "";
        await ChatModule.InvokeVoidAsync("clearInput", "chatInput").AsTask();

        if (string.IsNullOrWhiteSpace(rawInputText) && editingMessage == null)
            return;

        //编辑走内联气泡的「确定并重发」，不占用输入框
        ClientChatStatistics.SendMessage(Character.Name, rawInputText.Trim());

        ClientChatStatistics.SetDraft(Character.Name, "");
        await InvokeAsync(StateHasChanged);
        await ChatModule.InvokeVoidAsync("scrollToLatest", streamId).AsTask();
    }

    // ---------------------------------------------------------------- 对话控制

    void OnStop()
    {
        ClientChatStatistics.Stop(Character.Name);
    }

    async Task OnRegenerate()
    {
        if (isGenerating) return;
        await ClientChatStatistics.RegenerateAsync(Character.Name);
        await InvokeAsync(StateHasChanged);
        await ScrollToLatestAsync();
    }

    /// <summary>切换查看某一条消息的历史版本（重生产生的旧回复都会保留）。</summary>
    void SwitchVersion(ChatMessage message, int index)
    {
        message.ShowVersion(index);
        StateHasChanged();
    }

    /// <summary>
    /// 回档到这一轮：保留这句输入，把它之后的全部抹掉，再用这句重新生成。
    /// 不是单纯删——删了不重答，等于把对话砍断。
    /// </summary>
    async Task OnRollback(int userTurnIndex)
    {
        if (isGenerating) return;

        editingMessage = null;
        editingUserTurn = -1;

        await ClientChatStatistics.RewindAndRegenerateAsync(Character.Name, userTurnIndex);
        await InvokeAsync(StateHasChanged);
        await ScrollToLatestAsync();
    }

    void OnEditMessage(ChatMessage message, int userTurn)
    {
        if (isGenerating) return;
        if (userTurn < 0) return;

        editingMessage = message;
        editingUserTurn = userTurn;
        editingText = message.Content;
        StateHasChanged();
    }

    async Task ConfirmEdit()
    {
        if (editingMessage == null || isGenerating) return;

        int turn = editingUserTurn;
        string text = editingText.Trim();

        editingMessage = null;
        editingUserTurn = -1;
        editingText = "";

        if (text.Length == 0)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        //确定后直接让 AI 重新生成，不需要用户再去输入框点发送
        await ClientChatStatistics.EditUserTurnAndRegenerateAsync(Character.Name, turn, text);
        await InvokeAsync(StateHasChanged);
        await ScrollToLatestAsync();
    }

    void CancelEdit()
    {
        editingMessage = null;
        editingUserTurn = -1;
        editingText = "";
        StateHasChanged();
    }
}
