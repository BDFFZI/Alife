@inherits CharacterMenu
@attribute [CharacterMenu("对话看板","comment",30)]
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject IAlifeApplication AlifeApplication

<div class="chat-panel">
    @* 顶部操作栏：前缀、条数上限、思考展开都直接读写客户端聊天状态 *@
    <div class="chat-toolbar">
        <span class="alife-label">消息前缀</span>
        <Input @bind-Value="ClientChatStatistics.MessageTag" Size="@InputSize.Small" Style="width: 180px;"/>
        <span class="alife-label">最大条数</span>
        <AntDesign.InputNumber @bind-Value="ClientChatStatistics.MaxMessageCount" Min="10" Max="10000"
                               Size="@InputSize.Small" Style="width: 88px;"/>
        <span class="alife-label">展开思考</span>
        <Switch Value="@ClientChatStatistics.ShowReasoning" ValueChanged="@OnShowReasoningChanged"/>
        <span class="alife-spacer"></span>
        <Button Type="@ButtonType.Link" Danger Icon="@IconType.Outline.Clear" OnClick="@OnClear">清理对话日志</Button>
    </div>

    @* 消息区：滚动贴底、回到底部浮标都由 alife-chat.js 接管 *@
    <div class="chat-body" id="chatBody">
        <div class="chat-stream" id="messageArea">
            @if (messages == null)
            {
                <Empty Style="margin-top: 80px" Description="@("消息存储不存在！")"/>
            }
            else if (messages.Count == 0)
            {
                <Empty Style="margin-top: 80px" Description="@("暂无聊天信息，开始对话吧喵！")"/>
            }
            else
            {
                @lock (messages)
                {
                    @foreach (ChatMessage message in messages)
                    {
                        <div class="chat-row @(message.IsUser ? "chat-row-user" : "")">
                            <div class="chat-bubble @(message.IsUser ? "chat-bubble-user" : "chat-bubble-ai")">
                                @if (!string.IsNullOrEmpty(message.Reasoning))
                                {
                                    <div class="chat-reasoning">
                                        <div class="chat-reasoning-title"
                                             @onclick="@(() => message.ReasoningExpanded = message.ReasoningExpanded == false)">
                                            <Icon Type="@(message.IsReasoning ? IconType.Outline.Loading : IconType.Outline.Bulb)"/>
                                            <span>思考过程</span>
                                            <span class="chat-reasoning-caret @(message.ReasoningExpanded ? "is-open" : "")">▼</span>
                                        </div>

                                        @if (message.ReasoningExpanded)
                                        {
                                            @if (!string.IsNullOrEmpty(message.ThinkingReason))
                                            {
                                                <div class="chat-reasoning-reason">思考原因：@message.ThinkingReason</div>
                                            }
                                            <div class="chat-reasoning-content">@message.Reasoning</div>
                                        }
                                    </div>
                                }
                                <div class="chat-text">@message.Content</div>
                                @if (message.IsInputting)
                                {
                                    <div class="chat-typing">
                                        <Icon Type="@IconType.Outline.Loading"/>
                                        <span>输入中</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
        </div>

        <button type="button" class="chat-jump" @onclick="@ScrollToLatestAsync">
            <Icon Type="@IconType.Outline.Down"/>
            <span>回到最新消息</span>
        </button>
    </div>

    @if (ChatActivity != null)
    {
        <div id="chatSplitter" class="chat-splitter"></div>

        <div class="chat-input-bar">
            <div class="chat-input-main">
                <TextArea Id="chatInput"
                          Class="chat-input"
                          Placeholder="@("输入消息... (Enter 发送，Shift+Enter 换行，Ctrl+V 粘贴文本或文件)")"
                          @bind-Value="inputText"
                          BindOnInput="true"
                          Rows="3"></TextArea>

                @if (isWorking)
                {
                    <div class="chat-busy">
                        <Icon Type="@IconType.Outline.Loading"/>
                        <span>@(string.IsNullOrEmpty(occupiedReasonText) ? "对话占用中" : occupiedReasonText)</span>
                    </div>
                }
            </div>

            <div class="chat-input-actions">
                <Tooltip Title="@("上传文件")">
                    <Button Icon="@IconType.Outline.Upload" OnClick="@OnUploadFile"/>
                </Tooltip>
                <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Send" OnClick="@OnSendClickAsync">发送</Button>
            </div>
        </div>
    }
</div>

<ErrorWindowUI @bind-Value="@chatException" Title="聊天出错喵！"/>

<style>
    .chat-panel {
        height: 100%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: var(--alife-bg-layout);
    }

    .chat-toolbar {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 8px 16px;
        background: var(--alife-bg-container);
        border-bottom: 1px solid var(--alife-border);
    }

    .chat-body {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
    }

    .chat-stream {
        flex: 1 1 auto;
        min-width: 0;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 20px 24px;
    }

    .chat-jump {
        position: absolute;
        right: 24px;
        bottom: 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border: 1px solid var(--alife-border);
        border-radius: 999px;
        background: var(--alife-bg-elevated);
        color: var(--alife-primary);
        font-size: 12px;
        cursor: pointer;
        box-shadow: var(--alife-shadow-float);
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .chat-body[data-at-bottom="false"] .chat-jump {
        opacity: 1;
        transform: none;
        pointer-events: auto;
    }

    .chat-jump:hover {
        border-color: var(--alife-primary-border);
    }

    .chat-row {
        display: flex;
        width: 100%;
        margin-bottom: 14px;
    }

    .chat-row-user {
        justify-content: flex-end;
    }

    .chat-bubble {
        max-width: 78%;
        padding: 10px 14px;
        border-radius: 14px;
        box-shadow: var(--alife-shadow-card);
    }

    .chat-bubble-user {
        background: var(--alife-bubble-user-bg);
        color: var(--alife-bubble-user-text);
        border-bottom-right-radius: 4px;
    }

    .chat-bubble-ai {
        background: var(--alife-bubble-ai-bg);
        color: var(--alife-bubble-ai-text);
        border: 1px solid var(--alife-border);
        border-bottom-left-radius: 4px;
    }

    .chat-text {
        font-size: 15px;
        line-height: 1.65;
        white-space: pre-wrap;
        overflow-wrap: break-word;
    }

    .chat-typing {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 6px;
        font-size: 12px;
        color: var(--alife-text-tertiary);
    }

    .chat-reasoning {
        margin-bottom: 10px;
        padding: 8px 10px;
        background: var(--alife-bg-subtle);
        border-left: 3px solid var(--alife-border-strong);
        border-radius: 6px;
        font-size: 13px;
    }

    .chat-reasoning-title {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--alife-text-tertiary);
        font-weight: 500;
        cursor: pointer;
        user-select: none;
    }

    .chat-reasoning-caret {
        display: inline-block;
        font-size: 11px;
        transition: transform 0.15s ease;
    }

    .chat-reasoning-caret.is-open {
        transform: rotate(180deg);
    }

    .chat-reasoning-content {
        margin-top: 6px;
        color: var(--alife-text-secondary);
        white-space: pre-wrap;
        overflow-wrap: break-word;
        font-style: italic;
    }

    .chat-reasoning-reason {
        margin-top: 6px;
        padding: 4px 8px;
        color: var(--alife-primary);
        background: var(--alife-primary-bg);
        border: 1px solid var(--alife-primary-border);
        border-radius: 6px;
        font-size: 12px;
    }

    .chat-splitter {
        flex: 0 0 auto;
        height: 5px;
        position: relative;
        z-index: 10;
        cursor: row-resize;
        background: transparent;
    }

    .chat-splitter::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 2px;
        width: 40px;
        height: 2px;
        transform: translateX(-50%);
        border-radius: 2px;
        background: var(--alife-border-strong);
        transition: background 0.2s;
    }

    .chat-splitter:hover::before {
        background: var(--alife-primary);
    }

    .chat-input-bar {
        flex: 0 0 auto;
        display: flex;
        align-items: flex-end;
        gap: 12px;
        min-height: 100px;
        padding: 12px 24px;
        background: var(--alife-bg-container);
        border-top: 1px solid var(--alife-border);
    }

    .chat-input-main {
        flex: 1 1 auto;
        align-self: stretch;
        position: relative;
        min-width: 0;
        min-height: 0;
    }

    .chat-input-actions {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chat-input {
        height: 100% !important;
        min-height: 64px;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 14px;
        line-height: 1.6;
        background: var(--alife-bg-container);
        resize: none;
    }

    .chat-busy {
        position: absolute;
        bottom: 8px;
        right: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 10px;
        border: 1px solid var(--alife-primary-border);
        border-radius: 20px;
        background: var(--alife-primary-bg);
        color: var(--alife-primary);
        font-size: 12px;
        z-index: 10;
        pointer-events: none;
        animation: chat-busy-pulse 2s infinite;
    }

    @@keyframes chat-busy-pulse {
        0% { opacity: 0.6; }
        50% { opacity: 1; }
        100% { opacity: 0.6; }
    }
</style>

@code {
    /// <summary>消息区元素 id：贴底跟随与“回到最新消息”都以它为键，页面上可能并存多个消息流。</summary>
    const string streamId = "messageArea";

    string inputText = "";
    bool isWorking;
    bool isInputAreaBound;
    bool isDisposed;
    List<ChatMessage>? messages;
    string? occupiedReasonText = "";
    Exception? chatException;
    DotNetObjectReference<ChatWindowUI>? dotNetRef;
    IJSObjectReference? chatModule;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        messages = ClientChatStatistics.GetMessages(Character.Name);
        inputText = ClientChatStatistics.GetDraft(Character.Name);
        ClientChatStatistics.MessageChanged += OnMessageChanged;
        ClientChatStatistics.UserMessageSent += OnUserMessageSent;
        ClientChatStatistics.ChatExceptionThrew += OnChatExceptionThrew;
        ClientChatStatistics.ChatbotMapUpdated += OnChatbotMapUpdated;

        StartUpdateLoop();

        async void StartUpdateLoop()
        {
            try
            {
                while (!isDisposed)
                {
                    if (ChatActivity != null)
                    {
                        ChatBot chatBot = ChatActivity.ChatBot;

                        bool working = isWorking;
                        string? occupiedReason = occupiedReasonText;
                        chatBot.ResourceOccupiedReason.Query(list => {
                            working = chatBot.IsChatOccupied || chatBot.IsChatHistoryOccupied || list.Count != 0;
                            occupiedReason = string.Join(" | ", list.Select(marker => marker.Reason));
                        });

                        if (working != isWorking || occupiedReasonText != occupiedReason)
                        {
                            isWorking = working;
                            occupiedReasonText = occupiedReason;
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    await Task.Delay(200);
                }
            }
            catch (Exception e)
            {
                AlifeLog.LogError(e);
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        IJSObjectReference module = chatModule ??= await ImportModuleAsync();

        if (firstRender)
            await module.InvokeVoidAsync("setupStream", "chatBody", streamId);

        // 输入区只在角色激活后存在，出现与消失都要重新绑定一次（绑定本身是幂等的）
        bool hasInputArea = ChatActivity != null;
        if (hasInputArea == isInputAreaBound)
            return;

        isInputAreaBound = hasInputArea;
        if (hasInputArea == false)
            return;

        dotNetRef ??= DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("setupSplitter", "chatSplitter", "messageArea", 100, 100);
        await module.InvokeVoidAsync("setupEnter", "chatInput", dotNetRef);
        await module.InvokeVoidAsync("setupPaste", "chatInput", dotNetRef);
    }
    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        ClientChatStatistics.SetDraft(Character.Name, inputText);
        ClientChatStatistics.MessageChanged -= OnMessageChanged;
        ClientChatStatistics.UserMessageSent -= OnUserMessageSent;
        ClientChatStatistics.ChatExceptionThrew -= OnChatExceptionThrew;
        ClientChatStatistics.ChatbotMapUpdated -= OnChatbotMapUpdated;
        dotNetRef?.Dispose();
        dotNetRef = null;

        if (chatModule != null)
            await chatModule.DisposeAsync();
    }

    /// <summary>聊天行为（贴底、回车、粘贴、拖拽）是一份共用脚本，宿主与插件按同一个 URL 取用。</summary>
    Task<IJSObjectReference> ImportModuleAsync() =>
        JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Alife.Client/alife-chat.js").AsTask();

    /// <summary>浏览器侧行为模块只在渲染完成后存在，而调用它的都是渲染之后的事件回调。</summary>
    IJSObjectReference ChatModule => chatModule ?? throw new InvalidOperationException("对话看板的脚本模块尚未加载");

    [JSInvokable]
    public Task OnEnterAsync(string domInputText) => SendAsync(domInputText);

    [JSInvokable]
    public Task<string?> CreateTempImageAsync(string base64Data, string extension)
    {
        try
        {
            byte[] data = Convert.FromBase64String(base64Data);
            string filePath = Path.Combine(AlifePath.TempFolderPath, $"pasted_{DateTime.Now:HHmmss}_{Guid.NewGuid():N}.{extension}");
            Directory.CreateDirectory(AlifePath.TempFolderPath);
            File.WriteAllBytes(filePath, data);
            return Task.FromResult<string?>(filePath);
        }
        catch (Exception e)
        {
            AlifeLog.LogError(e);
            return Task.FromResult<string?>(null);
        }
    }

    void OnMessageChanged(string name)
    {
        if (name == Character.Name)
            InvokeAsync(StateHasChanged);
    }
    void OnUserMessageSent(string name)
    {
        if (name == Character.Name)
            InvokeAsync(StateHasChanged);
    }
    void OnChatExceptionThrew(string name, Exception exception)
    {
        if (name == Character.Name)
        {
            chatException = exception;
            InvokeAsync(StateHasChanged);
        }
    }
    void OnChatbotMapUpdated() => InvokeAsync(StateHasChanged);

    void OnClear()
    {
        ClientChatStatistics.ClearMessages(Character.Name);
        StateHasChanged();
    }
    /// <summary>全局开关只管“新到达的消息默认展开”和“把所有已显示的思考一次性展开/收起”，之后用户仍然可以自己点开某一条。</summary>
    void OnShowReasoningChanged(bool value)
    {
        ClientChatStatistics.ShowReasoning = value;
        if (messages != null)
        {
            lock (messages)
            {
                foreach (ChatMessage message in messages)
                    message.ReasoningExpanded = value;
            }
        }

        StateHasChanged();
    }
    async Task OnUploadFile()
    {
        string? path = await AlifeApplication.SelectFileAsync();
        if (string.IsNullOrWhiteSpace(path))
            return;

        await ChatModule.InvokeVoidAsync("appendLine", "chatInput", path).AsTask();
    }
    async Task OnSendClickAsync() => await SendAsync(inputText);
    Task ScrollToLatestAsync() => ChatModule.InvokeVoidAsync("scrollToLatest", streamId).AsTask();
    async Task SendAsync(string rawInputText)
    {
        // 输入框的值有两个来源：Enter 走 DOM（避免最后一次按键还没回到 .NET），按钮走绑定字段。
        // 清空时两边都要清，所以这里不再重建 TextArea 组件。
        inputText = "";
        await ChatModule.InvokeVoidAsync("clearInput", "chatInput").AsTask();

        if (string.IsNullOrWhiteSpace(rawInputText))
            return;

        ClientChatStatistics.SendMessage(Character.Name, rawInputText.Trim());
        ClientChatStatistics.SetDraft(Character.Name, "");
        await InvokeAsync(StateHasChanged);

        await ChatModule.InvokeVoidAsync("scrollToLatest", streamId).AsTask();
    }
}
