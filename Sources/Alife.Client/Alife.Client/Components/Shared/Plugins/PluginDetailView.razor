@inject PluginSystem PluginSystem
@inject INotificationService NotificationService

<ErrorWindowUI @bind-Value="@operException"/>

<div style="display: flex; flex-direction: column; height: 100%;">
    @* 页头 *@
    <div style="flex-shrink: 0; background: #fafafa; padding: 24px; border-radius: 8px; border: 1px solid #f0f0f0;">
        <Flex Align="FlexAlign.Start">
            <div>
                <Flex Align="FlexAlign.Center" Gap="@("12")">
                    <Title Level="3" Style="margin: 0;">@PluginPackage.Name</Title>
                    @if (isInstalled)
                    {
                        <Tag Color="@("green")">已安装</Tag>
                    }
                    @if (hasUpdate)
                    {
                        <Tag Color="@("orange")">可升级</Tag>
                    }
                </Flex>
                <AntDesign.Text Type="@TextElementType.Secondary"
                                Style="margin-top: 4px; display: block;">@PluginPackage.Id</AntDesign.Text>
                @if (!string.IsNullOrEmpty(PluginPackage.Author))
                {
                    <span
                        style="margin-top: 2px; display: block; color: rgba(0,0,0,0.45); font-size: 14px;">作者: @PluginPackage.Author</span>
                }
                @if (PluginPackage.Tags != null && PluginPackage.Tags.Count > 0)
                {
                    <Flex Align="FlexAlign.Center" Gap="@("6")" Style="margin-top: 8px; flex-wrap: wrap;">
                        @foreach (var tag in PluginPackage.Tags)
                        {
                            <Tag>@tag</Tag>
                        }
                    </Flex>
                }
            </div>
        </Flex>

        <Paragraph Style="margin-top: 16px; color: rgba(0,0,0,0.65);">
            @PluginPackage.Description
        </Paragraph>

        @if (!string.IsNullOrEmpty(PluginPackage.Source))
        {
            <div style="margin-top: 8px;">
                <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 13px;">
                    <Icon Type="@IconType.Outline.Link"/>
                    <a href="@PluginPackage.Source" target="_blank" style="color: #1890ff;">@PluginPackage.Source</a>
                </AntDesign.Text>
            </div>
        }

        @* 操作按钮 *@
        <Flex Gap="@("12")" Style="margin-top: 16px; flex-wrap: wrap;">
            @if (!isInstalled)
            {
                <Tooltip Title="@(latestVersion == null ? "没有兼容当前客户端的版本" : "")">
                    <Button Type="@ButtonType.Primary" Loading="isOperating" Disabled="@(latestVersion == null)"
                            OnClick="@InstallLatest">
                        <Icon Type="@IconType.Outline.CloudDownload"/>
                        安装
                    </Button>
                </Tooltip>
            }
            else
            {
                @if (hasUpdate)
                {
                    <Button Type="@ButtonType.Primary" Loading="isOperating" OnClick="@UpgradeLatest">
                        <Icon Type="@IconType.Outline.ArrowUp"/>
                        升级到 @latestVersion
                    </Button>
                }
                <Button Loading="isOperating" OnClick="@Reinstall">
                    <Icon Type="@IconType.Outline.Reload"/>
                    重装
                </Button>
                <Popconfirm Title="@($"确定要卸载 {PluginPackage.Name} 吗？")"
                            OkText="卸载" CancelText="取消"
                            OnConfirm="@Uninstall">
                    <Button Danger Loading="isOperating" Disabled="isOperating">
                        <Icon Type="@IconType.Outline.Delete"/>
                        卸载
                    </Button>
                </Popconfirm>
            }
            <Button Type="@(IsInCart ? ButtonType.Primary : ButtonType.Default)" OnClick="@ToggleCart">
                <WrenchIcon/>
                @(isInCart ? "移出插件操作" : "加入插件操作")
            </Button>
        </Flex>
    </div>

    @* 版本列表 *@
    <div style="flex: 1; overflow-y: auto; padding: 16px 0;">
        <Title Level="4">版本历史</Title>
        <Timeline>
            @if (PluginPackage.Releases != null)
            {
                @foreach (var release in PluginPackage.Releases.OrderByDescending(r => r.Key, Comparer<string>.Create(DependencyResolver.CompareVersions)))
                {
                    bool isCompatible = PluginSystem.IsClientCompatible(release.Key);
                    <TimelineItem Color="@(release.Key == latestVersion ? "blue" : "gray")">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <Tooltip Title="@(isCompatible ? "" : "版本不兼容：插件大版本号高于当前客户端版本")">
                                <AntDesign.Text Strong
                                                Style="@(isCompatible ? "" : "opacity: 0.4;")">@release.Key</AntDesign.Text>
                            </Tooltip>
                            @if (isInstalled && release.Key == installedVersion)
                            {
                                <Tag Color="@("green")">当前版本</Tag>
                            }
                            @if (release.Key == latestVersion)
                            {
                                <Tag Color="@("blue")">最新</Tag>
                            }
                            @if (!isCompatible)
                            {
                                <Tag Color="@("red")">不兼容</Tag>
                            }
                        </div>
                        <AntDesign.Text Type="@TextElementType.Secondary"
                                        Style="font-size: 12px;">@release.Value.Date</AntDesign.Text>
                        @if (!string.IsNullOrEmpty(release.Value.Note))
                        {
                            <div
                                style="margin-top: 4px; white-space: pre-wrap; @(isCompatible ? "" : "opacity: 0.4;")">@release.Value.Note</div>
                        }
                        @if (!string.IsNullOrEmpty(release.Value.File))
                        {
                            <div style="margin-top: 4px; word-break: break-all; @(isCompatible ? "" : "opacity: 0.4;")">
                                <a href="@release.Value.File" target="_blank" style="font-size: 12px; color: #1890ff;">
                                    @release.Value.File
                                </a>
                            </div>
                        }
                        @if (release.Key != installedVersion)
                        {
                            <div style="margin-top: 4px;">
                                <Button Size="@ButtonSize.Small" Loading="isOperating" Danger
                                        OnClick="@(() => InstallVersion(release.Key))">
                                    <Icon Type="@IconType.Outline.Swap"/>
                                    切换到此版本
                                </Button>
                            </div>
                        }
                    </TimelineItem>
                }
            }
        </Timeline>
    </div>
</div>

@code {
    [Parameter] public PluginPackage PluginPackage { get; set; } = null!;
    [Parameter] public bool IsInCart { get; set; }
    [Parameter] public EventCallback<bool> OnToggleCart { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    bool isInstalled;
    bool hasUpdate;
    bool isInCart;
    bool isOperating;
    string? installedVersion;
    string? latestVersion;
    Exception? operException;

    protected override void OnParametersSet()
    {
        RefreshState();
    }

    void RefreshState()
    {
        isInstalled = PluginSystem.IsInstalled(PluginPackage.Id);
        installedVersion = PluginSystem.GetInstalledVersion(PluginPackage.Id);
        latestVersion = PluginSystem.GetLatestVersion(PluginPackage);
        hasUpdate = isInstalled && PluginSystem.HasUpdate(PluginPackage);
        isInCart = IsInCart;
    }

    async Task ToggleCart()
    {
        await OnToggleCart.InvokeAsync(!isInCart);
    }

    Task InstallLatest()
    {
        if (latestVersion == null)
        {
            _ = NotificationService.Warning(new NotificationConfig { Message = "没有兼容当前客户端的版本" });
            return Task.CompletedTask;
        }
        return RunOperation($"已安装 {PluginPackage.Name}", () =>
            PluginSystem.InstallPlugins([new KeyValuePair<PluginPackage, string>(PluginPackage, latestVersion)]));
    }

    Task UpgradeLatest()
    {
        if (latestVersion == null)
            return Task.CompletedTask;
        return RunOperation($"已升级 {PluginPackage.Name} 到 v{latestVersion}", () =>
            PluginSystem.InstallPlugins([new KeyValuePair<PluginPackage, string>(PluginPackage, latestVersion)]));
    }

    Task Uninstall() => RunOperation($"已卸载 {PluginPackage.Name}", () =>
        PluginSystem.UninstallPlugins([PluginPackage]));

    Task Reinstall()
    {
        if (installedVersion == null)
            return Task.CompletedTask;
        return RunOperation($"已重装 {PluginPackage.Name} v{installedVersion}", () =>
            PluginSystem.InstallPlugins([new KeyValuePair<PluginPackage, string>(PluginPackage, installedVersion)]));
    }

    Task InstallVersion(string version) => RunOperation($"已切换到版本 {version}", () =>
        PluginSystem.InstallPlugins([new KeyValuePair<PluginPackage, string>(PluginPackage, version)]));

    async Task RunOperation(string successMessage, Func<Task> operation)
    {
        if (isOperating)
            return;

        isOperating = true;
        operException = null;
        StateHasChanged();

        try
        {
            await operation();
            _ = NotificationService.Success(new NotificationConfig { Message = successMessage });
        }
        catch (Exception ex)
        {
            operException = ex;
        }
        finally
        {
            isOperating = false;
            RefreshState();
            StateHasChanged();
        }
    }
}
