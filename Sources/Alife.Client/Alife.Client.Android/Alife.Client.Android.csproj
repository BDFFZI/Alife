<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Alife.Client.Android</RootNamespace>
        <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
        <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
        <ApplicationId>com.alife.client</ApplicationId>
        <ApplicationTitle>Alife</ApplicationTitle>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>6.0.0</ApplicationDisplayVersion>
        <Version>6.0.0</Version>
        <AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
        <AndroidPackageFormats>apk</AndroidPackageFormats>
        <PublishTrimmed>false</PublishTrimmed>
        <RunAOTCompilation>false</RunAOTCompilation>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <UseMaui>true</UseMaui>
        <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    </PropertyGroup>

    <!-- All configurations share the repository signing identity. -->
    <PropertyGroup>
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyStore>$(MSBuildProjectDirectory)/Properties/alife.keystore</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
        <AndroidSigningStorePass>android</AndroidSigningStorePass>
        <AndroidSigningKeyPass>android</AndroidSigningKeyPass>
    </PropertyGroup>

    <!-- 只保留一张图标母版，构建时由 MAUI 生成各密度资源。 -->
    <ItemGroup>
        <AndroidResource Remove="Resources/AppIcon/**" />
        <MauiIcon Include="Resources/AppIcon/appicon.png" Color="#3B4BC7" ForegroundScale="0.67" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.13" />
        <PackageReference Include="SharpCompress" Version="0.48.1" />
        <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.14.0.1" />
        <EmbeddedResource Include="SdkPackages.json" LogicalName="SdkPackages" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Alife/Alife.Foundation/Alife.Foundation.csproj" />
        <ProjectReference Include="../../Alife/Alife.Application/Alife.Application.csproj" />
        <ProjectReference Include="../Alife.Client/Alife.Client.csproj" />
        <ProjectReference Include="../Alife.Client.Android.Shizuku/Alife.Client.Android.Shizuku.csproj" />
    </ItemGroup>

    <!-- Explicit opt-in device integration harness; never included in normal APKs. -->
    <ItemGroup Condition="'$(AlifeWindowProbe)' == 'true' and '$(Configuration)' == 'Debug'">
        <Compile Include="../../../Tests/Alife.Test.Android/WindowProbeActivity.cs" Link="WindowProbeActivity.cs" />
    </ItemGroup>

    <PropertyGroup>
        <AlifeAndroidNdkRoot Condition="'$(AlifeAndroidNdkRoot)' == '' and '$(ANDROID_NDK_ROOT)' != ''">$(ANDROID_NDK_ROOT)</AlifeAndroidNdkRoot>
        <AlifeAndroidNdkRoot Condition="'$(AlifeAndroidNdkRoot)' == '' and '$(ANDROID_NDK_HOME)' != ''">$(ANDROID_NDK_HOME)</AlifeAndroidNdkRoot>
        <AlifeAndroidNdkRoot Condition="'$(AlifeAndroidNdkRoot)' == '' and '$(AndroidNdkDirectory)' != ''">$(AndroidNdkDirectory)</AlifeAndroidNdkRoot>
        <AlifeAndroidNdkHost Condition="'$(OS)' == 'Windows_NT'">windows-x86_64</AlifeAndroidNdkHost>
        <AlifeAndroidNdkHost Condition="'$(AlifeAndroidNdkHost)' == ''">linux-x86_64</AlifeAndroidNdkHost>
        <AlifeAndroidClang Condition="'$(AlifeAndroidClang)' == '' and '$(AlifeAndroidNdkRoot)' != '' and '$(OS)' == 'Windows_NT'">$(AlifeAndroidNdkRoot)/toolchains/llvm/prebuilt/$(AlifeAndroidNdkHost)/bin/clang.exe</AlifeAndroidClang>
        <AlifeAndroidClang Condition="'$(AlifeAndroidClang)' == '' and '$(AlifeAndroidNdkRoot)' != '' and '$(OS)' != 'Windows_NT'">$(AlifeAndroidNdkRoot)/toolchains/llvm/prebuilt/$(AlifeAndroidNdkHost)/bin/clang</AlifeAndroidClang>
    </PropertyGroup>

    <!-- 插件 NuGet restore 需要在 Android 上以 hostfxr 方式启动 termux .NET，故随 APK 嵌入原生 launcher。 -->
    <Target Name="BuildSdkLauncher" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup Condition="'$(AlifeAndroidClang)' == ''">
            <_AlifeNdkClang Include="$(ANDROID_SDK_ROOT)/ndk/*/toolchains/llvm/prebuilt/$(AlifeAndroidNdkHost)/bin/clang"/>
            <_AlifeNdkClang Include="$(ANDROID_SDK_ROOT)/ndk/*/toolchains/llvm/prebuilt/$(AlifeAndroidNdkHost)/bin/clang.exe"/>
        </ItemGroup>
        <PropertyGroup>
            <_AlifeClang Condition="'$(AlifeAndroidClang)' != ''">$(AlifeAndroidClang)</_AlifeClang>
            <_AlifeClang Condition="'$(_AlifeClang)' == ''">@(_AlifeNdkClang)</_AlifeClang>
        </PropertyGroup>
        <Error Condition="'$(_AlifeClang)' == ''" Text="未找到 Android NDK。请设置 AlifeAndroidClang，或设置 ANDROID_NDK_ROOT。"/>
        <MakeDir Directories="$(IntermediateOutputPath)native"/>
        <Exec Command="&quot;$(_AlifeClang)&quot; --target=aarch64-linux-android26 &quot;$(MSBuildProjectDirectory)/Native/sdk-launcher.c&quot; -ldl -O2 -o &quot;$(IntermediateOutputPath)native/sdk-launcher&quot;"/>
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)native/sdk-launcher" LogicalName="SdkLauncher"/>
        </ItemGroup>
    </Target>
</Project>
