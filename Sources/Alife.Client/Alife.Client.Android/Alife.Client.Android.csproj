<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Alife.Client.Android</RootNamespace>
    <Version>4.6.1</Version>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ApplicationId>com.alife.client</ApplicationId>
    <ApplicationTitle>Alife</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>4.6.1</ApplicationDisplayVersion>
    <AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只引用 Foundation：Alife.Client 会带入 ASP.NET Core 框架引用，其没有 android-arm64 运行时包；
         窗口契约（IAlifeWebWindow.cs）已下沉到 Foundation，命名空间保持 Alife.Client 不变 -->
    <ProjectReference Include="../../Alife/Alife.Foundation/Alife.Foundation.csproj" />
    <!-- 与后端共享的宿主协议，避免把 Web 后端引用进 APK -->
    <Compile Include="..\Alife.Client.Android.Backend\NativeHostCommand.cs" Link="Shared\NativeHostCommand.cs" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <EmbeddedResource Include="SdkPackages.json" LogicalName="SdkPackages" />
  </ItemGroup>

  <!-- 发布后端并嵌入 APK，运行时解压到 Runtime/ClientServer 由 sdk-launcher 拉起 -->
  <Target Name="EmbedBackend" BeforeTargets="AssignTargetPaths">
    <PropertyGroup><BackendDirectory>$(MSBuildProjectDirectory)/obj/backend-publish</BackendDirectory></PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Alife.Client.Android.Backend/Alife.Client.Android.Backend.csproj&quot; -c $(Configuration) --no-self-contained -p:RuntimeIdentifier= -o &quot;$(BackendDirectory)&quot; --nologo -v:q" />
    <ZipDirectory SourceDirectory="$(BackendDirectory)" DestinationFile="$(IntermediateOutputPath)backend.zip" Overwrite="true" />
    <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)backend.zip" LogicalName="Backend" /></ItemGroup>
  </Target>
  <Target Name="BuildSdkLauncher" BeforeTargets="AssignTargetPaths">
    <Error Condition="'$(AlifeAndroidClang)' == ''" Text="Set AlifeAndroidClang to the Android NDK clang executable." />
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <Exec Command="&quot;$(AlifeAndroidClang)&quot; --target=aarch64-linux-android26 &quot;$(MSBuildProjectDirectory)/Native/sdk-launcher.c&quot; -ldl -o &quot;$(IntermediateOutputPath)native/sdk-launcher&quot;" />
    <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)native/sdk-launcher" LogicalName="SdkLauncher" /></ItemGroup>
  </Target>
</Project>
