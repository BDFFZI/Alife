<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Alife.Client.Android.Backend</RootNamespace>
    <AssemblyName>Alife.Client.Android.Backend</AssemblyName>
    <!-- 由原生启动器经 hostfxr 拉起 dll，无需 apphost -->
    <UseAppHost>false</UseAppHost>
    <Version>4.6.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Alife/Alife.Foundation/Alife.Foundation.csproj" />
    <ProjectReference Include="../Alife.Client/Alife.Client.csproj" />
    <Content Include="../Alife.Client.Windows/wwwroot/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
