@namespace Alife.Function.Mcp
@inherits Alife.Framework.ModuleUIBase<McpService, McpServerConfig>
@using AntDesign

<div style="background: #fff; padding: 20px; border-radius: 8px;">
    <Flex Justify="@(FlexJustify.SpaceBetween)" Align="@(FlexAlign.Center)" Style="margin-bottom: 24px;">
        <Title Level="4" Style="margin: 0;">MCP 服务器管理</Title>
        <Button Type="@ButtonType.Primary" OnClick="AddServer">添加服务器</Button>
    </Flex>

    <Table TItem="McpServerItem" DataSource="@Configuration.Servers" Bordered Size="@TableSize.Small">
        <PropertyColumn Property="c=>c.Name" Title="名称"></PropertyColumn>
        <PropertyColumn Property="c=>c.IsUrlServer" Title="类型">
            @(context.IsUrlServer ? "URL 服务" : "本地命令")
        </PropertyColumn>
        <PropertyColumn Property="c=>c.Endpoint" Title="命令/地址">
            @(context.IsUrlServer ? context.Endpoint : context.Command)
        </PropertyColumn>
        <PropertyColumn Property="c=>c.Description" Title="描述"></PropertyColumn>
        <PropertyColumn Property="c=>c.IsImplicit" Title="渐进加载">
            <Switch @bind-Value="context.IsImplicit"/>
        </PropertyColumn>
        <PropertyColumn Property="c=>c.Enabled" Title="启用">
            <Switch @bind-Value="context.Enabled"/>
        </PropertyColumn>
        <ActionColumn Title="操作">
            <Space>
                <SpaceItem>
                    <Button Size="@ButtonSize.Small" OnClick="@(() => EditServer(context))">编辑</Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Size="@ButtonSize.Small" Danger OnClick="@(() => RemoveServer(context))">删除</Button>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </Table>

    <Drawer Title="@("服务器配置")"
            Visible="isEditingServer"
            Width="420"
            OnClose="CloseEditor">
        @if (editingServer != null)
        {
            <Form TModel="McpServerItem" Model="@editingServer" Layout="@FormLayout.Vertical">
                <FormItem Label="名称">
                    <Input @bind-Value="editingServer.Name"/>
                </FormItem>
                <FormItem Label="描述">
                    <Input @bind-Value="editingServer.Description"/>
                </FormItem>
                <FormItem Label="连接方式">
                    <Segmented TValue="string"
                               Value="@(isUrlType ? "url" : "local")"
                               ValueChanged="@OnTypeChanged"
                               Block>
                        <SegmentedItem Value="@("local")" Label="本地命令"/>
                        <SegmentedItem Value="@("url")" Label="URL 服务"/>
                    </Segmented>
                </FormItem>

                @if (isUrlType)
                {
                    <FormItem Label="服务器地址 (URL)">
                        <Input @bind-Value="editingServer.Endpoint" Placeholder="如 http://127.0.0.1:18765/mcp"/>
                    </FormItem>
                }
                else
                {
                    <FormItem Label="可执行文件 (Command)">
                        <Input @bind-Value="editingServer.Command"/>
                    </FormItem>
                    <FormItem Label="参数 (每个参数一行)">
                        <TextArea Value="@string.Join('\n', editingServer.Arguments)"
                                  ValueChanged="@(val => editingServer.Arguments = val.Split('\n', StringSplitOptions.RemoveEmptyEntries))"
                                  Rows="4"></TextArea>
                    </FormItem>
                }

                <FormItem>
                    <Button Type="@ButtonType.Primary" OnClick="CloseEditor" Block>完成</Button>
                </FormItem>
            </Form>
        }
    </Drawer>
</div>

@code {

    McpServerItem? editingServer;
    bool isEditingServer;
    bool isUrlType;

    void AddServer()
    {
        editingServer = new McpServerItem();
        Configuration.Servers.Add(editingServer);
        isUrlType = false;
        isEditingServer = true;
    }

    void EditServer(McpServerItem server)
    {
        editingServer = server;
        isUrlType = server.IsUrlServer;
        isEditingServer = true;
    }

    void RemoveServer(McpServerItem server)
    {
        Configuration.Servers.Remove(server);
    }

    void OnTypeChanged(string value)
    {
        if (editingServer == null)
            return;

        isUrlType = value == "url";
        //切换连接方式时清空另一种方式填写的配置，避免歧义
        if (isUrlType)
            editingServer.Command = "";
        else
            editingServer.Endpoint = "";
    }

    void CloseEditor()
    {
        isEditingServer = false;
    }
}
