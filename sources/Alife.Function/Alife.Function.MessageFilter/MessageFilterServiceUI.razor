@namespace Alife.Function.MessageFilter
@inherits Alife.Framework.ModuleUIBase<MessageFilterService, MessageFilterServiceConfig>
@using AntDesign
@using static Alife.Function.MessageFilter.MessageFilterServiceConfig
@implements IDisposable

<div style="background: #fafafa; padding: 24px; border-radius: 12px; border: 1px solid #f0f0f0;">
    <Flex Direction="FlexDirection.Vertical" Gap="@("24")">
        @* ───── 运行时状态 ───── *@
        @if (Module != null)
        {
            <div>
                <Flex Justify="FlexJustify.SpaceBetween" Align="FlexAlign.Center" Style="margin-bottom: 16px;">
                    <Title Level="4" Style="margin: 0;">当前生效的回复规则</Title>
                    <AntDesign.Text Type="TextElementType.Secondary">
                        共 @Module.MessageReplyRules.Count 条规则
                    </AntDesign.Text>
                </Flex>

                @if (Module.MessageReplyRules.Count == 0)
                {
                    <div style="padding: 16px; background: #fff; border-radius: 8px; border: 1px dashed #d9d9d9;">
                        <AntDesign.Text Type="TextElementType.Secondary">暂无生效中的规则</AntDesign.Text>
                    </div>
                }
                else
                {
                    <div style="max-height: 300px; overflow-y: auto; background: #fff; border-radius: 8px; border: 1px solid #f0f0f0;">
                        @foreach (var rule in Module.MessageReplyRules)
                        {
                            <div style="padding: 12px 16px; border-bottom: 1px solid #f0f0f0;">
                                <Flex Justify="FlexJustify.SpaceBetween" Align="FlexAlign.Center">
                                    <Space Align="SpaceAlign.Center">
                                        <SpaceItem>
                                            <Tag Color="TagColor.Blue">@rule.Name</Tag>
                                        </SpaceItem>
                                    </Space>
                                </Flex>
                            </div>
                        }
                    </div>
                }
            </div>

            <Divider />
        }

        @* ───── 配置部分 ───── *@
        <div>
            <Title Level="4" Style="margin-bottom: 16px;">消息滤网配置</Title>
            <Text Type="TextElementType.Secondary">统一管理所有消息的附加提示词和格式化模板。</Text>
        </div>

        <GridRow Gutter="16">
            <GridCol Span="24">
                <Flex Align="FlexAlign.Center" Style="margin-bottom: 24px;">
                    <Text Strong Style="margin-right: 12px;">注入当前时间 (Timestamp)</Text>
                    <Switch @bind-Checked="@Configuration.EnableTimestamp"/>
                </Flex>
            </GridCol>

            <GridCol Span="24">
                <div style="margin-bottom: 16px;">
                    <Text Strong Style="display: block; margin-bottom: 8px;">消息附加内容 (MessageHeader)</Text>
                    <Text Type="TextElementType.Secondary"
                          Style="font-size: 12px; display: block; margin-bottom: 8px;">
                        将附加在每条发给 AI 的消息末尾，可用于约束回复风格。
                    </Text>
                    <TextArea @bind-Value="@Configuration.MessageAppend" Rows="3"
                              Style="border-radius: 8px;"></TextArea>
                </div>
            </GridCol>

            <GridCol Span="24">
                <div style="margin-bottom: 16px;">
                    <Text Strong Style="display: block; margin-bottom: 8px;">通知消息附加内容 (PokeHeader)</Text>
                    <Text Type="TextElementType.Secondary"
                          Style="font-size: 12px; display: block; margin-bottom: 8px;">
                        将附加在每条发给 AI 的通知消息末尾，用于对通知消息进行特别约束。
                    </Text>
                    <TextArea @bind-Value="@Configuration.PokeAppend" Rows="2" Style="border-radius: 8px;"></TextArea>
                </div>
            </GridCol>

            <GridCol Span="24">
                <Flex Direction="FlexDirection.Vertical" Style="margin-bottom: 16px;">
                    <Text Strong Style="margin-bottom: 8px;">最大消息长度 (MaxMessageLength)</Text>
                    <Text Type="TextElementType.Secondary"
                          Style="font-size: 12px; display: block; margin-bottom: 8px;">
                        AI 一次性接收的最大消息长度，超出部分将被截断，防止意外操作淹没上下文。
                    </Text>
                    <InputNumber @bind-Value="@Configuration.MaxMessageLength" Min="100" Max="100000"
                                 Style="width: 200px;" />
                </Flex>
            </GridCol>

            <GridCol Span="24">
                <Flex Direction="FlexDirection.Vertical" Style="margin-bottom: 16px;">
                    <Text Strong Style="margin-bottom: 8px;">注入间隔 (InjectionInterval)</Text>
                    <Text Type="TextElementType.Secondary"
                          Style="font-size: 12px; display: block; margin-bottom: 8px;">
                        每隔多少条消息注入一次消息附加内容，设为 0 则每条都注入。
                    </Text>
                    <InputNumber @bind-Value="@Configuration.InjectionInterval" Min="0" Max="10000"
                                 Style="width: 200px;" />
                </Flex>
            </GridCol>

            <GridCol Span="24">
                <div style="margin-bottom: 16px;">
                    <Flex Justify="FlexJustify.SpaceBetween" Align="FlexAlign.Center" Style="margin-bottom: 12px;">
                        <div>
                            <Text Strong Style="display: block;">消息回复规则 (ReplyRules)</Text>
                            <Text Type="TextElementType.Secondary" Style="font-size: 12px;">
                                当 AI 回复不满足正则条件时，自动 Poke 提示文本进行纠正。共 @Configuration.MessageReplyRules.Count 条规则。
                            </Text>
                        </div>
                        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="AddRule">添加规则</Button>
                    </Flex>

                    @if (Configuration.MessageReplyRules.Count == 0)
                    {
                        <div style="margin-bottom: 12px;">
                            <Text Type="TextElementType.Secondary" Style="font-size: 12px;">暂无规则，点击"添加规则"创建。</Text>
                        </div>
                    }

                    @for (int i = 0; i < Configuration.MessageReplyRules.Count; i++)
                    {
                        var index = i;
                        var rule = Configuration.MessageReplyRules[index];
                        <MessageReplyRuleCard @key="rule" Rule="@rule" Index="@index" OnRemove="@RemoveRule"/>
                    }
                </div>
            </GridCol>
        </GridRow>
    </Flex>
</div>

@code {
    System.Timers.Timer? refreshTimer;

    protected override void OnInitialized()
    {
        refreshTimer = new System.Timers.Timer(1000);
        refreshTimer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        refreshTimer.Start();
    }

    void AddRule()
    {
        var list = new List<RegexMessageReplyRuleConfig>(Configuration.MessageReplyRules)
        {
            new RegexMessageReplyRuleConfig() { Name = $"规则 {Configuration.MessageReplyRules.Count + 1}" }
        };
        Configuration.MessageReplyRules = list;
    }

    void RemoveRule(RegexMessageReplyRuleConfig rule)
    {
        var list = new List<RegexMessageReplyRuleConfig>(Configuration.MessageReplyRules);
        list.Remove(rule);
        Configuration.MessageReplyRules = list;
    }

    public void Dispose()
    {
        refreshTimer?.Stop();
        refreshTimer?.Dispose();
    }
}
