@namespace Alife.Function.DeskPet
@using AntDesign
@using Alife.Framework
@inherits ModuleUIBase<DeskPetService, DeskPetServiceConfig>

<div style="background: #fafafa; padding: 24px; border-radius: 12px; border: 1px solid #f0f0f0;">
    <Flex Direction="FlexDirection.Vertical" Gap="@("24")">
        <Form TModel="DeskPetServiceConfig" Model="@Configuration" Layout="@FormLayout.Vertical">
            <FormItem Label="气泡时长 (ms/字)">
                <InputNumber @bind-Value="@Configuration.BubbleDurationPerCharMs" Min="0" Max="5000" Placeholder="200"/>
                <Text Type="TextElementType.Secondary" Style="font-size: 11px;">
                    每个字符显示的毫秒数，气泡最短显示时间为 字数 × 此值。
                </Text>
            </FormItem>
        </Form>
    </Flex>
</div>