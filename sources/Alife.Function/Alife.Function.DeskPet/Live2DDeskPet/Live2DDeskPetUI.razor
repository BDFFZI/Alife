@namespace Alife.Function.DeskPet
@using System.IO
@using System.Diagnostics
@using System.Linq
@using AntDesign
@using Alife.Framework
@inherits ModuleUIBase<Live2DDeskPet, Live2DDeskPetConfig>

@if (isDownloading)
{
    <Spin Tip="下载默认模型中...">
    </Spin>
}
else
{
    <div style="background: #fafafa; padding: 24px; border-radius: 12px; border: 1px solid #f0f0f0;">
        <Flex Direction="FlexDirection.Vertical" Gap="@("24")">
            <Form TModel="Live2DDeskPetConfig" Model="@Configuration" Layout="@FormLayout.Vertical">
                <FormItem Label="模型名">
                    <Select @bind-Value="Configuration.ModelName"
                            TItem="string"
                            TItemValue="string"
                            Style="width: 100%;"
                            Placeholder="选择模型"
                            AllowClear="true">
                        <SelectOptions>
                            @foreach (var folder in modelFolders)
                            {
                                <SelectOption TItem="string" TItemValue="string" Value="@folder" Label="@folder" />
                            }
                        </SelectOptions>
                    </Select>
                    <Text Type="TextElementType.Secondary" Style="font-size: 11px;">
                        从存储目录 <code>Storage/DeskPet/Live2D/model/</code> 下的模型文件夹中选择。
                        将按 <code>{名称}/{名称}.model3.json</code> 或 <code>{名称}/{名称}.model.json</code> 规则加载。留空则使用默认角色 "Mao"。
                    </Text>
                </FormItem>
            </Form>

            <Button Type="@ButtonType.Default" Icon="folder-open" OnClick="OpenModelFolder">
                打开模型文件夹
            </Button>

            <Button Type="@ButtonType.Default" Icon="reload" OnClick="ResetWindow">
                重置窗口位置大小
            </Button>

            <Card Size="CardSize.Small" Title="自定义模型说明" Style="border-radius: 8px;">
                <div style="padding: 8px 0; font-size: 13px; line-height: 1.8;">
                    <Text Type="TextElementType.Secondary">
                        1. 将 Live2D Cubism 模型文件夹放入存储目录 <code>Storage/DeskPet/Live2D/model/</code> 中。<br/>
                        2. 输入文件夹名即可加载，系统自动按 <code>{{名称}}/{{名称}}.model3.json</code> 或 <code>{{名称}}/{{名称}}.model.json</code>
                        定位。<br/>
                        3. 本系统额外支持 <code>Interaction</code> 扩展字段，定义点击/晃动/启动等交互反馈。
                        每个交互可以配置随机触发的<strong>气泡文本 + 表情 + 动作</strong>组合。
                        格式参考 <code>Mao.model3.json</code> 中的同名顶层字段；Cubism 2 模型可在
                        <code>.model.json</code>
                        中添加同名顶层字段。<br/>
                        4. 如不提供 <code>Interaction</code> 字段，模型可正常显示但无互动反馈。<br/>
                        5. 目前支持 8 种交互类型：<code>head</code>、<code>body</code>、<code>rotate</code>、
                        <code>window_shake</code>、<code>window_move</code>、<code>mouse_shake</code>、
                        <code>mouse_combo</code>、<code>startup</code>。
                    </Text>
                </div>
            </Card>
        </Flex>
    </div>
}

@code {
    bool isDownloading;
    List<string> modelFolders = new();

    protected override async Task OnInitializedAsync()
    {
        isDownloading = true;
        StateHasChanged();
        await Live2DDeskPet.EnsureDefaultModelsAsync();
        isDownloading = false;

        modelFolders = Directory.Exists(Live2DDeskPet.ModelRoot)
            ? Directory.GetDirectories(Live2DDeskPet.ModelRoot).Select(Path.GetFileName).Where(name => !string.IsNullOrEmpty(name)).ToList()!
            : new List<string>();

        // 确保当前配置值在可选范围内，否则回退到默认角色
        if (string.IsNullOrEmpty(Configuration.ModelName) || modelFolders.Contains(Configuration.ModelName) == false)
            Configuration.ModelName = modelFolders.Contains("Mao") ? "Mao" : modelFolders.FirstOrDefault() ?? "";

        StateHasChanged();
    }

    void OpenModelFolder()
    {
        Process.Start("explorer.exe", $"\"{Live2DDeskPet.ModelRoot}\"");
    }

    void ResetWindow()
    {
        Module?.ResetWindow();
    }
}