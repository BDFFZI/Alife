@inject PluginSystem PluginSystem
@inject StorageSystem StorageSystem
@implements IDisposable

@if (upgradableCount > 0)
{
    <Badge Count="@(upgradableCount)" Size="@BadgeSize.Small">
        <Tooltip Title="一键升级所有插件">
            <Button Type="@ButtonType.Link" Icon="@IconType.Outline.ArrowUp" OnClick="@(() => showUpgradeModal = true)"
                    Style="@($"color: {(upgradableCount > 0 ? "#52c41a" : "#d9d9d9")};")"
                    Class="@("upgrade-btn" + (showUpgradeModal || hideUpgradeAnimation ? " upgrade-paused" : ""))">
                一键升级
            </Button>
        </Tooltip>
    </Badge>

    <PluginUpgradeModal @bind-Visible="showUpgradeModal"
                        UpgradeList="upgradeList">
        <HeaderContent>
            <div style="font-size: 12px; color: rgba(0,0,0,0.45); margin-bottom: 12px; line-height: 1.8;">
                一键升级不仅可以批量配置插件环境，还可以避免插件版本冲突，实现更快更安全的升级，<b style="color: #1890ff;">建议总是使用一键升级来升级插件</b>。
                <Checkbox @bind-Value="hideUpgradeAnimation" OnChange="@OnHideAnimationChanged"
                          Style="margin-left: 4px;">我知道了
                </Checkbox>
            </div>
        </HeaderContent>
    </PluginUpgradeModal>
}

<style>
    .upgrade-btn {
        color: #52c41a !important;
        animation: upgrade-bounce 1s ease-in-out infinite;
        transform-origin: center bottom;
    }

    .upgrade-btn:hover {
        animation: none;
        transform: scale(1.1);
    }

    .upgrade-paused {
        animation: none !important;
    }

    @@keyframes upgrade-bounce {
        0%, 100% {
            transform: rotate(0deg) scale(1);
        }
        20% {
            transform: rotate(-15deg) scale(1.25);
        }
        40% {
            transform: rotate(12deg) scale(1.15);
        }
        60% {
            transform: rotate(-10deg) scale(1.2);
        }
        80% {
            transform: rotate(8deg) scale(1.1);
        }
    }
</style>

@code {
    List<PluginUpgradeModal.UpgradeItem> upgradeList = [];
    int upgradableCount;

    bool showUpgradeModal;
    bool hideUpgradeAnimation;

    protected override void OnInitialized()
    {
        hideUpgradeAnimation = StorageSystem.GetObject("Settings/PluginMarketViewConfig", new UpgradeAnimationConfig())?.HideUpgradeAnimation ?? false;
        UpdateUpgradeList();
        PluginSystem.PluginSynced += UpdateUpgradeList;
    }
    public void Dispose()
    {
        PluginSystem.PluginSynced -= UpdateUpgradeList;
    }

    void UpdateUpgradeList()
    {
        upgradeList = PluginSystem.GetAllOnlinePlugins().Values
            .Where(p => PluginSystem.HasUpdate(p))
            .Select(p => new PluginUpgradeModal.UpgradeItem {
                PluginPackage = p,
                NewVersion = PluginSystem.GetLatestVersion(p)!,
                OldVersion = PluginSystem.GetInstalledVersion(p.Id)!
            })
            .ToList();
        upgradableCount = upgradeList.Count;
        InvokeAsync(StateHasChanged);
    }

    void OnHideAnimationChanged(bool checkedValue)
    {
        var config = StorageSystem.GetObject("Settings/PluginMarketViewConfig", new UpgradeAnimationConfig()) ?? new UpgradeAnimationConfig();
        config.HideUpgradeAnimation = checkedValue;
        StorageSystem.SetObject("Settings/PluginMarketViewConfig", config);
        StateHasChanged();
    }

    class UpgradeAnimationConfig
    {
        public bool HideUpgradeAnimation { get; set; }
    }

}
