@inject IAlifeClient AlifeClient
@inject IJSRuntime JsRuntime
@inject IServiceProvider ServiceProvider
@inject ClientConfigStore ClientConfigStore
@implements IAsyncDisposable

@if (isAppInitialized)
{
    <ErrorBoundary>
        <ChildContent>
            <Router AppAssembly="typeof(App).Assembly">
                <Found Context="routeData">
                    <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)"/>
                    <FocusOnNavigate RouteData="routeData" Selector="h1"/>
                </Found>
            </Router>
        </ChildContent>
        <ErrorContent Context="ex">
            @{
                <ErrorWindowUI Value="ex" Title="系统崩溃" ValueChanged="@(() => AlifeClient.Exit())"/>
            }
        </ErrorContent>
    </ErrorBoundary>
}
else
{
    <Launching SubTitle="@launchingProgress"/>
}

<LogOverlay/>
<AntContainer/>
<ErrorWindowUI @bind-Value="@exception" Title="系统初始化异常"/>

@* 自定义关闭事件 *@
<script>
    window.alifeRegisterCloseHandler = (dotNetRef) => {
        window.addEventListener('beforeunload', (e) => {
            e.returnValue = false;
            dotNetRef.invokeMethodAsync('Quit');
        });
    };
</script>

@code
{
    string? launchingProgress;
    bool isAppInitialized;
    Exception? exception;
    DotNetObjectReference<Routes>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == false)
            return;

        //注册自定义关闭事件（JS互操作必须在交互式渲染的OnAfterRenderAsync中调用，写在App.razor的静态渲染里不会生效）
        selfRef = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("alifeRegisterCloseHandler", selfRef);

        //业务环境初始化（故意放在UI中初始化以便获得通过UI展示进度的能力）
        try
        {
            await Task.Run(async () =>
            {
                Progress<string> progress = new Progress<string>(state =>
                {
                    launchingProgress = state;
                    InvokeAsync(StateHasChanged);
                });
                //启动配置可在系统配置页面修改，此处读取用户保存的配置（未修改过的项取客户端默认值）
                AlifeClient.InitConfig config = ClientConfigStore.GetInitConfig();
                await ServiceProvider.InitAlifeClient(config, progress);
            });
        }
        catch (Exception ex)
        {
            exception = ex;
        }

        isAppInitialized = true;
        await JsRuntime.InvokeVoidAsync("alifeLaunching.complete");

        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    [JSInvokable]
    public void Quit() => AlifeClient.Quit();


}
