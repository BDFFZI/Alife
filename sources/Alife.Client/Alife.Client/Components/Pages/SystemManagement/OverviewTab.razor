@inject INotificationService NotificationService
@inject IAlifeClient AlifeClient
@inject ClientConfigStore ClientConfigStore

<div style="padding: 24px; height: 100%; overflow-y: auto;">
    <Title Level="4" Style="margin-bottom: 24px;">系统配置</Title>

    <div style="margin-bottom: 24px;">
        <Text Strong Style="margin-bottom: 8px; display: block;">数据存储目录 (Storage)</Text>
        <div style="display: flex; gap: 8px; align-items: center;">
            <Input @bind-Value="storageFolderPath" Style="flex: 1;" ReadOnly/>
            <Button Icon="@IconType.Outline.FolderOpen" OnClick="@PickStorageFolderAsync"></Button>
        </div>
        <Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 4px; display: block;">
            存放角色数据、对话记录等用户数据。重启后生效。
        </Text>
    </div>

    <div style="margin-bottom: 24px;">
        <Text Strong Style="margin-bottom: 8px; display: block;">运行时目录 (Runtime)</Text>
        <div style="display: flex; gap: 8px; align-items: center;">
            <Input @bind-Value="runtimeFolderPath" Style="flex: 1;" ReadOnly/>
            <Button Icon="@IconType.Outline.FolderOpen" OnClick="@PickRuntimeFolderAsync"></Button>
        </div>
        <Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 4px; display: block;">
            存放浏览器缓存、运行环境等可再生数据。重启后生效。
        </Text>
    </div>
    
    <div style="margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <Text Strong>开机自启</Text>
            <Switch Checked="autoStartOnBoot" OnChange="@OnAutoStartChanged"/>
        </div>
        <Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 4px; display: block;">
            开启后，系统启动时自动运行 Alife。
        </Text>
    </div>

    <Divider Style="margin: 16px 0;"/>

    <Title Level="5" Style="margin-bottom: 4px;">启动配置</Title>
    <Text Type="@TextElementType.Secondary" Style="font-size: 12px; display: block;">
        控制客户端启动时执行的初始化步骤，按需调整后可加速启动速度。重启后生效。
    </Text>

    <div style="display: flex; flex-direction: column; gap: 20px; margin: 16px 0 24px 0;">
        <div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <Text Strong>拉取云端信息</Text>
                <Switch Checked="fetchOnlineInfo" CheckedChanged="OnFetchOnlineInfoChanged"/>
            </div>
            <Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 4px; display: block;">
                启动时从云端拉取客户端版本和插件清单。部分老插件依赖云端清单判断环境依赖，若已确保插件环境正常，可以关闭。
            </Text>
        </div>

        <div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <Text Strong>加载本地插件</Text>
                <Switch Checked="loadLocalPlugins" CheckedChanged="OnLoadLocalPluginsChanged"/>
            </div>
            <Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 4px; display: block;">
                启动时加载插件文件夹中的插件。若所有功能都已内置在客户端中，可以关闭。
            </Text>
        </div>

        <div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <Text Strong>检查插件环境</Text>
                <Switch Checked="ensureEnvironment" 
                        CheckedChanged="OnEnsureEnvironmentChanged"
                        Disabled="loadLocalPlugins == false"/>
            </div>
            <Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 4px; display: block;">
                启动时尝试补全插件环境，可确保环境完整，但会降低启动速度。环境出问题时仍可在插件环境页面手动重载。
            </Text>
        </div>

        <div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <Text Strong>启用 MCP 服务</Text>
                <Switch Checked="mcpServer" CheckedChanged="OnMcpServerChanged"/>
            </div>
            <Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 4px; display: block;">
                开放 MCP 服务，让外部程序（或AI）可以调用 Alife 的系统能力。不需要此功能时可以关闭。
            </Text>
        </div>

        <div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <Text Strong>MCP 服务端口</Text>
                <AntDesign.InputNumber TValue="int" Value="mcpServerPort"
                                       ValueChanged="OnMcpServerPortChanged"
                                       Min="1" Max="65535"
                                       Disabled="mcpServer == false"
                                       Style="width: 120px;"/>
            </div>
            <Text Type="@TextElementType.Secondary" Style="font-size: 12px; margin-top: 4px; display: block;">
                MCP 服务监听的本地端口。仅在启用 MCP 服务时有效，修改端口后需同步修改外部程序的连接配置。
            </Text>
        </div>
    </div>

    <Divider Style="margin: 16px 0;"/>

    <Title Level="5" Style="margin-bottom: 12px;">版本信息</Title>
    <Descriptions Column="1" Size="@DescriptionsSize.Small" Bordered>
        <DescriptionsItem Title="当前版本">
            <Text Code Style="font-size: 12px;">v@(ClientUpgrade.CurrentVersion)</Text>
        </DescriptionsItem>
        @if (ClientUpgrade.NewVersion != null)
        {
            <DescriptionsItem Title="最新版本">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <Text Code Style="font-size: 12px; color: #52c41a;">v@(ClientUpgrade.NewVersion.Version)</Text>
                    @if (isUpgradeDownloading)
                    {
                        <Progress Percent="@upgradeDownloadProgress" Status="ProgressStatus.Active"
                                  Style="flex: 1;"></Progress>
                    }
                    else
                    {
                        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@StartClientUpdate">立即升级
                        </Button>
                    }
                </div>
            </DescriptionsItem>
        }
    </Descriptions>
    <div style="margin-top: 8px;">
        @if (isUpgradeChecking)
        {
            <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 12px;">正在检查更新...</AntDesign.Text>
        }
        else if (ClientUpgrade.NewVersion == null)
        {
            <Button Size="@ButtonSize.Small" OnClick="@CheckClientUpdate">检查更新</Button>
        }
    </div>
</div>

@code {
    bool isUpgradeChecking;
    bool isUpgradeDownloading;
    int upgradeDownloadProgress;

    //路径配置
    string storageFolderPath = AlifePath.StorageFolderPath;
    string runtimeFolderPath = AlifePath.RuntimeFolderPath;
    //启动配置
    bool fetchOnlineInfo;
    bool loadLocalPlugins;
    bool ensureEnvironment;
    bool mcpServer;
    int mcpServerPort;
    //其他配置
    bool autoStartOnBoot;

    protected override void OnInitialized()
    {
        AlifeClient.InitConfig initConfig = ClientConfigStore.GetInitConfig();
        fetchOnlineInfo = initConfig.FetchOnlineInfo;
        loadLocalPlugins = initConfig.LoadLocalPlugins;
        ensureEnvironment = initConfig.EnsureEnvironment;
        mcpServer = initConfig.McpServer;
        mcpServerPort = initConfig.McpServerPort;

        autoStartOnBoot = AlifeClient.GetAutoStart();
    }

    void OnFetchOnlineInfoChanged(bool value)
    {
        fetchOnlineInfo = value;
        SaveStartupConfig();
    }
    void OnLoadLocalPluginsChanged(bool value)
    {
        loadLocalPlugins = value;
        SaveStartupConfig();
    }
    void OnEnsureEnvironmentChanged(bool value)
    {
        ensureEnvironment = value;
        SaveStartupConfig();
    }
    void OnMcpServerChanged(bool value)
    {
        mcpServer = value;
        SaveStartupConfig();
    }
    void OnMcpServerPortChanged(int value)
    {
        mcpServerPort = value;
        SaveStartupConfig();
    }
    void SaveStartupConfig()
    {
        ClientConfigStore.SetInitConfig(new AlifeClient.InitConfig {
            FetchOnlineInfo = fetchOnlineInfo,
            LoadLocalPlugins = loadLocalPlugins,
            EnsureEnvironment = ensureEnvironment,
            McpServer = mcpServer,
            McpServerPort = mcpServerPort,
        });

        _ = NotificationService.Success(new NotificationConfig { Message = "启动配置已保存！重启后生效喵~" });
    }

    void OnAutoStartChanged(bool value)
    {
        autoStartOnBoot = value;
        AlifeClient.SetAutoStart(value);

        _ = NotificationService.Success(new NotificationConfig { Message = value ? "已开启开机自启" : "已关闭开机自启" });
    }

    async Task CheckClientUpdate()
    {
        isUpgradeChecking = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await ClientUpgrade.FetchNewVersion();
            if (ClientUpgrade.NewVersion == null)
                _ = NotificationService.Success(new NotificationConfig { Message = "当前已是最新版本。" });
        }
        catch (Exception e)
        {
            await NotificationService.Error(new NotificationConfig {
                NotificationType = NotificationType.Error,
                Message = "检查更新失败。",
            });
            AlifeLog.LogError(e);
        }
        finally
        {
            isUpgradeChecking = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    async Task StartClientUpdate()
    {
        isUpgradeDownloading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await ClientUpgrade.InstallNewVersion(AlifeClient, progress =>
            {
                upgradeDownloadProgress = progress;
                InvokeAsync(StateHasChanged);
            });
        }
        finally
        {
            isUpgradeDownloading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task PickStorageFolderAsync()
    {
        string? result = await PickFolderAsync();
        if (string.IsNullOrWhiteSpace(result) is false)
        {
            storageFolderPath = result;
            AlifeContext.SetStorageFolderPath(storageFolderPath);
            _ = NotificationService.Success(new NotificationConfig { Message = "存储路径已保存！重启后生效喵~" });
        }
    }
    async Task PickRuntimeFolderAsync()
    {
        string? result = await PickFolderAsync();
        if (string.IsNullOrWhiteSpace(result) is false)
        {
            runtimeFolderPath = result;
            AlifeContext.SetRuntimeFolderPath(runtimeFolderPath);
            _ = NotificationService.Success(new NotificationConfig { Message = "运行时目录已保存！重启后生效喵~" });
        }
    }
    async Task<string?> PickFolderAsync()
    {
        return await AlifeClient.ShowSelectDirectoryDialog();
    }
}
