@inject ChatActivitySystem ChatActivitySystem
@implements IDisposable

<CharacterLoadingUI Visible="@isLoading"
                    Title=@($"正在激活 {activeCharacterName}")
                    TaskDescription="@loadingTask"
                    Progress="@loadingProgress"/>

<ErrorWindowUI Title="角色激活失败喵！" @bind-Value="@activityException"/>

@code {
    bool isLoading;
    string activeCharacterName = "";
    string loadingTask = "正在初始化环境喵...";
    float loadingProgress;
    Exception? activityException;

    protected override void OnInitialized()
    {
        ChatActivitySystem.Activating += OnActivating;
        ChatActivitySystem.ActivatingProcess += OnActivatingProcess;
        ChatActivitySystem.Activated += OnActivated;
        ChatActivitySystem.ActivationFailed += OnActivationFailed;
    }

    public void Dispose()
    {
        ChatActivitySystem.Activating -= OnActivating;
        ChatActivitySystem.ActivatingProcess -= OnActivatingProcess;
        ChatActivitySystem.Activated -= OnActivated;
        ChatActivitySystem.ActivationFailed -= OnActivationFailed;
    }

    void OnActivating(Character character)
    {
        activeCharacterName = character.Name;
        isLoading = true;
        loadingProgress = 0;
        loadingTask = "正在初始化环境喵...";
        activityException = null;
        InvokeAsync(StateHasChanged);
    }
    void OnActivated(ChatActivity chatActivity)
    {
        isLoading = false;
        InvokeAsync(StateHasChanged);
    }

    void OnActivatingProcess(Character character, (string Task, float Progress) tuple)
    {
        if (character.Name != activeCharacterName) return;
        loadingTask = tuple.Task;
        loadingProgress = tuple.Progress;
        InvokeAsync(StateHasChanged);
    }
    void OnActivationFailed(Character character, Exception ex)
    {
        if (character.Name != activeCharacterName) return;
        isLoading = false;

        activityException = ex;
        InvokeAsync(StateHasChanged);
    }
}
