<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- 编码环境 -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Alife</RootNamespace>
        <!-- 发布设置-->
        <ApplicationIcon>alife-icon.ico</ApplicationIcon>
        <ElectronIcon>alife-icon.ico</ElectronIcon>
        <SelfContained>true</SelfContained>
        <PublishSelfContained>true</PublishSelfContained>
        <Version>4.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ElectronNET.Core" Version="0.5.2" />
        <PackageReference Include="ElectronNET.Core.AspNet" Version="0.5.2" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alife.Framework\Alife.Framework.csproj"/>
        <ProjectReference Include="..\Alife.PluginMarket\Alife.PluginMarket.csproj"/>
    </ItemGroup>

<!--    <ItemGroup Condition="'$(Configuration)' == 'Debug'">-->
<!--        <ProjectReference Include="..\..\Alife.Function\**\*.csproj"/>-->
<!--    </ItemGroup>-->

    <ItemGroup>
        <Content Include="alife-icon.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
