@using Alife.Components.Overlay
@using Alife.Components.Services
@using Alife.Foundation
@using ElectronNET.API
@inject IJSRuntime JsRuntime

@if (isAppInitialized)
{
    <ErrorBoundary>
        <ChildContent>
            <Router AppAssembly="typeof(App).Assembly">
                <Found Context="routeData">
                    <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)"/>
                    <FocusOnNavigate RouteData="routeData" Selector="h1"/>
                </Found>
            </Router>
        </ChildContent>
        <ErrorContent Context="ex">
            @{
                <ErrorWindowUI Value="ex" Title="系统崩溃" ValueChanged="@(() => Electron.App.Exit())"/>
            }
        </ErrorContent>
    </ErrorBoundary>
}
else
{
    <Launching SubTitle="@launchingProgress"/>
}

<LogOverlay/>
<AntContainer/>
<ErrorWindowUI @bind-Value="@exception" Title="系统初始化异常"/>

@code
{
    string? launchingProgress;
    bool isAppInitialized;
    Exception? exception;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == false)
            return;

        //业务环境初始化
        try
        {
            await Task.Run(async () => {
                launchingProgress = "正在初始化软件环境...";
                await InvokeAsync(StateHasChanged);
                ClientEnvironment.SyncEnvironment(); //客户端提供的基础运行环境
                Program.ServiceProvider.InitAlife(); //初始化 Alife 功能
                Program.ServiceProvider.GetRequiredService<ChatMessageService>(); //客户端对话统计

                PluginSystem pluginSystem = Program.ServiceProvider.GetRequiredService<PluginSystem>();

#if !DEBUG
                try
                {
                launchingProgress = "正在查询客户端版本...";
                await InvokeAsync(StateHasChanged);
                await Program.ServiceProvider.GetRequiredService<ClientUpgrade>().FetchNewVersion();

                launchingProgress = "正在拉取在线插件...";
                await InvokeAsync(StateHasChanged);
                await pluginSystem.SyncOnlinePlugins(); //老版本插件依赖云端包信息来确定编译环境
                }
                catch (Exception e)
                {
                AlifeLog.LogError(e);
                }
#endif

                launchingProgress = "正在加载本地插件...";
                await InvokeAsync(StateHasChanged);
                await pluginSystem.SyncLocalPlugins();
            });
        }
        catch (Exception ex)
        {
            exception = ex;
        }

        isAppInitialized = true;
        await JsRuntime.InvokeVoidAsync("alifeLaunching.complete");

        StateHasChanged();
    }
}
