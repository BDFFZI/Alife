@using Alife.Foundation
@using System.Diagnostics
@implements IDisposable

<div class="step-content">
    <div class="step-icon" style="background:rgba(114,46,209,.1);color:#722ed1;">
        <Icon Type="@IconType.Outline.CloudServer" Style="font-size:28px;"/>
    </div>
    <h2 class="step-title">配置下载镜像</h2>
    <p class="step-desc">
        环境依赖大多需要从外网下载。为了让国内用户也能用，就需要配置镜像。</p>

    <Alert ShowIcon="true" Type="AlertType.Info" Style="margin: 12px;"
           Message="几乎所有的环境都得走外网下，虽然我增加了镜像功能，但很不稳定，尤其是Github。最好还是自己搞个加速器，Github作为学术网站，有很多合法加速器可以免费加速。再不济，就去群里下文件吧。"></Alert>
    
    <div class="mirror-list">
        @foreach (var mirror in AvailableMirrors)
        {
            <div class="mirror-item">
                <div class="mirror-main">
                    <div class="mirror-name">
                        @mirror.Name
                        <Tag>@mirror.Provider</Tag>
                        @if (mirror.Recommended)
                        {
                            <Tag Color="@("green")">推荐</Tag>
                        }
                        else
                        {
                            <Tag Color="@("orange")">不推荐</Tag>
                        }
                    </div>
                    <Text Type="@TextElementType.Secondary" Style="font-size: 12px;">@mirror.Description</Text>
                    
                    @if (mirror.Id == "github")
                    {
                        <div class="github-speedtest">
                            @if (isSpeedTesting)
                            {
                                <div class="speedtest-progress">
                                    <Text Type="@TextElementType.Secondary" Style="font-size: 11px;">
                                        正在测速 (@speedTestedCount/@githubCandidates.Count)...
                                    </Text>
                                    <Progress Percent="@((int)(speedTestedCount * 100.0 / githubCandidates.Count))" 
                                             ShowInfo="false"/>
                                </div>
                            }
                            
                            <RadioGroup @bind-Value="@selectedGithubMirror">
                                <div class="github-candidates">
                                    @foreach (var candidate in githubCandidates)
                                    {
                                        <div class="candidate-item @(selectedGithubMirror == candidate.Url ? "selected" : "")">
                                            <Radio Value="@candidate.Url">
                                                <div class="candidate-content">
                                                    <span class="candidate-url">@candidate.Url</span>
                                                    @if (candidate.Latency.HasValue)
                                                    {
                                                        <span class="candidate-latency @(candidate.Latency < 500 ? "fast" : candidate.Latency < 1000 ? "medium" : "slow")">
                                                            @candidate.Latency ms
                                                        </span>
                                                    }
                                                    @if (candidate.IsTesting)
                                                    {
                                                        <span class="candidate-testing">
                                                            <Spin/>
                                                        </span>
                                                    }
                                                    @if (candidate.IsFastest)
                                                    {
                                                        <Tag Color="@("green")">最快</Tag>
                                                    }
                                                </div>
                                            </Radio>
                                        </div>
                                    }
                                </div>
                            </RadioGroup>
                            
                            <Button Size="@ButtonSize.Small" OnClick="@StartSpeedTest" Disabled="@isSpeedTesting">
                                <Icon Type="@IconType.Outline.Thunderbolt"/>
                                @(isSpeedTesting ? "测速中..." : "重新测速")
                            </Button>
                        </div>
                    }
                    else
                    {
                        @if (mirror.UrlMappings.Any())
                        {
                            <div class="mirror-urls">
                                @foreach (var kv in mirror.UrlMappings)
                                {
                                    <div class="mirror-url-row">
                                        <Text Type="@TextElementType.Secondary" Style="font-size: 11px;">镜像</Text>
                                        <Text Code Style="font-size: 11px;">@kv.Value</Text>
                                    </div>
                                }
                            </div>
                        }
                        @if (mirror.EnvironmentVariables.Any())
                        {
                            <div class="mirror-urls">
                                @foreach (var kv in mirror.EnvironmentVariables)
                                {
                                    <div class="mirror-url-row">
                                        <Text Type="@TextElementType.Secondary" Style="font-size: 11px;">@kv.Key</Text>
                                        <Text Code Style="font-size: 11px;">@kv.Value</Text>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                @if (mirror.Id != "github")
                {
                    <Switch @bind-Value="@enabledMirrors[mirror.Id]"/>
                }
            </div>
        }
    </div>

    <Alert ShowIcon="true" Type="AlertType.Warning" Style="margin-top: 12px;"
           Message="必须配置镜像或自备工具，如果失效，后续环境安装很可能失败！"></Alert>
    
    <div class="step-nav">
        <Button Size="@ButtonSize.Large" OnClick="@OnPrev">
            <Icon Type="@IconType.Outline.ArrowLeft"/>
            上一步
        </Button>
        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Large" OnClick="@OnNext">
            下一步
            <Icon Type="@IconType.Outline.ArrowRight"/>
        </Button>
    </div>
</div>

@code {

    record MirrorItem(
        string Id,
        string Name,
        string Provider,
        string Description,
        bool Recommended,
        Dictionary<string, string> UrlMappings,
        Dictionary<string, string> EnvironmentVariables
    );

    class GithubCandidate
    {
        public string Domain { get; }
        public string Url { get; }
        public string TestUrl { get; }
        public long? Latency { get; set; }
        public bool IsTesting { get; set; }
        public bool IsFastest { get; set; }

        public GithubCandidate(string domain, string url, string testUrl)
        {
            Domain = domain;
            Url = url;
            TestUrl = testUrl;
        }
    }

    static readonly List<MirrorItem> AvailableMirrors = [
        new(
            "pypi",
            "PyPI 镜像",
            "阿里云",
            "用于在国内下载 Python 包环境",
            true,
            new Dictionary<string, string>(),
            new Dictionary<string, string> {
                { "PIP_INDEX_URL", "https://mirrors.aliyun.com/pypi/simple/" },
                { "PIP_TRUSTED_HOST", "mirrors.aliyun.com" }
            }
        ),
        new(
            "pytorch-cuda",
            "PyTorch-CUDA 镜像",
            "阿里云",
            "用于在国内下载 CUDA 环境",
            true,
            new Dictionary<string, string> {
                { "--index-url https://download.pytorch.org/whl/cu128", "--find-links https://mirrors.aliyun.com/pytorch-wheels/cu128" }
            },
            new Dictionary<string, string>()
        ),
        new(
            "github",
            "GitHub 加速",
            "gh-proxy",
            "用于下载托管在 github 上的插件和客户端",
            false,
            new Dictionary<string, string>(),
            new Dictionary<string, string>()
        ),
    ];

    readonly List<GithubCandidate> githubCandidates = [
        new("gh-proxy.com", "https://gh-proxy.com/https://github.com", "https://gh-proxy.com/https://github.com/favicon.ico"),
        new("gh-proxy.org", "https://gh-proxy.org/https://github.com", "https://gh-proxy.org/https://github.com/favicon.ico"),
        new("hk.gh-proxy.org", "https://hk.gh-proxy.org/https://github.com", "https://hk.gh-proxy.org/https://github.com/favicon.ico"),
        new("cdn.gh-proxy.org", "https://cdn.gh-proxy.org/https://github.com", "https://cdn.gh-proxy.org/https://github.com/favicon.ico"),
        new("edgeone.gh-proxy.org", "https://edgeone.gh-proxy.org/https://github.com", "https://edgeone.gh-proxy.org/https://github.com/favicon.ico"),
    ];

    string selectedGithubMirror = "";
    bool isSpeedTesting = false;
    int speedTestedCount = 0;
    readonly HttpClient httpClient = new() { Timeout = TimeSpan.FromSeconds(5) };

    public void Dispose()
    {
        httpClient.Dispose();
    }

    [Parameter] public EventCallback OnPrevStep { get; set; }
    [Parameter] public EventCallback OnNextStep { get; set; }

    readonly Dictionary<string, bool> enabledMirrors = new();

    protected override async Task OnInitializedAsync()
    {
        bool anyConfigured = AvailableMirrors.Any(IsMirrorConfigured);
        if (anyConfigured)
        {
            foreach (var mirror in AvailableMirrors)
            {
                if (mirror.Id != "github")
                    enabledMirrors[mirror.Id] = IsMirrorConfigured(mirror);
            }
        }
        else
        {
            foreach (var mirror in AvailableMirrors)
            {
                if (mirror.Id != "github")
                    enabledMirrors[mirror.Id] = mirror.Recommended;
            }
        }

        await StartSpeedTest();
    }

    bool IsMirrorConfigured(MirrorItem mirror)
    {
        if (mirror.Id == "github")
        {
            return AlifeMirror.MirrorUrlMap.ContainsKey("https://github.com");
        }
        
        foreach (var kv in mirror.UrlMappings)
        {
            if (!AlifeMirror.MirrorUrlMap.TryGetValue(kv.Key, out var v) || v != kv.Value)
                return false;
        }
        foreach (var kv in mirror.EnvironmentVariables)
        {
            if (!AlifeMirror.MirrorEnvironmentVariables.TryGetValue(kv.Key, out var v) || v != kv.Value)
                return false;
        }
        return true;
    }

    async Task StartSpeedTest()
    {
        isSpeedTesting = true;
        speedTestedCount = 0;
        selectedGithubMirror = "";
        
        foreach (var candidate in githubCandidates)
        {
            candidate.Latency = null;
            candidate.IsTesting = false;
            candidate.IsFastest = false;
        }
        
        StateHasChanged();

        var tasks = githubCandidates.Select(TestCandidateAsync).ToList();
        await Task.WhenAll(tasks);

        var fastest = githubCandidates
            .Where(c => c.Latency.HasValue)
            .OrderBy(c => c.Latency)
            .FirstOrDefault();
        
        if (fastest != null)
        {
            fastest.IsFastest = true;
            selectedGithubMirror = fastest.Url;
        }

        isSpeedTesting = false;
        StateHasChanged();
    }

    async Task TestCandidateAsync(GithubCandidate candidate)
    {
        candidate.IsTesting = true;
        StateHasChanged();

        try
        {
            var sw = Stopwatch.StartNew();
            var response = await httpClient.GetAsync(candidate.TestUrl);
            sw.Stop();
            
            if (response.IsSuccessStatusCode)
                candidate.Latency = sw.ElapsedMilliseconds;
            else
                candidate.Latency = null;
        }
        catch
        {
            candidate.Latency = null;
        }
        finally
        {
            candidate.IsTesting = false;
            speedTestedCount++;
            StateHasChanged();
        }
    }

    void ApplyMirrors()
    {
        var urlMap = new Dictionary<string, string>();
        var envVars = new Dictionary<string, string>();

        foreach (var mirror in AvailableMirrors)
        {
            if (mirror.Id == "github")
            {
                if (!string.IsNullOrEmpty(selectedGithubMirror))
                {
                    urlMap["https://github.com"] = selectedGithubMirror;
                    urlMap["https://raw.githubusercontent.com"] = selectedGithubMirror.Replace("/https://github.com", "/https://raw.githubusercontent.com");
                }
            }
            else if (enabledMirrors.GetValueOrDefault(mirror.Id))
            {
                foreach (var kv in mirror.UrlMappings)
                    urlMap[kv.Key] = kv.Value;
                foreach (var kv in mirror.EnvironmentVariables)
                    envVars[kv.Key] = kv.Value;
            }
        }

        AlifeMirror.SetMirrorUrlMap(urlMap);
        AlifeMirror.SetMirrorEnvironmentVariables(envVars);
        AlifeMirror.SetupEnvironment();
    }

    async Task OnPrev() { await OnPrevStep.InvokeAsync(); }
    async Task OnNext()
    {
        ApplyMirrors();
        await OnNextStep.InvokeAsync();
    }
}

<style>
    .step-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    .step-title {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 700;
        color: #1a1a1a;
        text-align: center;
    }

    .step-desc {
        margin: 0 0 20px;
        font-size: 13px;
        color: rgba(0, 0, 0, .45);
        text-align: center;
    }

    .step-nav {
        display: flex;
        justify-content: space-between;
        margin-top: 16px;
        gap: 12px;
    }

    .mirror-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .mirror-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: rgba(0, 0, 0, .02);
        border-radius: 8px;
        border: 1px solid #f0f0f0;
    }

    .mirror-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .mirror-name {
        font-weight: 500;
        font-size: 13px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .mirror-urls {
        margin-top: 6px;
    }

    .mirror-url-row {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        line-height: 1.6;
    }

    .github-speedtest {
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .speedtest-progress {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .github-candidates {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .candidate-item {
        padding: 6px 8px;
        border-radius: 4px;
        border: 1px solid #f0f0f0;
        transition: all 0.2s;
    }

    .candidate-item:hover {
        background: rgba(24, 144, 255, 0.05);
    }

    .candidate-item.selected {
        border-color: #1890ff;
        background: rgba(24, 144, 255, 0.05);
    }

    .candidate-content {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .candidate-url {
        font-size: 11px;
        color: #333;
        flex: 1;
    }

    .candidate-latency {
        font-size: 11px;
        font-weight: 500;
        min-width: 60px;
        text-align: right;
    }

    .candidate-latency.fast {
        color: #52c41a;
    }

    .candidate-latency.medium {
        color: #faad14;
    }

    .candidate-latency.slow {
        color: #ff4d4f;
    }

    .candidate-testing {
        display: flex;
        align-items: center;
        min-width: 60px;
        justify-content: flex-end;
    }
</style>
