@using Alife.Components.Services
@using Alife.PluginMarket
@using Alife.PluginContext
@inject UpdateService UpdateService
@inject PluginSystem PluginSystem
@inject NavigationManager Navigation

@if (showAppUpdate)
{
    <PopupNotification Title="@($"发现新版本 v{updateInfo!.Version}")"
                       Icon="@IconType.Outline.Bell"
                       ProgressVisible="@isDownloading"
                       ProgressValue="@downloadProgress"
                       BodyText="@updateInfo.ReleaseNotes">
        <Body>
        @if (isMajorUpdate)
        {
            <div
                style="background: #e6f7ff; border: 1px solid #91d5ff; border-radius: 4px; padding: 8px 12px; margin-bottom: 8px; font-size: 12px; color: #096dd9;">
                <Icon Type="@IconType.Outline.InfoCircle" Style="margin-right: 4px;"/>
                此次为非兼容性更新，部分第三方插件可能不支持，官方插件也需在更新后立即升级。
            </div>
        }
        @((MarkupString)updateInfo.ReleaseNotes!.Replace("\n", "<br/>"))
        </Body>
        <Actions>
            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@UpdateClient">
                立即升级
            </Button>
            <Button Size="@ButtonSize.Small" OnClick="@(() => showAppUpdate = false)">
                下次再说
            </Button>
        </Actions>
    </PopupNotification>
}
else if (showForceUpgrade)
{
    <PluginUpgradeModal @bind-Visible="showForceUpgrade"
                        UpgradeList="forceUpgradeList"
                        OnUpgradeComplete="@(() => showForceUpgrade = false)">
        <HeaderContent>
            <div style="font-size: 12px; color: rgba(0,0,0,0.45); margin-bottom: 12px; line-height: 1.8;">
                <b style="color: #ff4d4f;">检测到存在非兼容插件，必须升级才能正常使用。</b>
            </div>
        </HeaderContent>
    </PluginUpgradeModal>
}
else if (showPluginUpdate)
{
    <PopupNotification Title="@($"发现 {upgradablePlugins.Length} 个插件可升级")"
                       Icon="@IconType.Outline.Bell">
        <Body>
        @string.Join("、", upgradablePlugins.Take(3).Select(p => p.Name))
        @if (upgradablePlugins.Length > 3)
        {
            @($" 等{upgradablePlugins.Length}个插件")
        }
        </Body>
        <Actions>
            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small"
                    OnClick="@GoToPluginMarket">
                前往升级
            </Button>
            <Button Size="@ButtonSize.Small" OnClick="@(() => showPluginUpdate = false)">
                忽略
            </Button>
        </Actions>
    </PopupNotification>
}

@code {
    //应用更新
    bool showAppUpdate;
    UpdateInfo? updateInfo;
    bool isMajorUpdate;
    //插件强制更新
    bool showForceUpgrade;
    readonly List<PluginUpgradeModal.UpgradeItem> forceUpgradeList = [];
    //插件普通更新
    bool showPluginUpdate;
    PluginPackage[] upgradablePlugins = [];
    bool isDownloading;
    int downloadProgress;

    protected override void OnInitialized()
    {
        ClientUpgrade();
        CheckForceUpgrade();
        if (!showForceUpgrade)
            CheckPluginUpdates();

        void ClientUpgrade()
        {
            if (UpdateService.HasUpdate && UpdateService.LatestUpdate != null)
            {
                updateInfo = UpdateService.LatestUpdate;
                showAppUpdate = true;
                isMajorUpdate = DependencyResolver.GetMajorVersion(updateInfo.Version) > DependencyResolver.GetMajorVersion(UpdateService.LocalVersion);
            }
        }

        void CheckForceUpgrade()
        {
            var forcePlugins = PluginSystem.GetForceUpgradedPlugins();
            if (forcePlugins.Count == 0) return;

            var forceIds = new HashSet<string>(forcePlugins.Select(p => p.Id));

            foreach (var plugin in forcePlugins)
            {
                string? oldVersion = PluginSystem.GetInstalledVersion(plugin.Id);
                string? newVersion = PluginSystem.GetLatestVersion(plugin);
                if (string.IsNullOrEmpty(oldVersion) || string.IsNullOrEmpty(newVersion))
                    continue;

                forceUpgradeList.Add(new PluginUpgradeModal.UpgradeItem {
                    PluginPackage = plugin,
                    oldVersion = oldVersion,
                    newVersion = newVersion,
                    isLocked = true,
                    isSelected = true
                });
            }

            var allPlugins = PluginSystem.GetAllOnlinePlugins().Values;
            foreach (var plugin in allPlugins.Where(p => !forceIds.Contains(p.Id) && PluginSystem.HasUpdate(p)))
            {
                string? oldVersion = PluginSystem.GetInstalledVersion(plugin.Id);
                string? newVersion = PluginSystem.GetLatestVersion(plugin);
                if (string.IsNullOrEmpty(oldVersion) || string.IsNullOrEmpty(newVersion))
                    continue;

                forceUpgradeList.Add(new PluginUpgradeModal.UpgradeItem {
                    PluginPackage = plugin,
                    oldVersion = oldVersion,
                    newVersion = newVersion
                });
            }

            if (forceUpgradeList.Count > 0)
            {
                showForceUpgrade = true;
            }
        }

        void CheckPluginUpdates()
        {
            var allPlugins = PluginSystem.GetAllOnlinePlugins().Values;
            upgradablePlugins = allPlugins
                .Where(p => PluginSystem.HasUpdate(p))
                .ToArray();

            if (upgradablePlugins.Length > 0)
            {
                showPluginUpdate = true;
            }
        }
    }

    async Task UpdateClient()
    {
        if (updateInfo == null) return;

        isDownloading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await UpdateService.ApplyUpdateAsync(updateInfo, progress => {
                downloadProgress = progress;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            isDownloading = false;
            downloadProgress = 0;
            Console.WriteLine($"更新失败: {ex.Message}");
            await InvokeAsync(StateHasChanged);
        }
    }
    
    void GoToPluginMarket()
    {
        showPluginUpdate = false;
        NavigationHub.RequestTab("plugin");
        Navigation.NavigateTo("/system");
    }
}
