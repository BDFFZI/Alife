@using Alife.Components.Services
@using Alife.PluginContext
@inject PluginSystem PluginSystem
@inject ClientUpgrade ClientUpgrade

@if (showAppUpdate)
{
    <PopupNotification Title="@($"发现新版本 v{ClientUpgrade.NewVersion!.Version}")"
                       Icon="@IconType.Outline.Bell"
                       ProgressVisible="@isDownloading"
                       ProgressValue="@downloadProgress"
                       BodyText="@ClientUpgrade.NewVersion.ReleaseNotes">
        <Body>
        @if (isMajorUpdate)
        {
            <div
                style="background: #e6f7ff; border: 1px solid #91d5ff; border-radius: 4px; padding: 8px 12px; margin-bottom: 8px; font-size: 12px; color: #096dd9;">
                <Icon Type="@IconType.Outline.InfoCircle" Style="margin-right: 4px;"/>
                此次为非兼容性更新，部分第三方插件可能不支持，官方插件也需在更新后立即升级。
            </div>
        }
        @((MarkupString)ClientUpgrade.NewVersion.ReleaseNotes!.Replace("\n", "<br/>"))
        </Body>
        <Actions>
            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@UpdateClient">
                立即升级
            </Button>
            <Button Size="@ButtonSize.Small" OnClick="@(() => showAppUpdate = false)">
                下次再说
            </Button>
        </Actions>
    </PopupNotification>
}
else if (showPluginUpgrade)
{
    <PluginUpgradeModal @bind-Visible="showPluginUpgrade"
                        UpgradeList="pluginUpgradeList"
                        OnUpgradeComplete="@(() => showPluginUpgrade = false)">
        <HeaderContent>
            @if (hasForceUpgrade)
            {
                <div style="font-size: 12px; color: rgba(0,0,0,0.45); margin-bottom: 12px; line-height: 1.8;">
                    <b style="color: #ff4d4f;">检测到存在非兼容插件，必须升级才能正常使用。</b>
                </div>
            }
            else
            {
                <Paragraph>检测到可升级插件，建议升级（当插件报错时，通常都可以通过升级或重装来解决，或者也可以尝试让 AI 解决）</Paragraph>
            }
        </HeaderContent>
    </PluginUpgradeModal>
}

@code {

    //应用更新
    bool showAppUpdate;
    bool isMajorUpdate;
    //插件更新（合并强制和普通）
    bool showPluginUpgrade;
    bool hasForceUpgrade;
    readonly List<PluginUpgradeModal.UpgradeItem> pluginUpgradeList = [];
    bool isDownloading;
    int downloadProgress;

    protected override void OnInitialized()
    {
        CheckClientUpgrade();
        CheckPluginUpdates();

        void CheckClientUpgrade()
        {
            if (ClientUpgrade.NewVersion != null)
            {
                showAppUpdate = true;
                isMajorUpdate = DependencyResolver.GetMajorVersion(ClientUpgrade.NewVersion.Version) > DependencyResolver.GetMajorVersion(PluginSystem.ClientVersion);
            }
        }
        void CheckPluginUpdates()
        {
            var forcePlugins = PluginSystem.GetForceUpgradedPlugins();
            var forceIds = new HashSet<string>(forcePlugins.Select(p => p.Id));
            hasForceUpgrade = forcePlugins.Count > 0;

            // 添加强制更新插件
            foreach (var plugin in forcePlugins)
            {
                string? oldVersion = PluginSystem.GetInstalledVersion(plugin.Id);
                string? newVersion = PluginSystem.GetLatestVersion(plugin);
                if (string.IsNullOrEmpty(oldVersion) || string.IsNullOrEmpty(newVersion))
                    continue;

                pluginUpgradeList.Add(new PluginUpgradeModal.UpgradeItem {
                    PluginPackage = plugin,
                    OldVersion = oldVersion,
                    NewVersion = newVersion,
                    IsLocked = true,
                    IsSelected = true
                });
            }

            // 添加普通更新插件
            var allPlugins = PluginSystem.GetAllOnlinePlugins().Values;
            foreach (var plugin in allPlugins.Where(p => !forceIds.Contains(p.Id) && PluginSystem.HasUpdate(p)))
            {
                string? oldVersion = PluginSystem.GetInstalledVersion(plugin.Id);
                string? newVersion = PluginSystem.GetLatestVersion(plugin);
                if (string.IsNullOrEmpty(oldVersion) || string.IsNullOrEmpty(newVersion))
                    continue;

                pluginUpgradeList.Add(new PluginUpgradeModal.UpgradeItem {
                    PluginPackage = plugin,
                    OldVersion = oldVersion,
                    NewVersion = newVersion
                });
            }

            if (pluginUpgradeList.Count > 0)
            {
                showPluginUpgrade = true;
            }
        }
    }

    async Task UpdateClient()
    {
        isDownloading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await ClientUpgrade.ApplyNewVersion(progress => {
                downloadProgress = progress;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            isDownloading = false;
            downloadProgress = 0;
            Console.WriteLine($"更新失败: {ex.Message}");
            await InvokeAsync(StateHasChanged);
        }
    }
}
