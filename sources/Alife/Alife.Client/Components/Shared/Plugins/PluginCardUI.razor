@using Alife.PluginMarket
@inject PluginSystem PluginSystem
@implements IDisposable

<div class="plugin-card" @onclick="HandleClick">
    <div class="plugin-card-header">
        @{
            bool isInstalled = PluginSystem.IsInstalled(PluginPackage.Id);
            bool hasUpdate = isInstalled && PluginSystem.HasUpdate(PluginPackage);
        }
        <Badge Status="@(hasUpdate ? BadgeStatus.Warning : BadgeStatus.Success)" Dot="@(isInstalled)">
            <div class="plugin-icon">
                <Icon Type="@IconType.Outline.Appstore" Style="font-size: 16px; color: #1890ff;"/>
            </div>
        </Badge>
        <div class="plugin-info">
            <div class="plugin-name">@PluginPackage.Name</div>
            @if (!string.IsNullOrEmpty(PluginPackage.Author))
            {
                <div class="plugin-author">@PluginPackage.Author</div>
            }
        </div>
        <div class="plugin-actions">
            <Tooltip Title="@(IsInCart ? "移出购物车" : "添加到购物车")">
                <Button Type="@(IsInCart ? ButtonType.Primary : ButtonType.Default)" Size="@ButtonSize.Small"
                        OnClick="@ToggleCart" OnClickStopPropagation="true"
                        Style="@("width: 28px; height: 28px; min-width: 28px; padding: 0; border-radius: 50%;")">
                    <Icon Type="shopping-cart" Theme="IconThemeType.Outline"/>
                </Button>
            </Tooltip>
        </div>
    </div>

    <div class="plugin-meta">
        <AntDesign.Text Type="@TextElementType.Secondary"
                        Style="font-size: 11px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
            @(string.IsNullOrWhiteSpace(PluginPackage.Description) ? PluginPackage.Id : PluginPackage.Description)
        </AntDesign.Text>
    </div>
</div>

<style>
    .plugin-card {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 6px;
        padding: 10px;
        cursor: pointer;
        transition: all 0.3s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .plugin-card:hover {
        border-color: #1890ff;
        box-shadow: 0 2px 8px rgba(24, 144, 255, 0.15);
        transform: translateY(-1px);
    }

    .plugin-card-header {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
        gap: 8px;
    }

    .plugin-icon {
        width: 32px;
        height: 32px;
        background: #e6f7ff;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .plugin-info {
        flex: 1;
        min-width: 0;
    }

    .plugin-name {
        font-size: 13px;
        font-weight: 600;
        color: rgba(0, 0, 0, 0.85);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .plugin-author {
        font-size: 11px;
        color: rgba(0, 0, 0, 0.45);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .plugin-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .plugin-meta {
    }
</style>

@code {
    [Parameter] public PluginPackage PluginPackage { get; set; } = null!;
    [Parameter] public bool IsInCart { get; set; }
    [Parameter] public EventCallback<bool> OnToggleCart { get; set; }
    [Parameter] public EventCallback<PluginPackage> OnClick { get; set; }

    protected override void OnInitialized()
    {
        PluginSystem.PluginSynced += OnPluginSynced;
    }
    public void Dispose()
    {
        PluginSystem.PluginSynced -= OnPluginSynced;
    }
    void OnPluginSynced()
    {
        InvokeAsync(StateHasChanged);
    }

    async Task HandleClick()
    {
        await OnClick.InvokeAsync(PluginPackage);
    }

    async Task ToggleCart()
    {
        await OnToggleCart.InvokeAsync(!IsInCart);
    }
}
