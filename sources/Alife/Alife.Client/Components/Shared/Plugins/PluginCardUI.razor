@using Alife.PluginMarket
@inject PluginSystem PluginSystem

<div class="plugin-card" @onclick="HandleClick">
    <div class="plugin-card-header">
        <div class="plugin-icon-wrapper">
            <div class="plugin-icon">
                <Icon Type="@IconType.Outline.Appstore" Style="font-size: 16px; color: #1890ff;" />
            </div>
            @if (PluginSystem.IsInstalled(PluginPackage.Id))
            {
                <div class="plugin-badge"></div>
            }
        </div>
        <div class="plugin-info">
            <div class="plugin-name">@PluginPackage.Name</div>
            @if (!string.IsNullOrEmpty(PluginPackage.Author))
            {
                <div class="plugin-author">@PluginPackage.Author</div>
            }
        </div>
        <div class="plugin-actions">
            @if (PluginSystem.IsInstalled(PluginPackage.Id))
            {
                <span class="plugin-version">v@(PluginSystem.GetInstalledVersion(PluginPackage.Id))</span>
            }
            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small"
                     OnClick="@AddToCart" OnClickStopPropagation="true"
                     Style="width: 28px; height: 28px; min-width: 28px; padding: 0; border-radius: 50%;">
                <Icon Type="@IconType.Outline.Plus" />
            </Button>
        </div>
    </div>

    <div class="plugin-meta">
        <Tooltip Title="@(PluginPackage.Description)" Disabled="@(string.IsNullOrWhiteSpace(PluginPackage.Description))">
            <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 11px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
                @(string.IsNullOrWhiteSpace(PluginPackage.Description) ? PluginPackage.Id : PluginPackage.Description)
            </AntDesign.Text>
        </Tooltip>
    </div>
</div>

<style>
    .plugin-card {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 6px;
        padding: 10px;
        cursor: pointer;
        transition: all 0.3s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .plugin-card:hover {
        border-color: #1890ff;
        box-shadow: 0 2px 8px rgba(24, 144, 255, 0.15);
        transform: translateY(-1px);
    }

    .plugin-card-header {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
        gap: 8px;
    }

    .plugin-icon-wrapper {
        position: relative;
        flex-shrink: 0;
    }

    .plugin-icon {
        width: 32px;
        height: 32px;
        background: #e6f7ff;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .plugin-badge {
        position: absolute;
        top: -3px;
        right: -3px;
        width: 12px;
        height: 12px;
        background: #52c41a;
        border-radius: 50%;
        border: 2px solid #fff;
    }

    .plugin-info {
        flex: 1;
        min-width: 0;
    }

    .plugin-name {
        font-size: 13px;
        font-weight: 600;
        color: rgba(0, 0, 0, 0.85);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .plugin-author {
        font-size: 11px;
        color: rgba(0, 0, 0, 0.45);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .plugin-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .plugin-version {
        font-size: 12px;
        color: rgba(0, 0, 0, 0.45);
    }

    .plugin-meta {
    }
</style>

@code {
    [Parameter] public PluginPackage PluginPackage { get; set; } = null!;
    [Parameter] public EventCallback<PluginPackage> OnClick { get; set; }
    [Parameter] public EventCallback<PluginPackage> OnAddToCart { get; set; }

    async Task HandleClick()
    {
        await OnClick.InvokeAsync(PluginPackage);
    }

    async Task AddToCart()
    {
        await OnAddToCart.InvokeAsync(PluginPackage);
    }
}
