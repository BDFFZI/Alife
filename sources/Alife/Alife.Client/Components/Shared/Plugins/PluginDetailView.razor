@using Alife.Framework
@using Alife.Components.Shared.Common
@using Alife.PluginMarket
@using Alife.PluginSystem
@inject MarketSystem MarketSystem

<div style="display: flex; flex-direction: column; height: 100%;">
    @* 页头 *@
    <div style="flex-shrink: 0; background: #fafafa; padding: 24px; border-radius: 8px; border: 1px solid #f0f0f0;">
        <Flex Align="FlexAlign.Start">
            <div>
                <Flex Align="FlexAlign.Center" Gap="@("12")">
                    <Title Level="3" Style="margin: 0;">@PluginPackage.Name</Title>
                    @if (isInstalled)
                    {
                        <Tag Color="@("green")">已安装</Tag>
                    }
                </Flex>
                <AntDesign.Text Type="@TextElementType.Secondary" Style="margin-top: 4px; display: block;">@PluginPackage.Id</AntDesign.Text>
                @if (!string.IsNullOrEmpty(PluginPackage.Author))
                {
                    <span style="margin-top: 2px; display: block; color: rgba(0,0,0,0.45); font-size: 14px;">作者: @PluginPackage.Author</span>
                }
            </div>
        </Flex>

        <Paragraph Style="margin-top: 16px; color: rgba(0,0,0,0.65);">
            @PluginPackage.Description
        </Paragraph>

        @if (!string.IsNullOrEmpty(PluginPackage.Source))
        {
            <div style="margin-top: 8px;">
                <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 13px;">
                    <Icon Type="@IconType.Outline.Link" /> <a href="@PluginPackage.Source" target="_blank" style="color: #1890ff;">@PluginPackage.Source</a>
                </AntDesign.Text>
            </div>
        }

        @* 操作按钮 *@
        <Flex Gap="@("12")" Style="margin-top: 16px;">
            <Button Type="@ButtonType.Primary" OnClick="AddToCart">
                <Icon Type="@IconType.Outline.Plus" /> 加入购物车
            </Button>
        </Flex>
    </div>

    @* 版本列表 *@
    <div style="flex: 1; overflow-y: auto; padding: 16px 0;">
        <Title Level="4">版本历史</Title>
        <Timeline>
            @if (PluginPackage.Releases != null)
            {
                @foreach (var release in PluginPackage.Releases.OrderByDescending(r => r.Key, Comparer<string>.Create(DependencyResolver.CompareVersions)))
                {
                    bool isCompatible = MarketSystem.IsClientCompatible(release.Key);
                    <TimelineItem Color="@(release.Key == latestVersion ? "blue" : "gray")">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <Tooltip Title="@(isCompatible ? "" : "版本不兼容：插件大版本号高于当前客户端版本")">
                                <AntDesign.Text Strong Style="@(isCompatible ? "" : "opacity: 0.4;")">@release.Key</AntDesign.Text>
                            </Tooltip>
                            @if (isInstalled && release.Key == installedVersion)
                            {
                                <Tag Color="@("green")">当前版本</Tag>
                            }
                            @if (release.Key == latestVersion)
                            {
                                <Tag Color="@("blue")">最新</Tag>
                            }
                            @if (!isCompatible)
                            {
                                <Tag Color="@("red")">不兼容</Tag>
                            }
                        </div>
                        <AntDesign.Text Type="@TextElementType.Secondary" Style="font-size: 12px;">@release.Value.Date</AntDesign.Text>
                        @if (!string.IsNullOrEmpty(release.Value.Note))
                        {
                            <div style="margin-top: 4px; white-space: pre-wrap; @(isCompatible ? "" : "opacity: 0.4;")">@release.Value.Note</div>
                        }
                        @if (!string.IsNullOrEmpty(release.Value.File))
                        {
                            <div style="margin-top: 4px; word-break: break-all; @(isCompatible ? "" : "opacity: 0.4;")">
                                <a href="@release.Value.File" target="_blank" style="font-size: 12px; color: #1890ff;">
                                    <Icon Type="@IconType.Outline.Download" /> @release.Value.File
                                </a>
                            </div>
                        }
                    </TimelineItem>
                }
            }
        </Timeline>
    </div>
</div>

@code {
    [Parameter] public PluginPackage PluginPackage { get; set; } = null!;
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<PluginPackage> OnAddToCart { get; set; }

    bool isInstalled;
    string? installedVersion;
    string? latestVersion;

    protected override void OnParametersSet()
    {
        isInstalled = MarketSystem.IsInstalled(PluginPackage.Id);
        installedVersion = MarketSystem.GetInstalledVersion(PluginPackage.Id);
        latestVersion = MarketSystem.GetLatestVersion(PluginPackage);
    }

    async Task AddToCart()
    {
        await OnAddToCart.InvokeAsync(PluginPackage);
    }
}
